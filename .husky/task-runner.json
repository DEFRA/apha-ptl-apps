{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "dotnet-format-staged-files",
         "group": "pre-commit-tasks",
         "command": "dotnet",
         "args": [ "format", "PTL.slnx", "--include", "${staged}", "--verify-no-changes" ],
         "include": [ "**/*.cs", "**/*.cshtml" ]
      },
      {
         "name": "dotnet-test-coverage",
         "group": "pre-commit-tasks",
         "command": "dotnet",
         "args": [ "test", "PTL.slnx" ],
         "include": [ "**/*.cs" ]
      }
   ]
}
