<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is informational only, matching PTL.Common's convention. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Compiles Views/Shared/*.cshtml as MVC views so both web apps can render shared partials by name. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <!-- Razor SDK so wwwroot/js/ptl-rich-text-wire.js is served to both web apps as a static web asset under
       /_content/PTL.SharedUI/ and the rich text encoding exists once. -->

  <ItemGroup>
    <!-- Gives access to Tag Helpers / MVC ViewFeatures / Mvc.Rendering. Same pattern as PTL.Common. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- GovUkReadOnlyResultsTablesTagHelper renders directly off the API's Actual Results
         contracts, shared verbatim by InternalWeb and ExternalWeb - see
         docs/Code-Duplication-Playbook.md. -->
    <ProjectReference Include="..\PTL.Contracts\PTL.Contracts.csproj" />
  </ItemGroup>

</Project>
