<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PTL.Core\PTL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- Transitive via Microsoft.Data.SqlClient; 9.0.4 is vulnerable (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx), fixed in 9.0.21. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.9" />
    <!-- Must match PTL.Api's AWSSDK.Core version (required by AWSSDK.SSOOIDC >= 4.0.102.8). -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
