<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <!-- Needed for the shared web front-end bootstrap (PtlWebApplicationExtensions), which configures
         Serilog once for every PTL.InternalWeb/PTL.ExternalWeb-style app instead of duplicating it. -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for ASP.NET Core types (IHealthCheck, IEndpointFilter, WebApplication, ...) used by
         the shared health-check plumbing below - this is a plain class library, not Sdk.Web. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PTL.Contracts\PTL.Contracts.csproj" />
    <ProjectReference Include="..\PTL.Common\PTL.Common.csproj" />
  </ItemGroup>

</Project>
