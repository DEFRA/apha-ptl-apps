@model ErrorViewModel
@{
    ViewData["Title"] = "Sorry, there is a problem with the service";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Sorry, there is a problem with the service</h1>
        <p class="govuk-body">Try again later.</p>
        @await Component.InvokeAsync("SupportContact", new { leadIn = "If the problem continues, contact the Animal and Plant Health Agency" })
        @if (Model.ShowRequestId)
        {
            <p class="govuk-body-s">If you contact us, quote this reference: <code>@Model.RequestId</code></p>
        }
        <p class="govuk-body"><a class="govuk-link" asp-controller="Home" asp-action="Index">Go back to the home page</a>.</p>
    </div>
</div>
