<!DOCTYPE html>
<html lang="en" class="govuk-template app-html-class">

<head>
    <meta charset="utf-8">
    <title>@(ViewData["Title"] is string pageTitle && pageTitle.Length > 0 ? $"{pageTitle} - Proficiency Testing - GOV.UK" : "GOV.UK - Customised page template")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="blue">
    <link rel="stylesheet" href="/css/govuk-frontend-6.5.0.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/tabulation.css" asp-append-version="true">
    <link rel="icon" sizes="48x48" href="/assets/images/favicon.ico">
    <link rel="icon" sizes="any" href="/assets/images/favicon.svg" type="image/svg+xml">
    <link rel="mask-icon" href="/assets/images/govuk-icon-mask.svg" color="blue">
    <link rel="apple-touch-icon" href="/assets/images/govuk-icon-180.png">
    <link rel="manifest" href="/assets/manifest.json">
    <meta property="og:image" content="YOUR-DOMAIN/images/govuk-opengraph-image.png">
</head>

<body class="govuk-template__body app-body-class" data-test="My value" data-other="report:details">
    <script>
            document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
    </script>
    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>
    @model dynamic

@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).Trim();
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).Trim();
    // NotPermitted/AccessDenied are terminal "you cannot use this service" pages reached via a
    // diversion, not normal in-service navigation - their breadcrumb trail is actively misleading:
    // NotPermitted has no local cookie yet, so "Home" just re-triggers the CIDM challenge and loops
    // back here, and the "Account" segment has nowhere to link to (AccountController has no Index).
    var isAccountFlowPage = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "SignedOut", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "NotPermitted", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "AccessDenied", StringComparison.OrdinalIgnoreCase)
            // The user has just been signed out, so a Home trail would only bounce them back to sign-in.
            || string.Equals(currentAction, "SessionExpired", StringComparison.OrdinalIgnoreCase));

    // Choosing a lab is the step before Home, so there is no trail above it (its "Home" link would only bring the user back here).
    var isLabSelectionPage = string.Equals(currentController, "Lab", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Select", StringComparison.OrdinalIgnoreCase);

    var showCookieConsentBanner = string.IsNullOrEmpty(Context.Request.Cookies[CookiePreferenceNames.ConsentSet]);
    var cookiePreferenceDecision = TempData["CookiePreferencesUpdated"] as string;
}

@await Html.PartialAsync("_CookieBanner", (showCookieConsentBanner, cookiePreferenceDecision))
@await Html.PartialAsync("_Header", ("VETQAS Proficiency Testing", "width:180px; height:auto;"))
<div class="govuk-width-container app-width-container">
    <main role="main" class="pb-3" id="main-content">
        @if (!isAccountFlowPage && !isLabSelectionPage)
        {
            @await Html.PartialAsync("_Breadcrumbs")
        }
        @await Html.PartialAsync("_NotificationBanner")
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                @RenderBody()
            </div>
        </div>
    </main>
</div>
@await Html.PartialAsync("_Footer", HelpLink.Href(Url, currentController, currentAction))
@if (User.Identity?.IsAuthenticated == true)
{
    @await Html.PartialAsync("_SessionTimeoutWarning")
}
<script type="module" src="/js/govuk-frontend-6.5.0.min.js"></script>
<script type="module">
        import {
            initAll
        } from '/js/govuk-frontend-6.5.0.min.js'
        initAll()
</script>
<script src="/js/site.js" asp-append-version="true" defer></script>
<script src="/js/header-menu.js" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
