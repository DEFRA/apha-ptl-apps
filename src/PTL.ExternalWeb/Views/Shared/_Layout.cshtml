        <section aria-label="Service information" class="govuk-service-navigation"
                 data-module="govuk-service-navigation">
            <div class="govuk-width-container govuk-service-navigation__inlining-container">
                <div class="govuk-service-navigation__container">
                    <span class="govuk-service-navigation__service-name">
                        <a href="#" class="govuk-service-navigation__link">
                            Proficiency Testing - External
                        </a>
                    </span>
                    <nav aria-label="Menu" class="govuk-service-navigation__wrapper">
                        <button type="button" class="govuk-service-navigation__toggle govuk-js-service-navigation-toggle" aria-controls="navigation" hidden aria-hidden="true">
                            Menu
                        </button>
                        <ul class="govuk-service-navigation__list" id="navigation">
                            <li class="govuk-service-navigation__item govuk-service-navigation__item--active">
                                <a class="govuk-service-navigation__link" href="#" aria-current="true">
                                    <strong class="govuk-service-navigation__active-fallback">Navigation item 1</strong>
                                </a>
                            </li>
                          
                        </ul>
                    </nav>
                </div>
                @if (User.Identity is not null && User.Identity.IsAuthenticated)
                {
                    <nav aria-label="Account" class="govuk-service-navigation__wrapper">
                        <ul class="govuk-service-navigation__list">
                            <li class="govuk-service-navigation__item">
                                <span class="govuk-service-navigation__link">Signed in as <strong>@User.Identity.Name</strong></span>
                            </li>
                            <li class="govuk-service-navigation__item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="app-signout-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="govuk-service-navigation__link app-signout-button">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </section>
        <div class="govuk-phase-banner govuk-width-container">
            <p class="govuk-phase-banner__content">
                <strong class="govuk-tag govuk-phase-banner__content__tag">
                    Alpha
                </strong>
                <span class="govuk-phase-banner__text">
                    This is a new service – your <a class="govuk-link" href="#">feedback</a> will help us to improve it.
                </span>
            </p>
        </div>
    </header>
