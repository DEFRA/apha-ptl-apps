<!DOCTYPE html>
<html lang="en" class="govuk-template app-html-class">

<head>
    <meta charset="utf-8">
    <title>GOV.UK - Customised page template</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="blue">
    <link rel="stylesheet" href="/css/govuk-frontend-6.5.0.min.css">
    <link rel="icon" sizes="48x48" href="/assets/images/favicon.ico">
    <link rel="icon" sizes="any" href="/assets/images/favicon.svg" type="image/svg+xml">
    <link rel="mask-icon" href="/assets/images/govuk-icon-mask.svg" color="blue">
    <link rel="apple-touch-icon" href="/assets/images/govuk-icon-180.png">
    <link rel="manifest" href="/assets/manifest.json">
    <meta property="og:image" content="YOUR-DOMAIN/images/govuk-opengraph-image.png">
    <style>
        /* Sign out must be a form post for CSRF protection; reset button chrome so it reads as a service navigation link */
        .app-signout-form { display: inline; margin: 0; }
        .app-signout-button { background: none; border: 0; padding: 0; font: inherit; cursor: pointer; }
        .govuk-header__container { min-height: 56px; display: flex; align-items: center; }
        .app-service-bar { background: #ffffff; border-bottom: 1px solid #b1b4b6; }
        .app-service-bar__container { min-height: 70px; display: flex; align-items: center; }
        .app-account-panel { margin-left: auto; display: flex; align-items: center; gap: 1rem; }
        .app-side-navigation__title { font-weight: 700; margin-top: 1rem; }
        .app-side-navigation__list { margin-bottom: 1.5rem; }
        .app-side-navigation__link--disabled { color: #505a5f; }
        /* Quick-link tiles on Home - structure follows the DfE Frontend Card component
           (github.com/DFE-Digital/dfe-frontend, packages/components/card), recoloured with
           GOV.UK's own link/focus tokens instead of DfE's blue, since this is an APHA/Defra
           service, not a DfE one. */
        .app-card-group { display: flex; flex-direction: column; gap: 15px; margin-bottom: 30px; }
        @@media (min-width: 40.0625em) {
            .app-card-group { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px; }
        }
        .app-card { position: relative; display: flex; flex-direction: column; background-color: #ffffff; border: 1px solid var(--govuk-border-colour, #b1b4b6); }
        .app-card-container { padding: 15px; display: flex; flex-grow: 1; flex-direction: column; }
        .app-card-container > :last-child { margin-top: auto; margin-bottom: 0; }
        .app-card:hover, .app-card:focus-within { background-color: var(--govuk-link-colour, #1d70b8); }
        .app-card:hover a, .app-card:hover p, .app-card:hover .govuk-heading-m,
        .app-card:focus-within a, .app-card:focus-within p, .app-card:focus-within .govuk-heading-m { color: #ffffff; }
        .app-card:focus-within { outline: 3px solid #ffdd00; }
        .app-card-link--header { text-decoration: none; color: var(--govuk-link-colour, #1d70b8); }
        .app-card-link--header::after { content: ""; position: absolute; inset: 0; }
    </style>
</head>

<body class="govuk-template__body app-body-class" data-test="My value" data-other="report:details">
    <script>
            document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
    </script>
    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>
    @model dynamic

@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).Trim();
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).Trim();
    var isAccountFlowPage = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase)
        && (string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentAction, "SignedOut", StringComparison.OrdinalIgnoreCase));
}

@await Html.PartialAsync("_Header", ("Proficiency Testing - External", "height:40px; width:auto;"))
<div class="govuk-width-container app-width-container">
    <main role="main" class="pb-3" id="main-content">
        @if (!isAccountFlowPage)
        {
            @await Html.PartialAsync("_Breadcrumbs")
        }
        <div class="govuk-grid-row">
            @if (!isAccountFlowPage)
            {
                <div class="govuk-grid-column-one-quarter">
                    @await Html.PartialAsync("_SideNavigation")
                </div>
            }
            <div class="@(isAccountFlowPage ? "govuk-grid-column-full" : "govuk-grid-column-three-quarters")">
                @RenderBody()
            </div>
        </div>
    </main>
</div>
@await Html.PartialAsync("_Footer", "#")
<script type="module" src="/js/govuk-frontend-6.5.0.min.js"></script>
<script type="module">
        import {
            initAll
        } from '/js/govuk-frontend-6.5.0.min.js'
        initAll()
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
