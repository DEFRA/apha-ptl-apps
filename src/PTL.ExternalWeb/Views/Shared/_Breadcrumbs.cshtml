@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Routing
@using PTL.ExternalWeb.Navigation
@{
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).Trim();
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).Trim();

    static string ToDisplay(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return Regex.Replace(value, "([a-z])([A-Z])", "$1 $2", RegexOptions.None, TimeSpan.FromMilliseconds(100));
    }

    // GOV.UK guidance: breadcrumbs end at the parent section, not the current page itself
    // (design-system.service.gov.uk/components/breadcrumbs - "Removed guidance that advised
    // including the current page's name in the Breadcrumbs"). Match the route against
    // NavigationProvider's groups so the parent section is the actual nav section text (e.g.
    // "Results"), not a raw controller/action class name (e.g. "Distribution > Current" for the
    // Enter results page, "Distribution > Previous" for View results - both belong to "Results").
    // Pages that are not themselves a nav child (e.g. a confirmation step reached from one) name their parent
    // section via ViewData["BreadcrumbParent"].
    var parentSection = ViewData["BreadcrumbParent"] as string ?? NavigationProvider.Build()
        .FirstOrDefault(group => group.Children.Any(child =>
            string.Equals(child.ControllerName, controller, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(child.ActionName, action, StringComparison.OrdinalIgnoreCase)))
        ?.Text;

    // Pages in the legacy Web.sitemap follow its SiteMapPath: Home > ancestors (links) > current page
    // (plain text, aria-current) - there is no "Results" section level in legacy's trail. A page that
    // names its own ViewData["BreadcrumbParent"] (e.g. the order "not available" page) opts out.
    var query = ViewContext.HttpContext.Request.Query;
    var listReturnUrl = ViewData["ListReturnUrl"] as string;
    var trail = ViewData["BreadcrumbParent"] is null
        ? NavigationProvider.BreadcrumbTrail(controller, action, query["year"].FirstOrDefault())
        : null;

    var hasController =
        parentSection is null && trail is null &&
        !string.IsNullOrWhiteSpace(controller) &&
        !string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase);

    var hasAction = parentSection is null && trail is null && !string.IsNullOrWhiteSpace(action) && !string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item">
            <a class="govuk-breadcrumbs__link" asp-controller="Home" asp-action="Index">Home</a>
        </li>

        @if (trail is not null)
        {
            for (var i = 0; i < trail.Count; i++)
            {
                var crumb = trail[i];
                var routeValue = crumb.RouteKey is null ? null : query[crumb.RouteKey].FirstOrDefault();

                if (i == trail.Count - 1)
                {
                    <li class="govuk-breadcrumbs__list-item" aria-current="page">@crumb.Text</li>
                }
                else if (crumb.RouteKey is null || !string.IsNullOrEmpty(routeValue))
                {
                    var values = new RouteValueDictionary();
                    if (crumb.RouteKey is not null)
                    {
                        values[crumb.RouteKey] = routeValue;

                        // A step that needs an id still has to carry the list URL on so the page it opens can go back to it.
                        if (listReturnUrl is not null)
                        {
                            values["returnUrl"] = listReturnUrl;
                        }
                    }

                    // The step that is the filterable list itself returns to the filtered list the user came from.
                    var listPath = PTL.ExternalWeb.ViewSupport.ListReturnUrl.ListPathFor(crumb.Controller, crumb.Action);
                    var href = listPath is not null && PTL.ExternalWeb.ViewSupport.ListReturnUrl.Validate(listReturnUrl, listPath) is { } filteredList
                        ? filteredList
                        : Url.Action(crumb.Action, crumb.Controller, values);

                    <li class="govuk-breadcrumbs__list-item">
                        <a class="govuk-breadcrumbs__link" href="@href">@crumb.Text</a>
                    </li>
                }
                else
                {
                    @* An ancestor needing an id the request does not carry would link to an error page, so it stays text. *@
                    <li class="govuk-breadcrumbs__list-item">@crumb.Text</li>
                }
            }
        }
        else if (parentSection is not null)
        {
            <li class="govuk-breadcrumbs__list-item">@parentSection</li>
        }

        @if (hasController)
        {
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" asp-controller="@controller" asp-action="Index">@ToDisplay(controller)</a>
            </li>
        }

        @if (hasAction)
        {
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" asp-controller="@controller" asp-action="@action">@ToDisplay(action)</a>
            </li>
        }
    </ol>
</nav>
