@model string
@{
    var helpUrl = string.IsNullOrEmpty(Model) ? "#" : Model;
}
<partial name="_GovUkFooter" model="@(new (string Text, string Href, string? AriaLabel)[]
{
    ("Help", helpUrl, "View our help documentation"),
    ("Cookies", Url.Action("Cookies", "Home")!, "View our cookie policy"),
    ("Accessibility statement", Url.Action("Accessibility", "Home")!, "View our accessibility statement"),
    ("Privacy policy", Url.Action("Privacy", "Home")!, "View our privacy policy"),
})" />
