@using PTL.Common.Auth
@using PTL.ExternalWeb.Features.Account
@using PTL.Auth.Cidm.Options
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Options
@inject IOptions<CidmOptions> CidmOptionsAccessor
@model (string ServiceName, string? LogoStyle)
@{
    var isSignedIn = User.Identity is not null && User.Identity.IsAuthenticated;

    // Sign out must stay a form post (CSRF); it sits in the top bar with Menu, CIDM account and User Manual.
    Func<dynamic, IHtmlContent> signOutForm = @<form asp-controller="Account" asp-action="Logout" method="post" class="app-signout-form">
        @Html.AntiForgeryToken()
        <button type="submit" class="app-signout-button">Sign out</button>
    </form>;
    IHtmlContent? signOut = isSignedIn ? signOutForm(0) : null;
}
<govuk-page-header service-name="@Model.ServiceName" logo-style="@Model.LogoStyle" logo-url="~/images/apha-scientific-logo.png" logo-alt="APHA Scientific" secondary-logo-url="~/images/vetqas-logo.jpg" secondary-logo-alt="VETQAS" secondary-logo-style="width:70px; height:auto;" show-menu-toggle="@isSignedIn" account-link-text="@(isSignedIn ? "CIDM account" : null)" account-link-href="@CidmOptionsAccessor.Value.AccountPortalUrl" help-link-text="User Manual" help-link-href="/documents/User Manual.pdf" extra-actions="@signOut">
    @if (User.Identity is not null && User.Identity.IsAuthenticated)
    {
        // CIDM's id_token has no "name" claim without the "profile" scope, so the resolved
        // displayName claim leads and the shared id_token fallbacks follow.
        var labCode = User.FindFirst(ExternalUserClaimTypes.LabCode)?.Value;
        var friendlyName = User.GetDisplayName(preferredClaimType: ExternalUserClaimTypes.DisplayName);
        <nav aria-label="Account navigation" class="govuk-service-navigation__wrapper">
            <ul class="govuk-service-navigation__list">
                @if (!string.IsNullOrWhiteSpace(labCode))
                {
                    <li class="govuk-service-navigation__item">
                        Lab Number: <strong>@labCode</strong>
                    </li>
                }
                @if (User.CanSwitchLab())
                {
                    <li class="govuk-service-navigation__item">
                        <a class="govuk-service-navigation__link" asp-controller="Lab" asp-action="Select">Switch lab</a>
                    </li>
                }
                @if (!string.IsNullOrWhiteSpace(friendlyName))
                {
                    <li class="govuk-service-navigation__item">
                        Signed in as: <strong>@friendlyName</strong>
                    </li>
                }
            </ul>
        </nav>
    }
</govuk-page-header>
@if (User.Identity is not null && User.Identity.IsAuthenticated)
{
    <govuk-menu-panel>
        @await Component.InvokeAsync("HeaderMenu")
    </govuk-menu-panel>
}

