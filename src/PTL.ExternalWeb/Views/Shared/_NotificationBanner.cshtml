@using PTL.SharedUI.Notifications
@{
    var notification = TempData.GetNotification();

    if (notification is null)
    {
        return;
    }

    var title = notification.Type switch
    {
        NotificationType.Success => "Success",
        NotificationType.Information => "Information",
        NotificationType.Warning => "Warning",
        NotificationType.Error => "Error",
        _ => "Information"
    };

    var bannerClass = notification.Type == NotificationType.Success
        ? "govuk-notification-banner govuk-notification-banner--success"
        : "govuk-notification-banner";

    var role = notification.Type is NotificationType.Success or NotificationType.Error
        ? "alert"
        : "region";
}

<div class="@bannerClass" role="@role" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
    <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
            @title
        </h2>
    </div>
    <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">
            @notification.Message
        </p>
    </div>
</div>
