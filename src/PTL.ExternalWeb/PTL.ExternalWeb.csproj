<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables dotnet user-secrets for local CIDM credentials - only loaded automatically by
         WebApplicationBuilder when running as the Development environment. -->
    <UserSecretsId>ptl-externalweb-1f2c6d9a-6b8e-4b3d-9e7a-5c2f0a8b7d61</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PTL.ApiClient\PTL.ApiClient.csproj" />
    <ProjectReference Include="..\PTL.Auth.Cidm\PTL.Auth.Cidm.csproj" />
    <ProjectReference Include="..\PTL.Common\PTL.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Views shared byte-for-byte with the other PTL web front-end(s) - single physical file under
         src/Shared, linked in here (and in the sibling app) instead of duplicated per app. -->
    <Content Include="..\Shared\Views\Shared\Error.cshtml" Link="Views\Shared\Error.cshtml" />
    <Content Include="..\Shared\Views\Shared\_Footer.cshtml" Link="Views\Shared\_Footer.cshtml" />
    <Content Include="..\Shared\Views\Shared\_Header.cshtml" Link="Views\Shared\_Header.cshtml" />
    <Content Include="..\Shared\Views\Account\Login.cshtml" Link="Features\Account\Views\Login.cshtml" />
  </ItemGroup>

</Project>
