{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CreateOrder": {
    "TermsAndConditionsUrl": "https://www.aphascientific.com/wp-content/uploads/2025/06/VETQAS-Ts-Cs-April-2025-Version-6.pdf"
  },
  "Cidm": {
    "ResponseType": "code",
    "ResponseMode": "form_post",
    "Scopes": [ "openid", "offline_access" ],
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-oidc",
    "RefreshBeforeExpiry": "00:05:00"
  }
}
