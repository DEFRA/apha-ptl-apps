@model PTL.ExternalWeb.Features.Tabulation.TabulationPdfViewModel
@{
    Layout = null;
    var report = Model.Page.Report;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@report.TabulationName</title>
    <style>
        body {
            margin: 0;
            color: #0b0c0c;
            font-family: "GDS Transport", Arial, sans-serif;
            font-size: 16px;
            line-height: 1.25;
        }

        h1 { font-size: 32px; margin: 0 0 10px; }
        h2 { font-size: 24px; margin: 16px 0 8px; }
        h3 { font-size: 19px; margin: 10px 0 8px; }
        p { margin: 0 0 8px; }

        .ptl-table-scroll {
            position: relative;
            overflow: visible;
            margin-bottom: 14px;
        }

        .TabulationTable {
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
            empty-cells: show;
            border: 1px solid black !important;
            margin-left: 0;
            box-sizing: border-box;
            table-layout: auto;
        }

        .TabulationTable :where(th) {
            font-weight: inherit;
            text-align: left;
        }


        .TabulationHeader1,
        .TabulationHeader2 {
            font-size: 8.5pt;
            line-height: 1.15;
            color: black;
            background-color: white;
            border: solid 1px black;
            padding: 2px 3px;
            white-space: normal;
            overflow-wrap: break-word;
            word-break: normal;
            hyphens: none;
            writing-mode: horizontal-tb;
            text-orientation: mixed;
        }

        .TabulationHeader1 {
            font-weight: bold;
        }

        .TabulationHeader2 {
            vertical-align: bottom;
            font-size: 8pt;
            line-height: 1.15;
        }

        .TabulationCell {
            font-size: 8pt;
            line-height: 1.15;
            border: solid 1px black;
            padding: 2px 3px;
            color: black;
            background-color: white;
            white-space: normal;
            overflow-wrap: break-word;
            word-break: normal;
            hyphens: none;
            writing-mode: horizontal-tb;
            text-orientation: mixed;
        }

        .NilReturn {
            background-color: #eeeeee;
        }

        .ptl-pdf-header-image {
            display: block;
            width: 70%;
            margin: 0 0 8px;
        }

        .TabulationTable th,
        .TabulationTable td {
            border: 1px solid black !important;
            box-sizing: border-box;
            vertical-align: top;
            writing-mode: horizontal-tb;
            text-orientation: mixed;
            transform: none;
            text-transform: none;
            letter-spacing: normal;
            white-space: normal;
            overflow-wrap: break-word;
            word-break: normal;
            hyphens: none;
        }

        .ptl-pdf-title-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 24px;
        }

        .ptl-pdf-distribution-date {
            margin: 0;
            font-weight: bold;
            white-space: nowrap;
        }

        .ptl-pdf-footer {
            margin-top: 1em;
            break-inside: avoid;
        }

        .ptl-pdf-footer-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: start;
            gap: 24px;
        }

        .ptl-tabulation-ukas {
            text-align: center;
        }

        .ptl-tabulation-ukas img {
            display: block;
            margin: 0 auto 4px;
        }

        .cellVersionDate {
            text-align: left;
        }

        .cellTabulationSignature,
        .cellTabulationSignature2 {
            text-align: right;
        }

        .cellVersionDate,
        .cellTabulationSignature,
        .cellTabulationSignature2 {
            font-size: 8.5pt;
            color: black;
            font-weight: normal;
        }

        .cellTabulationSignature {
            font-weight: bold;
        }

        .cellTabulationSignature2.cellTabulationIssued {
            margin-top: 6px;
            font-weight: normal;
        }

        #commentsDiv p {
            margin: 0;
        }

        .govuk-visually-hidden {
            position: absolute !important;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
    </style>
</head>
<body>
    @if (!string.IsNullOrWhiteSpace(Model.HeaderImageDataUri))
    {
        <img class="ptl-pdf-header-image" src="@Model.HeaderImageDataUri" alt="VETQAS and APHA Scientific" />
    }

    <div class="ptl-pdf-title-row">
        <h2>@report.Title</h2>
        <p class="ptl-pdf-distribution-date">@report.DistributionDateText</p>
    </div>

    <div class="ptl-tabulation-screen">
        @foreach (var table in report.Tables)
        {
            <govuk-tabulation-table table="table" />
        }

        @if (report.Ratings is not null)
        {
            <govuk-tabulation-table table="report.Ratings" />
        }
    </div>

    <div id="tabulation-print-tables"></div>
    <script type="application/json" id="tabulation-print-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(report.Print, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
    <script>
        (function () {
            "use strict";

            const pageWidth = 900;
            const stretchWidth = 300;

            function cell(text, className) {
                const td = document.createElement("td");
                td.textContent = text;
                td.className = className;
                return td;
            }

            function withSpace(text) {
                return (text || "") + "\u00a0";
            }

            const INTENDED_VALUE_ROW = 3;
            const FIRST_PARTICIPANT_ROW = INTENDED_VALUE_ROW + 1;

            class CustomTable {
                constructor(testName, participants) {
                    this.table = document.createElement("table");
                    this.table.className = "TabulationTable";
                    const body = document.createElement("tbody");

                    const header = document.createElement("tr");
                    const headerCell = cell(testName, "TabulationHeader1");
                    headerCell.rowSpan = 2;
                    header.appendChild(headerCell);
                    body.appendChild(header);
                    body.appendChild(document.createElement("tr"));

                    const intended = document.createElement("tr");
                    const intendedCell = cell("Intended", "TabulationCell");
                    intendedCell.rowSpan = 2;
                    intended.appendChild(intendedCell);
                    body.appendChild(intended);
                    body.appendChild(document.createElement("tr"));

                    participants.forEach(function (p) {
                        const row = document.createElement("tr");
                        row.appendChild(cell(withSpace(p.labCode), "TabulationCell"));
                        body.appendChild(row);
                    });

                    this.table.appendChild(body);
                    this.participants = participants;
                }

                addNilReturn(rowIndex, isFirstColumn) {
                    const row = this.table.rows[FIRST_PARTICIPANT_ROW + rowIndex];
                    if (isFirstColumn) {
                        row.appendChild(cell(this.participants[rowIndex].nilReturnReason, "TabulationCell NilReturn"));
                    } else {
                        row.cells[row.cells.length - 1].colSpan += 1;
                    }
                }

                addMethodColumn(column) {
                    const header = cell(column.headerText, "TabulationHeader2");
                    header.rowSpan = 2;
                    this.table.rows[0].appendChild(header);
                    this.table.rows[2].appendChild(cell("\u00a0", "TabulationCell"));
                    this.table.rows[INTENDED_VALUE_ROW].appendChild(cell(withSpace(column.intendedResult), "TabulationCell"));

                    const isFirstColumn = this.table.rows[0].cells.length === 2;
                    for (let i = 0; i < column.results.length; i++) {
                        if (this.participants[i].hasResults) {
                            this.table.rows[FIRST_PARTICIPANT_ROW + i].appendChild(cell(column.results[i], "TabulationCell"));
                        } else {
                            this.addNilReturn(i, isFirstColumn);
                        }
                    }
                }

                addSampleColumn(sample) {
                    const header = cell(sample.sampleNumber, "TabulationHeader1");
                    header.colSpan = sample.resultColumns.length;
                    this.table.rows[0].appendChild(header);

                    const intended = cell(withSpace(sample.tabulationDescription), "TabulationCell");
                    intended.colSpan = sample.resultColumns.length;
                    this.table.rows[2].appendChild(intended);

                    for (const column of sample.resultColumns) {
                        this.table.rows[1].appendChild(cell(column.headerText, "TabulationHeader2"));
                        this.table.rows[INTENDED_VALUE_ROW].appendChild(cell(withSpace(column.intendedResult), "TabulationCell"));
                        this.addSampleResults(column.results);
                    }
                }

                addSampleResults(results) {
                    for (let j = 0; j < results.length; j++) {
                        const row = this.table.rows[FIRST_PARTICIPANT_ROW + j];
                        if (!this.participants[j].hasResults) {
                            this.addNilReturn(j, row.cells.length === 1);
                        } else if (results[j].span > 0) {
                            const td = cell(results[j].result, "TabulationCell");
                            td.colSpan = results[j].span;
                            row.appendChild(td);
                        }
                    }
                }
            }

            class RatingTable {
                constructor(participants) {
                    this.table = document.createElement("table");
                    this.table.className = "TabulationTable";
                    const body = document.createElement("tbody");

                    const header = document.createElement("tr");
                    header.appendChild(cell("QAU Ratings", "TabulationHeader1"));
                    body.appendChild(header);

                    const labels = participants.map(function (p) { return withSpace(p.labCode); })
                        .concat(["Mean score of all laboratories: ",
                            "No. of Labs reporting intended results: ",
                            "No. Of Participants: ",
                            "Percent Correct: "]);
                    labels.forEach(function (label) {
                        const row = document.createElement("tr");
                        row.appendChild(cell(label, "TabulationCell"));
                        body.appendChild(row);
                    });

                    this.table.appendChild(body);
                }

                addRatingColumn(column) {
                    const rows = this.table.rows;
                    rows[0].appendChild(cell(column.sampleNumber, "TabulationHeader2"));
                    column.ratings.forEach(function (rating, i) {
                        rows[1 + i].appendChild(cell(rating, "TabulationCell"));
                    });

                    const statistics = [column.sampleMean, column.numberReportingIntendedResult, column.numberOfParticipants, column.samplePassRate];
                    statistics.forEach(function (value, i) {
                        rows[1 + column.ratings.length + i].appendChild(cell(value, "TabulationHeader2"));
                    });
                }
            }

            function addColumns(container, columns, createTable, addColumn) {
                let table = createTable();
                container.appendChild(table.table);
                container.appendChild(document.createElement("br"));

                for (let i = 0; i < columns.length; i++) {
                    const previous = table.table.cloneNode(true);
                    const isFirstColumn = table.table.rows[0].cells.length === 1;
                    addColumn(table, columns[i]);

                    if (table.table.offsetWidth > pageWidth && !isFirstColumn) {
                        table.table.parentNode.replaceChild(previous, table.table);
                        table = createTable();
                        container.appendChild(table.table);
                        container.appendChild(document.createElement("br"));
                        i--;
                    }
                }
            }

            function build(container, data) {
                container.style.width = pageWidth + "px";
                const participants = data.participants || [];

                (data.tests || []).forEach(function (test) {
                    const columns = (test.methodColumns || []).map(function (c) { return { kind: "method", value: c }; })
                        .concat((test.sampleColumns || [])
                            .filter(function (s) { return (s.resultColumns || []).length > 0; })
                            .map(function (s) { return { kind: "sample", value: s }; }));

                    addColumns(container, columns,
                        function () { return new CustomTable(test.name, participants); },
                        function (table, column) {
                            if (column.kind === "method") {
                                table.addMethodColumn(column.value);
                            } else {
                                table.addSampleColumn(column.value);
                            }
                        });
                });

                if ((data.ratingColumns || []).length > 0) {
                    addColumns(container, data.ratingColumns,
                        function () { return new RatingTable(participants); },
                        function (table, column) { table.addRatingColumn(column); });
                }

                const tables = container.getElementsByTagName("table");
                for (const printTable of tables) {
                    if (printTable.offsetWidth >= stretchWidth) {
                        printTable.style.width = pageWidth + "px";
                    }
                }

                if (tables.length > 0) {
                    document.querySelectorAll(".ptl-tabulation-screen").forEach(function (screen) {
                        screen.style.display = "none";
                    });
                }
            }

            const dataElement = document.getElementById("tabulation-print-data");
            const container = document.getElementById("tabulation-print-tables");
            if (!dataElement || !container || !dataElement.textContent) {
                return;
            }

            build(container, JSON.parse(dataElement.textContent));
        })();
    </script>

    <div id="commentsDiv">
        @if (!string.IsNullOrEmpty(report.StandardTabulationTextHtml))
        {
            <div>@Html.Raw(report.StandardTabulationTextHtml)</div>
        }

        @if (!string.IsNullOrEmpty(report.CommentsHtml))
        {
            <div>@Html.Raw(report.CommentsHtml)</div>
        }

        @if (!string.IsNullOrEmpty(report.TestConsultantCommentsHtml))
        {
            <div>
                <h2>@report.TestConsultantCommentsTitle</h2>
                @Html.Raw(report.TestConsultantCommentsHtml)
            </div>
        }

        @if (report.Attachment is not null)
        {
            <p><strong>Supporting Document: </strong>@report.Attachment.FileName</p>
        }

        @if (report.Signatory is not null || report.ShowUkasLogo)
        {
            <div class="ptl-pdf-footer">
                @if (report.ShowUkasLogo)
                {
                    <div class="ptl-tabulation-ukas">
                        @if (!string.IsNullOrWhiteSpace(Model.UkasLogoDataUri))
                        {
                            <img src="@Model.UkasLogoDataUri" alt="UKAS accredited" width="60" />
                        }
                        <div>0004</div>
                    </div>
                }

                <div class="ptl-pdf-footer-row">
                    <div class="cellVersionDate">@report.Signatory?.VersionText</div>

                    <div class="cellTabulationSignature">
                        @if (report.Signatory is { } signatory)
                        {
                            <div>@signatory.Signatory</div>
                            @foreach (var line in signatory.AddressLines)
                            {
                                <div class="cellTabulationSignature2">@line</div>
                            }
                            <div class="cellTabulationSignature2 cellTabulationIssued">@signatory.IssuedText</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</body>
</html>
