@model PTL.ExternalWeb.Features.Tabulation.TabulationListViewModel
@using System.Globalization
@using Microsoft.AspNetCore.Html
@using PTL.SharedUI.Pagination
@{
    ViewData["Title"] = "View Reports";
    var pagination = new PaginationModel
    {
        CurrentPage = Model.Page,
        PageSize = Model.PageSize,
        TotalRecords = Model.TotalCount,
        RouteValues = new Dictionary<string, object?>
        {
            ["year"] = Model.Year,
            ["month"] = Model.Month,
            ["distributionReference"] = Model.DistributionReference,
            ["schemeCode"] = Model.SchemeCode,
            ["schemeName"] = Model.SchemeName,
            ["sortBy"] = Model.SortBy,
            ["sortDir"] = Model.SortDirection,
        }
    };

    string SortUrl(string column)
    {
        var dir = Model.SortBy == column && Model.SortDirection == "asc" ? "desc" : "asc";
        return Url.Action("Index", new
        {
            page = 1,
            pageSize = Model.PageSize,
            sortBy = column,
            sortDir = dir,
            year = Model.Year,
            month = Model.Month,
            distributionReference = Model.DistributionReference,
            schemeCode = Model.SchemeCode,
            schemeName = Model.SchemeName,
        })!;
    }

    static string AriaSort(string currentSortBy, string currentSortDir, string column) =>
        currentSortBy != column ? "none" : currentSortDir == "asc" ? "ascending" : "descending";

    // GOV.UK ships no sortable-table-header component - matches the hand-rolled pattern already
    // used by Features/Scheme/Views/Index.cshtml (aria-sort on the th, a visible glyph plus a
    // visually-hidden direction label alongside the column link).
    IHtmlContent SortIndicator(string column)
    {
        if (Model.SortBy != column)
        {
            return HtmlString.Empty;
        }

        var arrow = Model.SortDirection == "asc" ? " \u25b2" : " \u25bc";
        var direction = Model.SortDirection == "asc" ? "ascending" : "descending";
        return new HtmlString($"""<span aria-hidden="true">{arrow}</span><span class="govuk-visually-hidden">, sorted {direction}</span>""");
    }
}

<h1 class="govuk-heading-l">View Reports</h1>

<p class="govuk-body">View published proficiency test reports (tabulations) for the schemes you are linked to.</p>

<form method="get" asp-action="Index" class="govuk-!-margin-bottom-6">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group">
                <label class="govuk-label" for="year">Year</label>
                <select class="govuk-select" id="year" name="year">
                    <option value="">All</option>
                    @foreach (var availableYear in Model.AvailableYears)
                    {
                        <option value="@availableYear" selected="@(Model.Year == availableYear)">@availableYear</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="month">Month</label>
                <select class="govuk-select" id="month" name="month">
                    <option value="">All</option>
                    @for (var monthId = 1; monthId <= 12; monthId++)
                    {
                        <option value="@monthId" selected="@(Model.Month == monthId)">@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(monthId)</option>
                    }
                </select>
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="distributionReference">Distribution Reference</label>
                <input class="govuk-input" id="distributionReference" name="distributionReference" value="@Model.DistributionReference" />
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="schemeCode">Scheme Code</label>
                <input class="govuk-input" id="schemeCode" name="schemeCode" value="@Model.SchemeCode" />
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="schemeName">Scheme Name</label>
                <input class="govuk-input" id="schemeName" name="schemeName" value="@Model.SchemeName" />
            </div>
        </div>
    </div>

    <div class="govuk-button-group">
        <button class="govuk-button" data-module="govuk-button" type="submit">Search</button>
        <a class="govuk-button govuk-button--secondary" data-module="govuk-button" asp-action="Index">Show All</a>
    </div>
</form>

@if (Model.Tabulations.Count == 0)
{
    <p class="govuk-body">@(Model.IsFiltered ? "No reports found for the selected search criteria." : "There are no reports to display.")</p>
}
else
{
    <govuk-page-size-selector model="pagination" />

    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header" aria-sort="@AriaSort(Model.SortBy, Model.SortDirection, "reference")">
                    <a class="govuk-link" href="@SortUrl("reference")">Distribution Reference@(SortIndicator("reference"))</a>
                </th>
                <th scope="col" class="govuk-table__header" aria-sort="@AriaSort(Model.SortBy, Model.SortDirection, "schemeCode")">
                    <a class="govuk-link" href="@SortUrl("schemeCode")">Scheme Code@(SortIndicator("schemeCode"))</a>
                </th>
                <th scope="col" class="govuk-table__header" aria-sort="@AriaSort(Model.SortBy, Model.SortDirection, "schemeName")">
                    <a class="govuk-link" href="@SortUrl("schemeName")">Scheme Name@(SortIndicator("schemeName"))</a>
                </th>
                <th scope="col" class="govuk-table__header" aria-sort="@AriaSort(Model.SortBy, Model.SortDirection, "tabulationName")">
                    <a class="govuk-link" href="@SortUrl("tabulationName")">Report Name@(SortIndicator("tabulationName"))</a>
                </th>
                <th scope="col" class="govuk-table__header" aria-sort="@AriaSort(Model.SortBy, Model.SortDirection, "distributionDate")">
                    <a class="govuk-link" href="@SortUrl("distributionDate")">Distribution Date@(SortIndicator("distributionDate"))</a>
                </th>
                <th scope="col" class="govuk-table__header">Report</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var tabulation in Model.Tabulations)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@tabulation.DistributionReference</td>
                    <td class="govuk-table__cell">@tabulation.SchemeCode</td>
                    <td class="govuk-table__cell">@tabulation.SchemeName</td>
                    <td class="govuk-table__cell">@tabulation.TabulationName</td>
                    <td class="govuk-table__cell">@tabulation.DistributionDate.ToString("d MMMM yyyy", CultureInfo.InvariantCulture)</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link"
                           asp-action="Report"
                           asp-route-publishedTabulationId="@tabulation.TabulationId"
                           aria-label="View report for @tabulation.DistributionReference">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <govuk-pagination model="pagination" />
}
