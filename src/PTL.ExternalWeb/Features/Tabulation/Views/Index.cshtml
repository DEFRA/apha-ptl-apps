@model PTL.ExternalWeb.Features.Tabulation.TabulationListViewModel
@using System.Globalization
@using Microsoft.AspNetCore.Http.Extensions
@using PTL.SharedUI.Pagination
@{
    ViewData["Title"] = "Reports";
    var pagination = new PaginationModel
    {
        CurrentPage = Model.Page,
        PageSize = Model.PageSize,
        TotalRecords = Model.TotalCount,
        RouteValues = new Dictionary<string, object?>
        {
            ["year"] = Model.Year,
            ["month"] = Model.Month,
            ["distributionReference"] = Model.DistributionReference,
            ["schemeCode"] = Model.SchemeCode,
            ["schemeName"] = Model.SchemeName,
            ["sortBy"] = Model.SortBy,
            ["sortDir"] = Model.SortDirection,
        }
    };

    string SortUrl(string column)
    {
        var dir = Model.SortBy == column && Model.SortDirection == "asc" ? "desc" : "asc";
        return Url.Action("Index", new
        {
            page = 1,
            pageSize = Model.PageSize,
            sortBy = column,
            sortDir = dir,
            year = Model.Year,
            month = Model.Month,
            distributionReference = Model.DistributionReference,
            schemeCode = Model.SchemeCode,
            schemeName = Model.SchemeName,
        })!;
    }

    var sortHeaders = new SortableHeaderContext(Model.SortBy, Model.SortDirection, SortUrl);
}

<h1 class="govuk-heading-l">Reports</h1>

<p class="govuk-body">View published proficiency test reports (tabulations) for the schemes you are linked to.</p>

<form method="get" asp-action="Index" class="govuk-!-margin-bottom-6">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group">
                <label class="govuk-label" for="year">Year</label>
                <select class="govuk-select" id="year" name="year">
                    <option value="">All</option>
                    @foreach (var availableYear in Model.AvailableYears)
                    {
                        <option value="@availableYear" selected="@(Model.Year == availableYear)">@availableYear</option>
                    }
                </select>
            </div>

            <partial name="_DistributionReferenceSchemeSearchFields" model="@(new PTL.ExternalWeb.ViewSupport.DistributionReferenceSchemeSearchFields(Model.Month, Model.DistributionReference, Model.SchemeCode, Model.SchemeName))" />
        </div>
    </div>

    <partial name="_SearchFormButtonGroup" model="@("Index")" />
</form>

@if (Model.Tabulations.Count == 0)
{
    <p class="govuk-body">@(Model.IsFiltered ? "No reports found for the selected search criteria." : "There are no reports to display.")</p>
}
else
{
    <govuk-page-size-selector model="pagination" />

    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <partial name="_DistributionReferenceSchemeHeaders" model="sortHeaders" />
                <partial name="_SortableHeader" model="@(sortHeaders.Header("Distribution date", "distributionDate"))" />
                <th scope="col" class="govuk-table__header">Report</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var tabulation in Model.Tabulations)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@tabulation.DistributionReference</td>
                    <td class="govuk-table__cell">@tabulation.SchemeCode</td>
                    <td class="govuk-table__cell">@tabulation.SchemeName</td>
                    <td class="govuk-table__cell">@tabulation.DistributionDate.ToString("dddd d MMMM yyyy", CultureInfo.InvariantCulture)</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link"
                           asp-action="Report"
                           asp-route-publishedTabulationId="@tabulation.TabulationId"
                           asp-route-returnUrl="@Context.Request.GetEncodedPathAndQuery()"
                           aria-label="View report for @tabulation.DistributionReference">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <govuk-pagination model="pagination" />
}
