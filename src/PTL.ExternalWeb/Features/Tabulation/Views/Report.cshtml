@model PTL.ExternalWeb.Features.Tabulation.TabulationReportPageViewModel
@using PTL.ExternalWeb.Features.Tabulation
@{
    var report = Model.Report;
    ViewData["Title"] = report.TabulationName;
}

<h1 class="govuk-heading-l">View reports</h1>
<h2 class="govuk-heading-m">@report.Title</h2>
<h3 class="govuk-heading-s">@report.TabulationName</h3>
<p class="govuk-body">@report.DistributionDateText</p>

@if (Model.Tests is { } tests)
{
    for (var t = 0; t < tests.Count; t++)
    {
        var test = tests[t];
        var testAccordion = new TabulationAccordionViewModel($"tabulation-test-{t + 1}", test.Sections);

        <h3 class="govuk-heading-m">@test.TestName</h3>
        @if (test.AssessmentTestId is { } testId)
        {
            <p class="govuk-body">
                <a class="govuk-link" asp-action="AssessmentResults" asp-route-publishedTabulationId="@report.TabulationId" asp-route-testId="@testId" asp-route-returnUrl="@Model.ReturnUrl">
                    View assessment results<span class="govuk-visually-hidden"> for @test.TestName</span>
                </a>
            </p>
        }

        @await Html.PartialAsync("_TabulationAccordion", testAccordion)
    }

    if (report.Ratings is not null)
    {
        var ratingsAccordion = new TabulationAccordionViewModel("tabulation-ratings", [new TabulationAccordionSection(report.Ratings.Caption, report.Ratings)]);
        await Html.RenderPartialAsync("_TabulationAccordion", ratingsAccordion);
    }
}
else
{
    foreach (var table in report.Tables)
    {
        <govuk-tabulation-table table="table" />
        @if (table.AssessmentTestId is { } testId)
        {
            <p class="govuk-body">
                <a class="govuk-link" asp-action="AssessmentResults" asp-route-publishedTabulationId="@report.TabulationId" asp-route-testId="@testId" asp-route-returnUrl="@Model.ReturnUrl">
                    View assessment results<span class="govuk-visually-hidden"> for @table.Caption</span>
                </a>
            </p>
        }
    }

    if (report.Ratings is not null)
    {
        <govuk-tabulation-table table="report.Ratings" />
    }
}

<div id="commentsDiv">
    @if (!string.IsNullOrEmpty(report.StandardTabulationTextHtml))
    {
        <div class="govuk-body">
            @Html.Raw(report.StandardTabulationTextHtml)
        </div>
    }

    @if (!string.IsNullOrEmpty(report.CommentsHtml))
    {
        <div class="govuk-body">
            @Html.Raw(report.CommentsHtml)
        </div>
    }

    @if (!string.IsNullOrEmpty(report.TestConsultantCommentsHtml))
    {
        <div class="govuk-body">
            <h3 class="govuk-heading-m">@report.TestConsultantCommentsTitle</h3>
            @Html.Raw(report.TestConsultantCommentsHtml)
        </div>
    }

    @if (report.Attachment is not null)
    {
        <p class="govuk-body">
            <strong>Supporting Document: </strong>
            <a class="govuk-link" asp-action="Attachment" asp-route-publishedTabulationId="@report.TabulationId" asp-route-attachmentId="@report.Attachment.AttachmentId">View Supporting Document</a>
        </p>
    }

    @if (report.Signatory is { } versionSignatory)
    {
        <div class="cellVersionDate">@versionSignatory.VersionText</div>
    }

    @if (report.ShowUkasLogo)
    {
        <div class="ptl-tabulation-ukas">
            <img src="~/images/ukas.png" alt="UKAS accredited" width="60" />
            <div>0004</div>
        </div>
    }

    @if (report.Signatory is { } signatory)
    {
        <div class="cellTabulationSignature">
            @if (!string.IsNullOrWhiteSpace(signatory.Signatory))
            {
                <h3 class="govuk-heading-m govuk-!-margin-bottom-1">@signatory.Signatory</h3>
            }
            @foreach (var line in signatory.AddressLines)
            {
                <div class="cellTabulationSignature2">@line</div>
            }
            <div class="cellTabulationSignature2 cellTabulationIssued">@signatory.IssuedText</div>
        </div>
    }
</div>

<div class="govuk-button-group govuk-!-margin-top-6">
    <a class="govuk-button govuk-button--secondary" href="@(Model.ReturnUrl ?? Url.Action("Index"))">Back</a>
    <a class="govuk-button govuk-button--secondary" asp-action="GeneratePdf" asp-route-publishedTabulationId="@report.TabulationId">Generate PDF</a>
</div>
