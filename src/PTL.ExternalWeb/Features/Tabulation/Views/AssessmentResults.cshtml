@model PTL.ExternalWeb.Features.Tabulation.AssessmentResultsPageViewModel
@{
    var results = Model.Results;
    ViewData["Title"] = "Assessment results";
}

<h1 class="govuk-heading-l">Assessment results</h1>

@if (!results.IsAssessmentSubmitted)
{
    <p class="govuk-body">Assessment results have not yet been submitted for this test.</p>
}
else
{
    <h2 class="govuk-visually-hidden">Assessment information</h2>
    <dl class="govuk-summary-list">
        @foreach (var (label, value) in Model.Details)
        {
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">@label</dt>
                <dd class="govuk-summary-list__value">@value</dd>
            </div>
        }
    </dl>

    <h2 class="govuk-heading-m">Score distribution chart</h2>
    <p class="govuk-body">@(results.Titles.Count > 0 ? results.Titles[0] : string.Empty)</p>
    <govuk-assessment-chart results="results" width="1024" height="400" bar-colour="#00703c"
                            show-y-axis-title="false" legend="@results.YAxisTitle" />

    <h2 class="govuk-heading-m">Assessment results data table</h2>
    <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--s">Frequency of assessment scores</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">@results.XAxisTitle</th>
                <th scope="col" class="govuk-table__header govuk-table__header--numeric">@results.YAxisTitle</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var score in results.Scores)
            {
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">@score.Label</th>
                    <td class="govuk-table__cell govuk-table__cell--numeric">@score.Frequency</td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="govuk-button govuk-button--secondary" asp-action="Report" asp-route-publishedTabulationId="@Model.PublishedTabulationId" asp-route-returnUrl="@Model.ReturnUrl">Back</a>
