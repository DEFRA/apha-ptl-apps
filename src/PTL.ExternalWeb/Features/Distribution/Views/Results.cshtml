@model PTL.Contracts.Distribution.ActualResultsResponse
@{
    ViewData["Title"] = $"View results - {Model.Heading}";
}

<h1 class="govuk-heading-l">View results</h1>

<h2 class="govuk-heading-m">@Model.Heading</h2>

<p class="govuk-body">The tables below show the results that were entered for this distribution.</p>

<govuk-readonly-results-tables tests="Model.Tests" per-sample="true" />

<a class="govuk-button govuk-button--secondary" data-module="govuk-button" href="@(ViewData["ListReturnUrl"] as string ?? Url.Action("Previous"))">Back</a>
