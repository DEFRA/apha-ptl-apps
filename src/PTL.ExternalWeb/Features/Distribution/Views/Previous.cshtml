@model PTL.ExternalWeb.Features.Distribution.DistributionPreviousListViewModel
@using System.Globalization
@using Microsoft.AspNetCore.Http.Extensions
@using PTL.SharedUI.Pagination
@{
    ViewData["Title"] = "Previous distributions";
    var pagination = new PaginationModel
    {
        CurrentPage = Model.Page,
        PageSize = Model.PageSize,
        TotalRecords = Model.TotalCount,
        Action = "Previous",
        RouteValues = new Dictionary<string, object?>
        {
            ["year"] = Model.Year,
            ["month"] = Model.Month,
            ["distributionReference"] = Model.DistributionReference,
            ["schemeCode"] = Model.SchemeCode,
            ["schemeName"] = Model.SchemeName,
            ["sortBy"] = Model.SortBy,
            ["sortDir"] = Model.SortDirection,
        }
    };

    string SortUrl(string column)
    {
        var dir = Model.SortBy == column && Model.SortDirection == "asc" ? "desc" : "asc";
        return Url.Action("Previous", new
        {
            page = 1,
            pageSize = Model.PageSize,
            sortBy = column,
            sortDir = dir,
            year = Model.Year,
            month = Model.Month,
            distributionReference = Model.DistributionReference,
            schemeCode = Model.SchemeCode,
            schemeName = Model.SchemeName,
        })!;
    }

    var sortHeaders = new SortableHeaderContext(Model.SortBy, Model.SortDirection, SortUrl);
}

<h1 class="govuk-heading-l">Previous distributions</h1>

<p class="govuk-body">Please select the month and year of the distribution, the distribution reference number or the scheme name of the distribution you wish to view.</p>

<form method="get" asp-action="Previous" class="govuk-!-margin-bottom-6">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group">
                <label class="govuk-label" for="year">Year</label>
                <select class="govuk-select" id="year" name="year">
                    <option value="">All</option>
                    @foreach (var year in Model.Years)
                    {
                        <option value="@year" selected="@(Model.Year == year)">@year</option>
                    }
                </select>
            </div>

            <partial name="_DistributionReferenceSchemeSearchFields" model="@(new PTL.ExternalWeb.ViewSupport.DistributionReferenceSchemeSearchFields(Model.Month, Model.DistributionReference, Model.SchemeCode, Model.SchemeName))" />
        </div>
    </div>

    <partial name="_SearchFormButtonGroup" model="@("Previous")" />
</form>

@if (Model.Distributions.Count == 0)
{
    <p class="govuk-body">@(Model.IsFiltered ? "No results found for the selected search criteria." : "There are no distributions to display.")</p>
}
else
{
    <govuk-page-size-selector model="pagination" />

    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <partial name="_DistributionReferenceSchemeHeaders" model="sortHeaders" />
                <partial name="_SortableHeader" model="@(sortHeaders.Header("Distribution date", "distributionDate"))" />
                <th scope="col" class="govuk-table__header">Results</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var distribution in Model.Distributions)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@distribution.DistributionReference</td>
                    <td class="govuk-table__cell">@distribution.SchemeCode</td>
                    <td class="govuk-table__cell">@distribution.SchemeName</td>
                    <td class="govuk-table__cell">@distribution.DistributionDate.ToString("dddd d MMMM yyyy", CultureInfo.InvariantCulture)</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link"
                           asp-action="Results"
                           asp-route-monthlyDistributionSchemeId="@distribution.MonthlyDistributionSchemeId"
                           asp-route-returnUrl="@Context.Request.GetEncodedPathAndQuery()"
                           aria-label="View results for @distribution.DistributionReference">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <govuk-pagination model="pagination" />
}
