@model PTL.ExternalWeb.Features.Distribution.DistributionResultsEntryViewModel
@{
    ViewData["Title"] = $"Results entry - {Model.Heading}";

    const string closedMessage = "This distribution is closed and results can no longer be edited.";

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .ToList();

    var saveFailed = ViewData["SaveFailed"] is true;

    if (saveFailed)
    {
        errors.Insert(0, (Field: string.Empty, Message: closedMessage));
        if (ViewData.ModelState.IsValid)
        {
            ViewData["Title"] = $"Error: {ViewData["Title"]}";
        }
    }
}

<govuk-error-summary errors="@errors" />

<h1 class="govuk-heading-l">Results entry</h1>
<h2 class="govuk-heading-m">@Model.Heading</h2>

@if (Model.IsReadOnly)
{
    <p class="govuk-body">This distribution is closed and results can no longer be edited.</p>
    <p class="govuk-body">The tables below show the results that were entered for this distribution.</p>
}
else
{
    <p class="govuk-body">Enter the Test Results below. Tests are divided into Result Items which are tested for each Sample, and Method Items which apply to the Test itself.</p>
    <p class="govuk-body">Results can be saved at any time up until the deadline date provided that all the inputs are valid.</p>
    <p class="govuk-body">If you are not submitting results, you can submit a nil return with a reason.</p>

    if (Model.HasNilReturn)
    {
        <div class="govuk-inset-text">
            <p class="govuk-body govuk-!-margin-bottom-2">A nil return has been submitted for this distribution.</p>
            @if (!string.IsNullOrWhiteSpace(Model.NilReturnReason))
            {
                <p class="govuk-body govuk-!-margin-bottom-0"><strong>Reason:</strong> @Model.NilReturnReason</p>
            }
        </div>
    }
}

<form method="post" asp-action="Entry">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MonthlyDistributionSchemeId" />
    <input type="hidden" asp-for="IsReadOnly" />

    @for (var t = 0; t < Model.Tests.Count; t++)
    {
        var test = Model.Tests[t];

        <input type="hidden" asp-for="Tests[t].TestId" />

        <h2 class="govuk-heading-m">@test.TestName</h2>

        @for (var r = 0; r < test.ResultItems.Count; r++)
        {
            <input type="hidden" asp-for="Tests[t].ResultItems[r].TestResultItemId" />
        }

        @if (test.ResultItems.Count == 0)
        {
            <p class="govuk-body">This test has no result items.</p>
        }

        @for (var s = 0; s < test.Samples.Count; s++)
        {
            var sample = test.Samples[s];

            @* Every sample id is posted so list indexes stay contiguous for model binding. *@
            <input type="hidden" asp-for="Tests[t].Samples[s].SampleId" />

            if (sample.Values.Count == 0 || test.ResultItems.Count == 0)
            {
                continue;
            }

            <div class="app-table-scroll govuk-!-margin-bottom-6">
                <table class="govuk-table app-results-entry-table">
                    <caption class="govuk-table__caption govuk-visually-hidden">Sample @sample.SampleNumber results for @test.TestName</caption>
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">Sample @sample.SampleNumber</th>
                            <th scope="col" class="govuk-table__header">Value</th>
                            <th scope="col" class="govuk-table__header">Required format</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @for (var r = 0; r < test.ResultItems.Count; r++)
                        {
                            var resultItem = test.ResultItems[r];
                            var valueIndex = test.ValueIndexFor(s, resultItem.TestResultItemId);
                            if (valueIndex == -1)
                            {
                                continue;
                            }

                            var entryField = ResultEntryField.For(ViewData.ModelState, $"Tests[{t}].Samples[{s}].Values[{valueIndex}].Result");

                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">@resultItem.Name</th>
                                <td class="govuk-table__cell">
                                    <input type="hidden" asp-for="Tests[t].Samples[s].Values[valueIndex].SampleResultItemId" />
                                    <input type="hidden" asp-for="Tests[t].Samples[s].Values[valueIndex].TestResultItemId" />
                                    <div class="@entryField.GroupClass">
                                        <label class="govuk-label govuk-visually-hidden" asp-for="Tests[t].Samples[s].Values[valueIndex].Result">@resultItem.Name, sample @sample.SampleNumber</label>
                                        @if (entryField.Invalid)
                                        {
                                            <p id="@entryField.ErrorId" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @entryField.Message</p>
                                        }
                                        @if (Model.IsReadOnly)
                                        {
                                            <p class="govuk-body">@Model.Tests[t].Samples[s].Values[valueIndex].Result</p>
                                        }
                                        else if (resultItem.IsDropdown)
                                        {
                                            <select class="@entryField.SelectClass" aria-describedby="@entryField.DescribedBy" asp-for="Tests[t].Samples[s].Values[valueIndex].Result">
                                                <option value="">- Please Select -</option>
                                                @foreach (var option in resultItem.DropdownOptions)
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input class="@entryField.InputClass" aria-describedby="@entryField.DescribedBy" maxlength="8000" asp-for="Tests[t].Samples[s].Values[valueIndex].Result" />
                                        }
                                    </div>
                                </td>
                                <td class="govuk-table__cell">@resultItem.RequiredFormatHint</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (test.MethodItems.Count == 0)
        {
            <p class="govuk-body">This test has no method items.</p>
        }
        else
        {
            <div class="app-table-scroll govuk-!-margin-bottom-6">
                <table class="govuk-table app-results-entry-table">
                    <caption class="govuk-table__caption govuk-visually-hidden">Method items for @test.TestName</caption>
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">Method item</th>
                            <th scope="col" class="govuk-table__header">Value</th>
                            <th scope="col" class="govuk-table__header">Required format</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @for (var m = 0; m < test.MethodItems.Count; m++)
                        {
                            var methodItem = test.MethodItems[m];
                            var entryField = ResultEntryField.For(ViewData.ModelState, $"Tests[{t}].MethodItems[{m}].Result");
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">@methodItem.Name</th>
                                <td class="govuk-table__cell">
                                    <input type="hidden" asp-for="Tests[t].MethodItems[m].TestMethodItemId" />
                                    <div class="@entryField.GroupClass">
                                        <label class="govuk-label govuk-visually-hidden" asp-for="Tests[t].MethodItems[m].Result">@methodItem.Name</label>
                                        @if (entryField.Invalid)
                                        {
                                            <p id="@entryField.ErrorId" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @entryField.Message</p>
                                        }
                                        @if (Model.IsReadOnly)
                                        {
                                            <p class="govuk-body">@Model.Tests[t].MethodItems[m].Result</p>
                                        }
                                        else if (methodItem.IsDropdown)
                                        {
                                            <select class="@entryField.SelectClass" aria-describedby="@entryField.DescribedBy" asp-for="Tests[t].MethodItems[m].Result">
                                                <option value="">- Please Select -</option>
                                                @foreach (var option in methodItem.DropdownOptions)
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input class="@entryField.InputClass" aria-describedby="@entryField.DescribedBy" maxlength="8000" asp-for="Tests[t].MethodItems[m].Result" />
                                        }
                                    </div>
                                </td>
                                <td class="govuk-table__cell">@methodItem.RequiredFormatHint</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />
    }

    <div class="govuk-button-group">
        @if (Model.IsReadOnly)
        {
            <a class="govuk-button govuk-button--secondary" data-module="govuk-button" asp-action="Current">Back</a>
        }
        else
        {
            <button type="submit" name="command" value="submit" class="govuk-button" data-module="govuk-button">Submit</button>
            <button type="submit" name="command" value="save" class="govuk-button govuk-button--secondary" data-module="govuk-button">Save</button>
            <button type="submit" name="command" value="cancel" class="govuk-button govuk-button--secondary" data-module="govuk-button" formnovalidate>Cancel</button>
            <a class="govuk-button govuk-button--secondary" data-module="govuk-button" asp-action="NilReturn" asp-route-schemeId="@Model.MonthlyDistributionSchemeId">@(Model.HasNilReturn ? "View nil return" : "Nil return")</a>
        }
    </div>
</form>
