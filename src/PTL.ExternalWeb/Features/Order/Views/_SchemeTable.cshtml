@using PTL.Contracts.CreateOrder
@model (string Caption, IReadOnlyList<CreateOrderSchemeResponse> Schemes, PTL.ExternalWeb.Features.Order.CreateOrderViewModel Page)
@{
    var orderPage = Model.Page;
}

<section class="app-table-scroll" aria-label="@Model.Caption">
<table class="govuk-table app-order-table">
    <caption class="govuk-table__caption govuk-table__caption--s">@Model.Caption</caption>
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Select</th>
            <th scope="col" class="govuk-table__header">Scheme code</th>
            <th scope="col" class="govuk-table__header">Scheme name</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Annual price</th>
            <th scope="col" class="govuk-table__header">Import permit required</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Postage</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Scheme price</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Total</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var scheme in Model.Schemes)
        {
            <tr class="govuk-table__row @(scheme.Selected ? "app-order-row--selected" : null)">
                <td class="govuk-table__cell">
                    <div class="govuk-checkboxes govuk-checkboxes--small">
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" id="select-@scheme.SchemeId" type="checkbox"
                                   data-order-field="select" data-scheme-id="@scheme.SchemeId" checked="@scheme.Selected" />
                            <label class="govuk-label govuk-checkboxes__label" for="select-@scheme.SchemeId">
                                <span class="govuk-visually-hidden">Select @scheme.Name</span>
                            </label>
                        </div>
                    </div>
                </td>
                <td class="govuk-table__cell">@scheme.Identifier</td>
                <td class="govuk-table__cell">@scheme.Name</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">@orderPage.FormatMoney(scheme.AnnualPrice)</td>
                <td class="govuk-table__cell">
                    @if (scheme.Selected)
                    {
                        <div class="govuk-checkboxes govuk-checkboxes--small">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" id="import-@scheme.SchemeId" type="checkbox"
                                       data-order-field="importexport" data-scheme-id="@scheme.SchemeId"
                                       checked="@scheme.ImportPermitRequired" disabled="@(!scheme.ImportPermitEnabled)" />
                                <label class="govuk-label govuk-checkboxes__label" for="import-@scheme.SchemeId">
                                    <span class="govuk-visually-hidden">Import permit required for @scheme.Name</span>
                                </label>
                            </div>
                        </div>
                    }
                </td>
                <td class="govuk-table__cell govuk-table__cell--numeric">@(scheme.Selected ? orderPage.FormatMoney(scheme.PostagePrice) : null)</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">@(scheme.Selected ? orderPage.FormatMoney(scheme.SchemePrice) : null)</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">@(scheme.Selected ? orderPage.FormatMoney(scheme.TotalPrice) : null)</td>
            </tr>
            if (scheme.Selected)
            {
                <tr class="govuk-table__row app-order-row--selected">
                    <td class="govuk-table__cell" colspan="8">
                        <fieldset class="govuk-fieldset">
                            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Distribution months for @scheme.Name</legend>
                            <div class="app-month-strip">
                                @foreach (var month in scheme.Months)
                                {
                                    if (!month.Offered)
                                    {
                                        <span class="app-month app-month--unavailable"><span class="govuk-visually-hidden">Not offered: </span>@month.Label</span>
                                    }
                                    else
                                    {
                                        <div class="govuk-checkboxes govuk-checkboxes--small app-month">
                                            <div class="govuk-checkboxes__item">
                                                <input class="govuk-checkboxes__input" id="month-@scheme.SchemeId-@month.MonthNumber" type="checkbox"
                                                       data-order-field="@month.Label.ToLowerInvariant()" data-scheme-id="@scheme.SchemeId"
                                                       checked="@month.Selected" disabled="@(!month.Enabled)" />
                                                <label class="govuk-label govuk-checkboxes__label" for="month-@scheme.SchemeId-@month.MonthNumber">
                                                    @month.Label
                                                    @if (month.AlreadyParticipating)
                                                    {
                                                        <span class="govuk-visually-hidden"> (you are already participating in this month)</span>
                                                    }
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </fieldset>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</section>
