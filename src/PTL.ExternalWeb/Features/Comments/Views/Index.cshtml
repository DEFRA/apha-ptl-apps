@model PTL.ExternalWeb.Features.Comments.CommentsListViewModel
@{
    ViewData["Title"] = "Enter comments";

    string SortUrl(string column)
    {
        var dir = Model.SortBy == column && Model.SortDirection == "asc" ? "desc" : "asc";
        return Url.Action("Index", new
        {
            distributionReference = Model.DistributionReference,
            schemeCode = Model.SchemeCode,
            schemeName = Model.SchemeName,
            sortBy = column,
            sortDir = dir
        })!;
    }

    var sortHeaders = new PTL.ExternalWeb.ViewSupport.SortableHeaderContext(Model.SortBy, Model.SortDirection, SortUrl);
}

<h1 class="govuk-heading-l">Distributions</h1>

<p class="govuk-body">The table below shows all of the distributions of schemes for which you are a test consultant. Enter the distribution reference or scheme name to search for a particular distribution.</p>

<form method="get" asp-action="Index" class="govuk-!-margin-bottom-6">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group">
                <label class="govuk-label" for="distributionReference">Distribution reference</label>
                <input class="govuk-input" id="distributionReference" name="distributionReference" value="@Model.DistributionReference" />
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="schemeName">Scheme name</label>
                <input class="govuk-input" id="schemeName" name="schemeName" value="@Model.SchemeName" />
            </div>

            <div class="govuk-form-group">
                <label class="govuk-label" for="schemeCode">Scheme code</label>
                <input class="govuk-input" id="schemeCode" name="schemeCode" value="@Model.SchemeCode" />
            </div>
        </div>
    </div>

    <partial name="_SearchFormButtonGroup" model="@(nameof(PTL.ExternalWeb.Features.Comments.CommentsController.Index))" />
</form>

@if (Model.Distributions.Count == 0)
{
    <p class="govuk-body">@(Model.IsFiltered ? "No distributions found for the selected search criteria." : "There are no distributions to display.")</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <partial name="_DistributionReferenceSchemeHeaders" model="sortHeaders" />
                <partial name="_SortableHeader" model="@(sortHeaders.Header("Results Issue Target Date", "targetDate"))" />
                <partial name="_SortableHeader" model="@(sortHeaders.Header("Comments Provided By", "commentsProvidedBy"))" />
                <partial name="_SortableHeader" model="@(sortHeaders.Header("Submitted", "submitted"))" />
                <th scope="col" class="govuk-table__header">View</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var distribution in Model.Distributions)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@distribution.DistributionReference</td>
                    <td class="govuk-table__cell">@distribution.SchemeCode</td>
                    <td class="govuk-table__cell">@distribution.SchemeName</td>
                    <td class="govuk-table__cell">@distribution.TargetDate.ToString("dddd d MMMM yyyy")</td>
                    <td class="govuk-table__cell">@distribution.CommentsProvidedBy</td>
                    <td class="govuk-table__cell">@(distribution.IsSubmitted ? "Yes" : "No")</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link"
                           asp-action="Entry"
                           asp-route-schemeId="@distribution.MonthlyDistributionSchemeId"
                           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
