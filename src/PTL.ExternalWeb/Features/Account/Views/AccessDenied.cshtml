@{
    ViewData["Title"] = "Access denied";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">You do not have permission to view this page</h1>
        <p class="govuk-body">Your account does not have the role needed to access this page.</p>
        @await Component.InvokeAsync("SupportContact", new { leadIn = "To get access, contact the Animal and Plant Health Agency" })
        <p class="govuk-body"><a class="govuk-link" asp-controller="Home" asp-action="Index">Go back to the home page</a>.</p>
    </div>
</div>
