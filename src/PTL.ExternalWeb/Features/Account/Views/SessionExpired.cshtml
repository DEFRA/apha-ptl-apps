@{
    ViewData["Title"] = "Session expired";
}

<h1 class="govuk-heading-l">Session expired</h1>

<p class="govuk-body">Your session has expired because you were inactive for too long.</p>

@* Back to sign-in, which challenges CIDM; an active CIDM session signs the user straight back in. *@
<a class="govuk-button" data-module="govuk-button" asp-controller="Account" asp-action="Login">Sign in again</a>
