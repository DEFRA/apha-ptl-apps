@using PTL.ExternalWeb.Features.Account
@model string?
@{
    ViewData["Title"] = "You cannot sign in with this account";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">You cannot sign in with this account</h1>
        @if (Model == NotPermittedReasons.Inactive)
        {
            <p class="govuk-body">Your account is not currently active. Contact APHA if you believe this is incorrect.</p>
        }
        else if (Model == NotPermittedReasons.NoActiveLab)
        {
            <p class="govuk-body">You are not linked to any lab at the moment, so there is nothing for you to see yet.</p>
            <p class="govuk-body">This usually means the lab you work with has not been switched on for you. Please ask the person who looks after your lab's account to check, or contact APHA, and we will sort it out.</p>
        }
        else
        {
            <p class="govuk-body">This account is not set up to access the Proficiency Testing external service.</p>
        }
        @* PTL's Logout action is POST-only with antiforgery protection (unlike CDC's GET-based
           equivalent), so this uses a form+button rather than a plain anchor link. *@
        @* Sign out is the only action on this page, so it is the primary button (GDS: secondary
           styling is for a de-emphasised action alongside a primary one, not a sole action). *@
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Sign out
            </button>
        </form>
    </div>
</div>
