@model ErrorViewModel
@{
    ViewData["Title"] = "Sorry, there is a problem with the service";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Sorry, there is a problem with the service</h1>
        <p class="govuk-body">Try again later.</p>
        <p class="govuk-body">If the problem continues, contact a System Administrator.</p>
        @if (Model.ShowRequestId)
        {
            <p class="govuk-body-s">If you contact us, quote this reference: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
