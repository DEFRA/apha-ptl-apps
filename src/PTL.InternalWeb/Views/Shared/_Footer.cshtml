@model string
@{
    var helpUrl = string.IsNullOrEmpty(Model) ? "#" : Model;
}
<partial name="_GovUkFooter" model="@(new (string Text, string Href, string? AriaLabel)[]
{
    ("Help (PDF)", helpUrl, null),
    ("Cookies", Url.Action("Cookies", "Home")!, null),
    ("Accessibility statement", Url.Action("Accessibility", "Home")!, null),
    ("Privacy", Url.Action("Privacy", "Home")!, null),
    ("Terms and conditions (PDF)", "/docs/TermsAndConditions.pdf", null),
})" />
