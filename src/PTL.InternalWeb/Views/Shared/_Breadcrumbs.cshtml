@using System.Text.RegularExpressions
@using PTL.InternalWeb.Navigation
@{
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).Trim();
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).Trim();

    // Ancestor links such as Contracts and Contract Items are parameterised routes. Take the id
    // from the current request where present, otherwise from whatever the page published (see
    // BreadcrumbRouteValues) - /Contract/Details/{id} knows the contract but carries no customerId.
    var ambient = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase)
    {
        [BreadcrumbRouteValues.CustomerIdKey] =
            ViewContext.HttpContext.Request.Query[BreadcrumbRouteValues.CustomerIdKey].FirstOrDefault()
            ?? ViewContext.RouteData.Values[BreadcrumbRouteValues.CustomerIdKey]?.ToString()
            ?? ViewData[BreadcrumbRouteValues.CustomerId]?.ToString(),
        [BreadcrumbRouteValues.ContractIdKey] =
            ViewContext.HttpContext.Request.Query[BreadcrumbRouteValues.ContractIdKey].FirstOrDefault()
            ?? ViewContext.RouteData.Values[BreadcrumbRouteValues.ContractIdKey]?.ToString()
            ?? ViewData[BreadcrumbRouteValues.ContractId]?.ToString()
    };

    static string ToDisplay(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return Regex.Replace(value, "([a-z])([A-Z])", "$1 $2", RegexOptions.None, TimeSpan.FromMilliseconds(100));
    }

    // Only the Home landing page suppresses the trail - it is already the first crumb. Other Home
    // actions (Privacy) still resolve their own node below.
    var isHome = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);

    // Mirrors the current page's node in the left nav (_SideNavigation.cshtml) - the breadcrumb
    // trail is the exact reverse of the drill-down journey: Home > ... > current page. Falls back
    // to a plain controller/action crumb for any page not represented in the nav tree.
    var path = isHome ? null : SideNavigationProvider.FindActivePath(SideNavigationProvider.Build(), controller, action);
}

<nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item">
            <a class="govuk-breadcrumbs__link" asp-controller="Home" asp-action="Index">Home</a>
        </li>

        @if (path is not null)
        {
            for (var i = 0; i < path.Count; i++)
            {
                var node = path[i];
                var isLast = i == path.Count - 1;

                var routeData = new Dictionary<string, string>();
                if (node.LinkRouteParameter is not null
                    && node.LinkRouteValueKey is not null
                    && ambient.TryGetValue(node.LinkRouteValueKey, out var routeValue)
                    && !string.IsNullOrEmpty(routeValue))
                {
                    routeData[node.LinkRouteParameter] = routeValue;
                }

                // A node needing a route parameter we could not resolve would link to an empty or
                // erroring page, so it renders as plain text instead.
                var isUnresolvedLink = node.LinkRouteParameter is not null && routeData.Count == 0;

                <li class="govuk-breadcrumbs__list-item">
                    @if (isLast || isUnresolvedLink)
                    {
                        @node.Text
                    }
                    else
                    {
                        <a class="govuk-breadcrumbs__link" asp-controller="@node.ControllerName" asp-action="@node.ActionName" asp-all-route-data="routeData">@node.Text</a>
                    }
                </li>
            }
        }
        else if (!isHome)
        {
            <li class="govuk-breadcrumbs__list-item">@ToDisplay(controller)@(string.IsNullOrWhiteSpace(action) || string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase) ? "" : $" - {ToDisplay(action)}")</li>
        }
    </ol>

</nav>
