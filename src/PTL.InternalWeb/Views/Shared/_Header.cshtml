@using PTL.InternalWeb.Features.Account
@model (string ServiceName, string? LogoStyle)
<header class="govuk-template__header">
    <div class="govuk-header">
        <div class="govuk-header__container govuk-width-container">
            <div class="govuk-header__content">
                @* govuk-header__content/__link/__service-name have no rules in govuk-frontend
                   6.5.0 (stale pre-v5 class names) - govuk-header__product-name is the only real
                   class this bundle ships for prominent header text (font-size: 1.9375rem). *@
                <span class="govuk-header__product-name">@Model.ServiceName</span>
            </div>
        </div>
    </div>
    <section aria-label="Service information" class="govuk-service-navigation" data-module="govuk-service-navigation">
        <div class="govuk-width-container govuk-service-navigation__container">
            <span class="govuk-service-navigation__service-name">
                @* govuk-link-image gives an image-only link a clean focus outline instead of the
                   text link's solid yellow background, which only showed through the logo's
                   transparent gaps. *@
                <a asp-controller="Home" asp-action="Index" class="govuk-service-navigation__link govuk-link-image" aria-label="Home">
                    <img src="~/assets/images/AphaLogo.png" alt="APHA" style="@Model.LogoStyle" />
                </a>
            </span>
            @if (User.Identity is not null && User.Identity.IsAuthenticated)
            {
                <nav aria-label="Account navigation" class="govuk-service-navigation__wrapper">
                    <ul class="govuk-service-navigation__list">
                        <li class="govuk-service-navigation__item">
                            @* InternalUserResolver never sets ClaimTypes.Name - FullName (tblUsers.fldFriendlyName) is the real display name. *@
                            Signed in as <strong>@(User.FindFirst(InternalUserClaimTypes.FullName)?.Value ?? User.Identity.Name)</strong>
                        </li>
                        <li class="govuk-service-navigation__item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="app-signout-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="app-signout-button govuk-service-navigation__link">Sign out</button>
                            </form>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </section>
</header>
