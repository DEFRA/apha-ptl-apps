@using PTL.Common.Auth
@using PTL.InternalWeb.Features.Account
@model (string ServiceName, string? LogoStyle)
<govuk-page-header service-name="@Model.ServiceName" logo-style="@Model.LogoStyle">
    @if (User.Identity is not null && User.Identity.IsAuthenticated)
    {
        // Entra id_token claims first; the tblUsers name resolved at sign-in is a last resort.
        var displayName = User.GetDisplayName(lastResortClaimType: InternalUserClaimTypes.FullName);
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            // govuk-service-navigation__wrapper is right-aligned via site.css (margin-left: auto)
            // - matches ExternalWeb's header layout.
            <nav aria-label="Account navigation" class="govuk-service-navigation__wrapper">
                <ul class="govuk-service-navigation__list">
                    <li class="govuk-service-navigation__item">
                        Signed in as: <strong>@displayName</strong>
                    </li>
                </ul>
            </nav>
        }
    }
</govuk-page-header>
