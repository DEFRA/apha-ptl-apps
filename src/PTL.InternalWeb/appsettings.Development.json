{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "BaseUrl": "http://localhost:5252"
  },
  "HealthCheck": {
    "ReadinessKey": "local-dev-readiness-key"
  },
  "EntraId": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    // Not a real secret - an all-zero TenantId/ClientId can never authenticate against a real
    // Entra ID tenant. Only present so local `dotnet run`/`dotnet test` starts without extra
    // setup. Replace all three (and set EntraId__ClientSecret as an environment variable, not
    // here) with a real dev App Registration to actually exercise SSO locally.
    "ClientSecret": "local-dev-placeholder-not-a-real-secret"
  },
  "Redis": {
    // Left blank for local development - a single local instance doesn't need a shared key ring.
    "ConnectionString": ""
  }
}
