{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EntraId": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": ""
    // ClientSecret is intentionally omitted here - inject it via an environment variable
    // (EntraId__ClientSecret) sourced from AWS Secrets Manager in the ECS task definition.
  },
  "Redis": {
    // ElastiCache Redis primary endpoint, e.g. "ptl-cache.xxxxxx.ng.0001.euw2.cache.amazonaws.com:6379".
    // Required outside Development - see DistributedDataProtectionExtensions.
    "ConnectionString": ""
  }
}
