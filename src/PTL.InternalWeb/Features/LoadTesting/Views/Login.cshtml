@using PTL.InternalWeb.Features.LoadTesting
@model LoadTestingLoginViewModel
@{
    ViewData["Title"] = "Load testing sign in";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Load testing sign in</h1>
        <p class="govuk-body">Performance environment only. Enter the username of a user that exists in PTL, for example DEFRA\jsmith.</p>
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p class="govuk-error-message" id="username-error"><span class="govuk-visually-hidden">Error:</span> @Model.Error</p>
        }
        <form method="post" action="/perf/login">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div class="govuk-form-group">
                <label class="govuk-label" for="username">Username</label>
                <input class="govuk-input" id="username" name="username" type="text" value="@Model.Username" autocomplete="off" spellcheck="false" />
            </div>
            <button type="submit" class="govuk-button" data-module="govuk-button">Sign in</button>
        </form>
    </div>
</div>
