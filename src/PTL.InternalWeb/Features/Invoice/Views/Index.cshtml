@model PTL.InternalWeb.Features.Invoice.InvoiceGenerationViewModel
@using PTL.InternalWeb.Features.Invoice
@{
    ViewData["Title"] = "Invoice Generation";
}

<h1 class="govuk-heading-l">Invoice Generation</h1>

<p class="govuk-body">
    The invoices for year @Model.FinancialYear will be sent from 'noreplyvetqas@notifications.service.gov.uk' to 'appsupport.ptl@notifications.service.gov.uk'.
</p>

<form method="post" asp-action="Generate">
    @Html.AntiForgeryToken()
    @if (Model.CanGenerate)
    {
        <button class="govuk-button" data-module="govuk-button" type="submit"
                onclick="return confirm('@InvoiceGenerationViewModel.GenerateConfirmation');">
            Generate Invoices
        </button>
    }
    else
    {
        <button class="govuk-button" data-module="govuk-button" type="submit" disabled="disabled" aria-disabled="true">
            Generate Invoices
        </button>
        <p class="govuk-body govuk-hint">There are no outstanding invoices to generate. Use Reset All Invoices to make them available again.</p>
    }
</form>

@if (Model.CanReset)
{
    <form method="post" asp-action="Reset">
        @Html.AntiForgeryToken()
        <button class="govuk-button govuk-button--warning" data-module="govuk-button" type="submit">
            Reset All Invoices
        </button>
    </form>
}
