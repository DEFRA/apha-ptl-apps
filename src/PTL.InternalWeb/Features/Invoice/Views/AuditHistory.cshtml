@model IReadOnlyList<PTL.Contracts.Invoice.InvoiceAuditRecordResponse>
@{
    ViewData["Title"] = "Invoice Audit History";
    var last = Model.Count > 0 ? Model[0] : null;
}

<h1 class="govuk-heading-l">Invoice Audit History</h1>

<dl class="govuk-summary-list">
    <govuk-summary-row label="Last Generation">@(last is not null ? last.AuditDate.ToString("dd/MM/yyyy HH:mm") : "Never generated")</govuk-summary-row>
    <govuk-summary-row label="Generated By">@(last?.AuditWho ?? "-")</govuk-summary-row>
    <govuk-summary-row label="Generated On">@(last is not null ? last.AuditDate.ToString("dd/MM/yyyy HH:mm") : "-")</govuk-summary-row>
    <govuk-summary-row label="Status">@(last is not null ? "Completed" : "-")</govuk-summary-row>
</dl>

@if (Model.Count == 0)
{
    <p class="govuk-body">No invoice generation runs have been recorded yet.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Generated By</th>
                <th scope="col" class="govuk-table__header">Generated On</th>
                <th scope="col" class="govuk-table__header">Status</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var record in Model)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@record.AuditWho</td>
                    <td class="govuk-table__cell">@record.AuditDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="govuk-table__cell">Completed</td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="govuk-body"><a class="govuk-link" asp-action="Index">Back to Invoice Generation</a></p>
