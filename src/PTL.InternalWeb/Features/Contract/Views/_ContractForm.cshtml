@model PTL.InternalWeb.Features.Contract.ContractFormViewModel
@{
    // Hand-rolled to match the GOV.UK Design System error summary exactly - see
    // PTL.InternalWeb/Features/Customer/Views/_CustomerForm.cshtml for the reference pattern this follows.
    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .ToList();

    bool HasError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0;
    string? FirstError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    string FormGroupClass(string field) => HasError(field) ? "govuk-form-group govuk-form-group--error" : "govuk-form-group";
    string InputClass(string baseClass, string field) => HasError(field) ? $"{baseClass} {baseClass}--error" : baseClass;
    string? DescribedBy(string field) => HasError(field) ? $"{field}-error" : null;
}

<govuk-error-summary errors="@errors" />

<input type="hidden" asp-for="CustomerId" />

@if (Model.ContractId is not null)
{
    <input type="hidden" asp-for="ContractId" />
    <div class="govuk-form-group">
        <p class="govuk-label govuk-label--s">Customer</p>
        <p class="govuk-body">@Model.CustomerName (@Model.QalNumber)</p>
    </div>
}

<h2 class="govuk-heading-m">Contract details</h2>

<govuk-select asp-for="YearId" label="Year" asp-items="Model.YearOptions" />

<govuk-input asp-for="UTNumber" label="UT number" hint="Enter either a UT number or an FT number, but not both." />

<govuk-input asp-for="FTNumber" label="FT number" />

<govuk-input asp-for="ContractSignatory" label="Contract signatory" />

<govuk-input asp-for="Suffix" label="Suffix" input-class="govuk-input govuk-input--width-2" />

<div class="govuk-form-group">
    <div class="govuk-checkboxes__item">
        <input class="govuk-checkboxes__input" asp-for="IsActive" />
        <label class="govuk-label govuk-checkboxes__label" asp-for="IsActive">Active</label>
    </div>
</div>

<h2 class="govuk-heading-m">Pricing</h2>

<govuk-input asp-for="DiscountRate" label="Discount rate" input-class="govuk-input govuk-input--width-5" />

<govuk-input asp-for="AdministrationCharge" label="Administration charge" input-class="govuk-input govuk-input--width-5" />

<govuk-input asp-for="NumberCourier" label="Number of courier deliveries" input-class="govuk-input govuk-input--width-5" />

<govuk-input asp-for="CourierPrice" label="Courier price" input-class="govuk-input govuk-input--width-5" />

<govuk-input asp-for="NumberPostage" label="Number of postage deliveries" input-class="govuk-input govuk-input--width-5" />

<govuk-input asp-for="PostagePrice" label="Postage price" input-class="govuk-input govuk-input--width-5" />

<govuk-input asp-for="NumberSpecialDelivery" label="Number of special deliveries" input-class="govuk-input govuk-input--width-5" />

<govuk-input asp-for="SpecialDeliveryPrice" label="Special delivery price" input-class="govuk-input govuk-input--width-5" />

<h2 class="govuk-heading-m">Dates</h2>

<govuk-input asp-for="AcknowledgementPostedDate" label="Acknowledgement posted date" input-class="govuk-input govuk-input--width-10" type="date" />

<govuk-input asp-for="AcknowledgementReturnedDate" label="Acknowledgement returned date" input-class="govuk-input govuk-input--width-10" type="date" />

<govuk-input asp-for="JobSheetPostedDate" label="Job sheet posted date" input-class="govuk-input govuk-input--width-10" type="date" />

<govuk-input asp-for="DateOfLeaving" label="Date of leaving" input-class="govuk-input govuk-input--width-10" type="date" />

<govuk-input asp-for="ReasonForClosure" label="Reason for closure" />

<div class="@FormGroupClass("RenewalInformation")">
    <label class="govuk-label" asp-for="RenewalInformation">Renewal information</label>
    @if (HasError("RenewalInformation"))
    {
        <p id="RenewalInformation-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("RenewalInformation")</p>
    }
    <textarea class="@InputClass("govuk-textarea", "RenewalInformation")" asp-for="RenewalInformation" aria-describedby="@DescribedBy("RenewalInformation")"></textarea>
</div>

<div class="@FormGroupClass("ActionsRequired")">
    <label class="govuk-label" asp-for="ActionsRequired">Actions required</label>
    @if (HasError("ActionsRequired"))
    {
        <p id="ActionsRequired-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("ActionsRequired")</p>
    }
    <textarea class="@InputClass("govuk-textarea", "ActionsRequired")" asp-for="ActionsRequired" aria-describedby="@DescribedBy("ActionsRequired")"></textarea>
</div>

<h2 class="govuk-heading-m">Invoicing</h2>

<govuk-input asp-for="PurchaseOrderNumber" label="Purchase order number" />

<div class="govuk-form-group">
    <div class="govuk-checkboxes__item">
        <input class="govuk-checkboxes__input" asp-for="OptOutOfInvoiceGeneration" />
        <label class="govuk-label govuk-checkboxes__label" asp-for="OptOutOfInvoiceGeneration">Opt out of invoice generation</label>
    </div>
</div>

<div class="govuk-form-group">
    <div class="govuk-checkboxes__item">
        <input class="govuk-checkboxes__input" asp-for="IsOnlineOrder" />
        <label class="govuk-label govuk-checkboxes__label" asp-for="IsOnlineOrder">Online order</label>
    </div>
</div>
