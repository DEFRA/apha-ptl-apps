@model PTL.InternalWeb.Features.Contract.ContractListViewModel
@using PTL.Contracts.Contract
@using PTL.InternalWeb.Pagination
@{
    ViewData["Title"] = "Contracts";
    var historicalSelected = Model.Search.Period == ContractPeriodFilter.Historical ? "selected" : null;
    var currentSelected = Model.Search.Period == ContractPeriodFilter.CurrentAndNext ? "selected" : null;
    var allSelected = Model.Search.Period == ContractPeriodFilter.All ? "selected" : null;
    string YearText(int yearId) => Model.YearNames.GetValueOrDefault(yearId, yearId.ToString());
    var pagination = new PaginationModel
    {
        CurrentPage = Model.Search.Page,
        PageSize = Model.Search.PageSize,
        TotalRecords = Model.TotalCount,
        RouteValues = new Dictionary<string, object?> { ["customerId"] = Model.Search.CustomerId, ["period"] = Model.Search.Period }
    };
}

<h1 class="govuk-heading-l">Contracts</h1>

@if (Model.Customer is not null)
{
    <p class="govuk-body">@Model.Customer.QalNumber, @Model.Customer.Name, @Model.Customer.Organisation</p>
}

<form method="get" asp-action="Index" class="govuk-!-margin-bottom-6">
    <input type="hidden" name="customerId" value="@Model.Search.CustomerId" />
    <div class="govuk-form-group">
        <label class="govuk-label" for="period">Period</label>
        <select class="govuk-select" id="period" name="period">
            <option value="@ContractPeriodFilter.Historical" selected="@historicalSelected">Historical</option>
            <option value="@ContractPeriodFilter.CurrentAndNext" selected="@currentSelected">Current / next year</option>
            <option value="@ContractPeriodFilter.All" selected="@allSelected">All</option>
        </select>
    </div>
    <button class="govuk-button" data-module="govuk-button" type="submit">Search</button>
</form>

@if (Model.Contracts.Count == 0)
{
    <p class="govuk-body">There are no contracts to display.</p>
}
else
{
    <govuk-page-size-selector model="pagination" />

    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Year</th>
                <th scope="col" class="govuk-table__header">Suffix</th>
                <th scope="col" class="govuk-table__header">Details</th>
                <th scope="col" class="govuk-table__header">Contract Items</th>
                <th scope="col" class="govuk-table__header">Export</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var contract in Model.Contracts)
            {
                <tr class="govuk-table__row @(contract.IsActive ? "" : "ptl-inactive-row")">
                    <td class="govuk-table__cell">@YearText(contract.YearId)</td>
                    <td class="govuk-table__cell">@contract.Suffix</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-action="Details" asp-route-id="@contract.ContractId">Details</a>
                    </td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-action="ContractItems" asp-route-id="@contract.ContractId">Contract Items</a>
                    </td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-action="Export" asp-route-id="@contract.ContractId" asp-route-documentType="Contract">Contract</a><br />
                        <a class="govuk-link" asp-action="Export" asp-route-id="@contract.ContractId" asp-route-documentType="Address Confirmation">Address Confirmation</a><br />
                        <a class="govuk-link" asp-action="Export" asp-route-id="@contract.ContractId" asp-route-documentType="Job Sheet">Job Sheet</a><br />
                        <a class="govuk-link" asp-action="Export" asp-route-id="@contract.ContractId" asp-route-documentType="Renewal Letter">Renewal Letter</a><br />
                        <a class="govuk-link" asp-action="Export" asp-route-id="@contract.ContractId" asp-route-documentType="Import Permit(s)">Import Permit(s)</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <govuk-pagination model="pagination" />
}
