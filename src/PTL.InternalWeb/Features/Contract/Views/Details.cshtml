@model PTL.Contracts.Contract.ContractResponse
@{
    ViewData["Title"] = $"Contract - {Model.YearId} {Model.Suffix}";
    var isUt = string.IsNullOrEmpty(Model.FTNumber);
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@Model.QalNumber, @Model.YearId@(string.IsNullOrEmpty(Model.Suffix) ? "" : $" ({Model.Suffix})")</h1>
    </div>
    <div class="govuk-grid-column-one-third govuk-!-text-align-right">
        @if (Model.IsReadOnly)
        {
            <strong class="govuk-tag govuk-tag--grey">Read only (closed year)</strong>
        }
        else
        {
            <a class="govuk-button" data-module="govuk-button" asp-action="Edit" asp-route-id="@Model.ContractId">Edit contract</a>
        }
    </div>
</div>

<h2 class="govuk-heading-m">Contract details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Customer">@Model.CustomerName (@Model.QalNumber)</govuk-summary-row>
    <govuk-summary-row label="Contract type">@(isUt ? "UT" : "FT")</govuk-summary-row>
    @if (isUt)
    {
        <govuk-summary-row label="UT number">@Model.UTNumber</govuk-summary-row>
    }
    else
    {
        <govuk-summary-row label="FT number">@Model.FTNumber</govuk-summary-row>
    }
    <govuk-summary-row label="Commencement date">@(Model.CommencementDate?.ToString("d MMMM yyyy") ?? "Not set")</govuk-summary-row>
    <govuk-summary-row label="Suffix">@Model.Suffix</govuk-summary-row>
    <govuk-summary-row label="Year">@Model.YearId</govuk-summary-row>
    <govuk-summary-row label="Contract signatory">@Model.ContractSignatory</govuk-summary-row>
    <govuk-summary-row label="Discount rate">@Model.DiscountRate.ToString("P2")</govuk-summary-row>
    <govuk-summary-row label="Administration charge">@Model.AdministrationCharge.ToString("N2")</govuk-summary-row>
    <govuk-summary-row label="Purchase order number">@Model.PurchaseOrderNumber</govuk-summary-row>
    <govuk-summary-row label="Online order">@(Model.IsOnlineOrder ? "Yes" : "No")</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Postage and packaging</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Number of courier items">@Model.NumberCourier</govuk-summary-row>
    <govuk-summary-row label="Courier price per item">@Model.CourierPrice.ToString("N2")</govuk-summary-row>
    <govuk-summary-row label="Number of postage items">@Model.NumberPostage</govuk-summary-row>
    <govuk-summary-row label="Postage price per item">@Model.PostagePrice.ToString("N2")</govuk-summary-row>
    <govuk-summary-row label="Number of special delivery items">@Model.NumberSpecialDelivery</govuk-summary-row>
    <govuk-summary-row label="Special delivery price per item">@Model.SpecialDeliveryPrice.ToString("N2")</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Contract setup</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Acknowledgement posted date">@(Model.AcknowledgementPostedDate?.ToString("d MMMM yyyy") ?? "Not set")</govuk-summary-row>
    <govuk-summary-row label="Acknowledgement returned date">@(Model.AcknowledgementReturnedDate?.ToString("d MMMM yyyy") ?? "Not set")</govuk-summary-row>
    <govuk-summary-row label="Job sheet sent date">@(Model.JobSheetPostedDate?.ToString("d MMMM yyyy") ?? "Not set")</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Contract status</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Status">
        <strong class="govuk-tag @(Model.IsActive ? "govuk-tag--green" : "govuk-tag--grey")">
            @(Model.IsActive ? "Active" : "Inactive")
        </strong>
    </govuk-summary-row>
    <govuk-summary-row label="Cancellation date">@(Model.DateOfLeaving?.ToString("d MMMM yyyy") ?? "Not set")</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Invoice generation</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Opt out of invoice generation">@(Model.OptOutOfInvoiceGeneration ? "Yes" : "No")</govuk-summary-row>
    <govuk-summary-row label="Has been invoiced">@(Model.IsInvoiceSent == true ? "Yes" : "No")</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Others</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Actions required">@Model.ActionsRequired</govuk-summary-row>
    <govuk-summary-row label="Renewal information">@Model.RenewalInformation</govuk-summary-row>
    <govuk-summary-row label="Cancellation reason">@Model.ReasonForClosure</govuk-summary-row>
</dl>
