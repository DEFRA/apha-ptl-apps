@model PTL.InternalWeb.Features.Contract.PendingOrderDetailsViewModel
@using PTL.InternalWeb.Features.Contract
@{
    var order = Model.Order;
    var form = Model.Form ?? new PendingOrderDecisionForm { PurchaseOrderNumber = order.PurchaseOrderNumber };
    ViewData["Title"] = $"{(ViewData.ModelState.IsValid ? string.Empty : "Error: ")}Pending Order - {order.CustomerName}";
    var symbol = order.CurrencySymbol;

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .ToList();
    string? ErrorFor(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    var purchaseOrderError = ErrorFor(nameof(PendingOrderDecisionForm.PurchaseOrderNumber));
    var commentsError = ErrorFor(nameof(PendingOrderDecisionForm.Comments));
}

<govuk-error-summary errors="@errors" />

<h1 class="govuk-heading-l ptl-break-word">@order.QalNumber, @order.CustomerName</h1>
<p class="govuk-body">This page shows a pending order which can be updated, approved or declined</p>

<h2 class="govuk-heading-m">Schemes</h2>

@if (order.Schemes.Count == 0)
{
    <p class="govuk-body">There are no schemes on this order.</p>
}
else
{
    <p class="govuk-hint">Changing a month or the Import/Export Licence option saves that scheme straight away and updates the totals.</p>

    <section class="ptl-table-scroll" aria-label="Schemes on this order">
        <table class="govuk-table ptl-pending-order-table">
            <caption class="govuk-table__caption govuk-visually-hidden">Schemes on this order, with the months, Import/Export Licence and prices for each</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Scheme</th>
                    @foreach (var month in order.Schemes[0].Months)
                    {
                        <th scope="col" class="govuk-table__header ptl-pending-order-month">@month.Label</th>
                    }
                    <th scope="col" class="govuk-table__header">Import/Export Licence</th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric">Postage</th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric">Scheme Price</th>
                    <th scope="col" class="govuk-table__header govuk-table__header--numeric">Total</th>
                    <th scope="col" class="govuk-table__header">Actions</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var scheme in order.Schemes)
                {
                    var formId = $"scheme-{scheme.PendingParticipantSchemeId}";
                    <tr class="govuk-table__row @(scheme.IsRemoved ? "ptl-inactive-row" : null)">
                        <th scope="row" class="govuk-table__header ptl-pending-order-scheme" title="@scheme.SchemeName">
                            @scheme.SchemeIdentifier
                            <span class="govuk-visually-hidden">: @scheme.SchemeName</span>
                        </th>
                        @foreach (var month in scheme.Months)
                        {
                            // Legacy enables a month only when the scheme offers it and nothing has been posted
                            // (Jan to Mar also need the scheme's own distribution to be undefined). Months already
                            // covered by a live contract are ticked, locked and highlighted.
                            var editable = month.Enabled && !scheme.IsRemoved;
                            <td class="govuk-table__cell ptl-pending-order-month @(month.AlreadyParticipating ? "ptl-month-contracted" : null)"
                                title="@(month.AlreadyParticipating ? "Already participating" : null)">
                                <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input ptl-autosubmit" type="checkbox" form="@formId"
                                               id="@(formId)-@month.Label" name="@(editable ? $"DistributionMonth{month.Label}" : null)" value="true"
                                               checked="@month.Selected" disabled="@(!editable)" />
                                        <label class="govuk-label govuk-checkboxes__label" for="@(formId)-@month.Label">
                                            <span class="govuk-visually-hidden">@month.Label for @scheme.SchemeIdentifier@(month.AlreadyParticipating ? " (already participating)" : null)</span>
                                        </label>
                                    </div>
                                </div>
                                @* A disabled checkbox posts nothing, so the hidden field carries the month's
                                   current value through the round trip rather than clearing it. *@
                                <input type="hidden" form="@formId" name="DistributionMonth@(month.Label)"
                                       value="@((!editable && month.Selected).ToString().ToLowerInvariant())" />
                            </td>
                        }
                        <td class="govuk-table__cell">
                            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input ptl-autosubmit" type="checkbox" form="@formId"
                                           id="@(formId)-licence" name="ImportExportLicenceRequired" value="true"
                                           checked="@scheme.ImportExportLicenceRequired" disabled="@scheme.IsRemoved" />
                                    <label class="govuk-label govuk-checkboxes__label" for="@(formId)-licence">
                                        <span class="govuk-visually-hidden">Import/Export Licence for @scheme.SchemeIdentifier</span>
                                    </label>
                                </div>
                            </div>
                            <input type="hidden" form="@formId" name="ImportExportLicenceRequired"
                                   value="@((scheme.IsRemoved && scheme.ImportExportLicenceRequired).ToString().ToLowerInvariant())" />
                        </td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@symbol@scheme.PostagePrice.ToString("N2")</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@symbol@scheme.Price.ToString("N2")</td>
                        <td class="govuk-table__cell govuk-table__cell--numeric">@symbol@scheme.TotalPrice.ToString("N2")</td>
                        <td class="govuk-table__cell ptl-no-strike">
                            <input type="hidden" form="@formId" name="IsRemoved" value="@scheme.IsRemoved.ToString().ToLowerInvariant()" />
                            <button class="govuk-link ptl-link-button" type="submit" form="@formId" formnovalidate
                                    formaction="@Url.Action("RemovePendingOrderScheme", new { pendingContractId = order.PendingContractId, pendingParticipantSchemeId = scheme.PendingParticipantSchemeId })">
                                @(scheme.IsRemoved ? "Add" : "Remove")<span class="govuk-visually-hidden"> @scheme.SchemeIdentifier</span>
                            </button>
                            @* Legacy relied on AutoPostBack for the checkboxes; this button is the
                               equivalent for anyone without JavaScript. *@
                            <noscript>
                                <button class="govuk-button govuk-button--secondary govuk-button--small" data-module="govuk-button"
                                        type="submit" form="@formId">Update<span class="govuk-visually-hidden"> @scheme.SchemeIdentifier</span></button>
                            </noscript>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    @* One form per row, declared outside the table so the row's inputs can reference it by id. *@
    @foreach (var pendingParticipantSchemeId in order.Schemes.Select(scheme => scheme.PendingParticipantSchemeId))
    {
        <form method="post" id="scheme-@pendingParticipantSchemeId"
              asp-action="UpdatePendingOrderScheme"
              asp-route-pendingContractId="@order.PendingContractId"
              asp-route-pendingParticipantSchemeId="@pendingParticipantSchemeId"></form>
    }
}

<h2 class="govuk-heading-m">Order details:</h2>

<form method="post" asp-action="ApprovePendingOrder" asp-route-pendingContractId="@order.PendingContractId" novalidate>
    <dl class="govuk-summary-list">
        <govuk-summary-row label="QAL Number">@order.QalNumber</govuk-summary-row>
        <govuk-summary-row label="Contract Year">@order.Year</govuk-summary-row>
    </dl>

    <div class="govuk-form-group @(purchaseOrderError is null ? null : "govuk-form-group--error")">
        <label class="govuk-label" for="PurchaseOrderNumber">Purchase Order Number:</label>
        @if (purchaseOrderError is not null)
        {
            <p id="PurchaseOrderNumber-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @purchaseOrderError</p>
        }
        <input class="govuk-input govuk-input--width-20 @(purchaseOrderError is null ? null : "govuk-input--error")" id="PurchaseOrderNumber" name="PurchaseOrderNumber"
               value="@form.PurchaseOrderNumber" aria-describedby="@(purchaseOrderError is null ? null : "PurchaseOrderNumber-error")" />
    </div>

    <dl class="govuk-summary-list">
        <govuk-summary-row label="Total Scheme Price (@symbol)">@order.TotalSchemePrice.ToString("N2")</govuk-summary-row>
        <govuk-summary-row label="Total postage (@symbol)">@order.TotalPostagePrice.ToString("N2")</govuk-summary-row>
        <govuk-summary-row label="Total (@symbol)">@order.Total.ToString("N2")</govuk-summary-row>
    </dl>

    <h2 class="govuk-heading-m">Comments</h2>
    <div class="govuk-form-group @(commentsError is null ? null : "govuk-form-group--error")">
        <label class="govuk-label" for="Comments">Comments:</label>
        @if (commentsError is not null)
        {
            <p id="Comments-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @commentsError</p>
        }
        <textarea class="govuk-textarea @(commentsError is null ? null : "govuk-textarea--error")" id="Comments" name="Comments" rows="5"
                  aria-describedby="@(commentsError is null ? null : "Comments-error")">@form.Comments</textarea>
    </div>

    <div class="govuk-button-group">
        <button class="govuk-button" data-module="govuk-button" type="submit">Approve</button>
        <button class="govuk-button govuk-button--warning" data-module="govuk-button" type="submit"
                formaction="@Url.Action("DeclinePendingOrder", new { pendingContractId = order.PendingContractId })">Decline</button>
        <a class="govuk-link" asp-action="ReviewPendingOrders">Cancel</a>
    </div>
</form>

@section Scripts {
    @* Legacy marked every month and licence checkbox AutoPostBack="True", so each tick saved the
       row immediately. This reproduces that without a dedicated Update button. *@
    <script>
        document.querySelectorAll('.ptl-autosubmit').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var form = checkbox.form || document.getElementById(checkbox.getAttribute('form'));
                if (form) {
                    form.submit();
                }
            });
        });
    </script>
}
