@model PTL.InternalWeb.Features.Scheme.SchemeFormViewModel
@{
    ViewData["Title"] = $"Scheme - {Model.Identifier}";
}

@* Phase 2: reuses the same tabbed edit form as Create/Edit. Model.IsViewMode makes _SchemeForm and
   its tab partials render every field as plain read-only text with no Save/Add/Remove/Move/rich-
   text-editor affordances, so viewing a scheme shows every field the edit screen does - Tests,
   Distribution Level Data, Results Tabulations, Test Consultants/Assessors, Viewers and Prices
   included - not just the subset the previous hand-rolled summary covered. *@
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@Model.Identifier - @Model.Name</h1>
    </div>
    <div class="govuk-grid-column-one-third govuk-!-text-align-right">
        @if (Model.IsReadOnly == true)
        {
            <strong class="govuk-tag govuk-tag--grey">Read only (closed year)</strong>
        }
        else
        {
            <a class="govuk-button" data-module="govuk-button" asp-action="Edit" asp-route-id="@Model.SchemeId">Edit scheme</a>
        }
    </div>
</div>


<partial name="_SchemeForm" model="Model" />
