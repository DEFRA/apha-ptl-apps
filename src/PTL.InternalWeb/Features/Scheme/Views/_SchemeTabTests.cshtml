@model PTL.InternalWeb.Features.Scheme.SchemeFormViewModel

@* Each "Add" dropdown is named pick:{command} so the controller reads the one matching the submitted command. *@



@for (var t = 0; t < Model.Tests.Count; t++)
{
    var test = Model.Tests[t];
    <div class="govuk-summary-card">
        <div class="govuk-summary-card__title-wrapper">
            <h3 class="govuk-summary-card__title">@test.TestType</h3>
            @if (!Model.IsViewMode)
            {
                <ul class="govuk-summary-card__actions">
                    @if (t > 0)
                    {
                        <li class="govuk-summary-card__action">
                            <button type="submit" class="govuk-link ptl-link-button" name="testCommand" value="move-test-up:@t" title="Move Test Up">Up</button>
                        </li>
                    }
                    @if (t < Model.Tests.Count - 1)
                    {
                        <li class="govuk-summary-card__action">
                            <button type="submit" class="govuk-link ptl-link-button" name="testCommand" value="move-test-down:@t" title="Move Test Down">Down</button>
                        </li>
                    }
                    <li class="govuk-summary-card__action">
                        <button type="submit" class="govuk-link ptl-link-button" name="testCommand" value="remove-test:@t">Remove Test</button>
                    </li>
                </ul>
            }
        </div>
        <div class="govuk-summary-card__content">
            <input type="hidden" asp-for="Tests[t].TestId" />
            <input type="hidden" asp-for="Tests[t].TestTypeId" />
            <input type="hidden" asp-for="Tests[t].TestType" />

            <partial name="_SchemeTestItemList" model="@(new PTL.InternalWeb.Features.Scheme.SchemeTestItemListViewModel(
                Heading: "Results",
                Items: test.ResultItems,
                FieldPrefix: $"Tests[{t}].ResultItems",
                AddCommand: $"add-result:{t}",
                RemoveCommand: $"remove-result:{t}",
                MoveUpCommand: $"move-result-up:{t}",
                MoveDownCommand: $"move-result-down:{t}",
                AddLabel: "Add Result Item",
                EmptyMessage: "No Items Defined - Click 'Add Result Item'",
                PickerId: $"addResult{t}",
                TypeOptions: Model.ResultItemTypeOptions,
                IsViewMode: Model.IsViewMode))" />

            <partial name="_SchemeTestItemList" model="@(new PTL.InternalWeb.Features.Scheme.SchemeTestItemListViewModel(
                Heading: "Methods",
                Items: test.MethodItems,
                FieldPrefix: $"Tests[{t}].MethodItems",
                AddCommand: $"add-method:{t}",
                RemoveCommand: $"remove-method:{t}",
                MoveUpCommand: $"move-method-up:{t}",
                MoveDownCommand: $"move-method-down:{t}",
                AddLabel: "Add Method Item",
                EmptyMessage: "No Items Defined - Click 'Add Method Item'",
                PickerId: $"addMethod{t}",
                TypeOptions: Model.MethodItemTypeOptions,
                IsViewMode: Model.IsViewMode))" />

            @* Categories and their criteria exist only on assessment schemes. *@
            @if (Model.RequiresAssessment)
            {
                <h4 class="govuk-heading-s">Categories</h4>
                @if (!Model.IsViewMode)
                {
                    <div class="govuk-form-group">
                        <select class="govuk-select" id="addCategory@(t)" name="pick:add-category:@t">
                            <option value="">- Please Select -</option>
                            @foreach (var option in Model.CategoryItemTypeOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-left-2" data-module="govuk-button"
                                name="testCommand" value="add-category:@t">Add Category Item</button>
                    </div>
                }

                @if (test.Categories.Count == 0)
                {
                    <p class="govuk-body">No Items Defined - Click 'Add Category Item'</p>
                }

                @for (var c = 0; c < test.Categories.Count; c++)
                {
                    var category = test.Categories[c];
                    <div class="govuk-inset-text">
                        <p class="govuk-body govuk-!-font-weight-bold">
                            @category.Name
                            @if (!Model.IsViewMode)
                            {
                                if (c > 0)
                                {
                                    <button type="submit" class="govuk-link ptl-link-button govuk-!-margin-left-3" name="testCommand" value="move-category-up:@t:@c">Up</button>
                                }
                                if (c < test.Categories.Count - 1)
                                {
                                    <button type="submit" class="govuk-link ptl-link-button govuk-!-margin-left-2" name="testCommand" value="move-category-down:@t:@c">Down</button>
                                }
                                <button type="submit" class="govuk-link ptl-link-button govuk-!-margin-left-2" name="testCommand" value="remove-category:@t:@c">Remove</button>
                            }
                        </p>
                        <input type="hidden" asp-for="Tests[t].Categories[c].CategoryItemId" />
                        <input type="hidden" asp-for="Tests[t].Categories[c].CategoryItemTypeId" />
                        <input type="hidden" asp-for="Tests[t].Categories[c].Name" />

                        <partial name="_SchemeTestItemList" model="@(new PTL.InternalWeb.Features.Scheme.SchemeTestItemListViewModel(
                            Heading: "Criteria",
                            Items: category.Criteria,
                            FieldPrefix: $"Tests[{t}].Categories[{c}].Criteria",
                            AddCommand: $"add-criterion:{t}:{c}",
                            RemoveCommand: $"remove-criterion:{t}:{c}",
                            MoveUpCommand: $"move-criterion-up:{t}:{c}",
                            MoveDownCommand: $"move-criterion-down:{t}:{c}",
                            AddLabel: "Add Criterion Item",
                            EmptyMessage: "No Items Defined - Click 'Add Criterion Item'",
                            PickerId: $"addCriterion{t}_{c}",
                            TypeOptions: Model.CriterionItemTypeOptions,
                            IsViewMode: Model.IsViewMode))" />
                    </div>
                }
            }
        </div>
    </div>
}

@if (!Model.IsViewMode)
{
    <div class="govuk-form-group">
        <label class="govuk-label govuk-label--s" for="addTestTypeId">Add New Test</label>
        <select class="govuk-select govuk-!-width-one-half" id="addTestTypeId" name="pick:add-test">
            <option value="">- Please Select -</option>
            @foreach (var option in Model.TestTypeOptions)
            {
                <option value="@option.Value">@option.Text</option>
            }
        </select>
        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-left-2" data-module="govuk-button"
                name="testCommand" value="add-test">
            Add New Test
        </button>
    </div>
}

