@model PTL.InternalWeb.Features.Scheme.SchemeFormViewModel
@{
    // Error-summary ordering follows the visual top-to-bottom order of the Details tab, then the
    // remaining tabs in legacy tab order.
    var fieldOrder = new[]
    {
        nameof(Model.Identifier), nameof(Model.Name), nameof(Model.YearId), nameof(Model.StartDate),
        nameof(Model.ScheduleId), nameof(Model.ScheduleCodeId),
        nameof(Model.DistributionAsAvailable),
        nameof(Model.WeekNumber), nameof(Model.DayOfWeekId),
        nameof(Model.NumberOfSamples), nameof(Model.SampleOrigin), nameof(Model.Subcontractor),
        nameof(Model.Deadline), nameof(Model.CombinedPackaging), nameof(Model.SamplePackingInstructions),
        nameof(Model.Postage), nameof(Model.CustomsVolume),
        nameof(Model.CommentsRequired), nameof(Model.Pilot), nameof(Model.LimitedSampleAvailability),
        nameof(Model.Accredited), nameof(Model.NoVLALabs), nameof(Model.ComerciallyAvailable),
        nameof(Model.RequiresAssessment),
        nameof(Model.Prices),
        nameof(Model.CustomsDescription),
        nameof(Model.DataConsentDeclarationActive), nameof(Model.DataConsentDeclarationText),
        nameof(Model.Instructions),
        nameof(Model.StandardTabulationText), nameof(Model.TestConsultantTabulationId), nameof(Model.Tabulations),
        nameof(Model.TestConsultant1), nameof(Model.TestConsultant2), nameof(Model.TestConsultant3),
        nameof(Model.Assessor1), nameof(Model.Assessor2), nameof(Model.Assessor3), nameof(Model.Assessor4)
    };

    // Collection members are reported under keys like "Prices[0].Price", so an exact match would
    // push every one of them to the bottom of the summary instead of next to its own field.
    int FieldRank(string field)
    {
        for (var index = 0; index < fieldOrder.Length; index++)
        {
            var candidate = fieldOrder[index];
            if (field.Equals(candidate, StringComparison.Ordinal)
                || field.StartsWith(candidate + "[", StringComparison.Ordinal)
                || field.StartsWith(candidate + ".", StringComparison.Ordinal))
            {
                return index;
            }
        }

        return int.MaxValue;
    }

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .OrderBy(error => FieldRank(error.Field))
        .ToList();
}

<govuk-error-summary errors="@errors" />

@if (Model.SchemeId is not null)
{
    <input type="hidden" asp-for="SchemeId" />
    <input type="hidden" asp-for="SharedId" />
}

@* Seven tabs in legacy Scheme.aspx TabContainer1 order. Test Consultants and Assessors are
   mutually exclusive, driven by Requires Assessment on the Details tab. *@
<div class="govuk-tabs" data-module="govuk-tabs" id="scheme-tabs">
    <h2 class="govuk-tabs__title">Contents</h2>
    <ul class="govuk-tabs__list">
        <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
            <a class="govuk-tabs__tab" href="#tab-details">Details</a>
        </li>
        <li class="govuk-tabs__list-item">
            <a class="govuk-tabs__tab" href="#tab-tests">Tests</a>
        </li>
        <li class="govuk-tabs__list-item">
            <a class="govuk-tabs__tab" href="#tab-distribution-level-data">Distribution Level Data</a>
        </li>
        <li class="govuk-tabs__list-item">
            <a class="govuk-tabs__tab" href="#tab-results-tabulations">Results Tabulations</a>
        </li>
        <li class="govuk-tabs__list-item" id="tab-list-item-test-consultants" hidden="@Model.RequiresAssessment">
            <a class="govuk-tabs__tab" href="#tab-test-consultants">Test Consultants</a>
        </li>
        <li class="govuk-tabs__list-item" id="tab-list-item-assessors" hidden="@(!Model.RequiresAssessment)">
            <a class="govuk-tabs__tab" href="#tab-assessors">Assessors</a>
        </li>
        <li class="govuk-tabs__list-item">
            <a class="govuk-tabs__tab" href="#tab-viewers">Viewers</a>
        </li>
    </ul>

    <div class="govuk-tabs__panel" id="tab-details">
        <partial name="_SchemeTabDetails" model="Model" />
    </div>
    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-tests">
        <partial name="_SchemeTabTests" model="Model" />
    </div>
    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-distribution-level-data">
        <partial name="_SchemeTabDistributionLevelData" model="Model" />
    </div>
    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-results-tabulations">
        <partial name="_SchemeTabResultsTabulations" model="Model" />
    </div>
    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-test-consultants">
        <partial name="_SchemeTabTestConsultants" model="Model" />
    </div>
    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-assessors">
        <partial name="_SchemeTabAssessors" model="Model" />
    </div>
    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="tab-viewers">
        <partial name="_SchemeTabViewers" model="Model" />
    </div>
</div>

<script>
    // Mirrors Scheme.aspx.vb EnableAssessor(): Requires Assessment swaps the Test Consultants and
    // Assessors tabs. Requires Assessment is only editable while creating a scheme, so on Edit the
    // server-rendered state is already final and this listener never fires.
    (function () {
        var requiresAssessment = document.getElementById('RequiresAssessment');
        var consultantsTab = document.getElementById('tab-list-item-test-consultants');
        var assessorsTab = document.getElementById('tab-list-item-assessors');
        if (!requiresAssessment || !consultantsTab || !assessorsTab) {
            return;
        }

        requiresAssessment.addEventListener('change', function () {
            consultantsTab.hidden = requiresAssessment.checked;
            assessorsTab.hidden = !requiresAssessment.checked;
        });
    })();

    // An error summary link only scrolls to its field if that field's tab is open, so opening the
    // containing tab first is what makes every link work and not just the Details ones.
    (function () {
        var summary = document.querySelector('.govuk-error-summary');
        if (!summary) {
            return;
        }

        summary.addEventListener('click', function (event) {
            var link = event.target.closest('a[href^="#"]');
            if (!link) {
                return;
            }

            var field = document.getElementById(decodeURIComponent(link.getAttribute('href').substring(1)));
            var panel = field && field.closest('.govuk-tabs__panel');
            if (!panel) {
                return;
            }

            var tab = document.querySelector('#scheme-tabs .govuk-tabs__tab[href="#' + panel.id + '"]');
            if (tab && panel.classList.contains('govuk-tabs__panel--hidden')) {
                tab.click();
            }
        });
    })();
</script>
