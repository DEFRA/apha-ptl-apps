@model PTL.InternalWeb.Features.Scheme.SchemeFormViewModel
@{
    // Hand-rolled to match the GOV.UK Design System error summary exactly - see
    // PTL.InternalWeb/Features/Customer/Views/_CustomerForm.cshtml for the reference pattern this follows.
    var fieldOrder = new[]
    {
        nameof(Model.YearId), nameof(Model.Identifier), nameof(Model.Name), nameof(Model.StartDate),
        nameof(Model.ScheduleId), nameof(Model.ScheduleCodeId),
        nameof(Model.DistributionAsAvailable),
        nameof(Model.WeekNumber), nameof(Model.NumberOfSamples), nameof(Model.SampleOrigin), nameof(Model.Deadline),
        nameof(Model.Subcontractor), nameof(Model.CombinedPackaging), nameof(Model.Postage), nameof(Model.CustomsVolume),
        nameof(Model.SamplePackingInstructions),
        nameof(Model.RequiresAssessment),
        nameof(Model.CommentsRequired), nameof(Model.Pilot), nameof(Model.LimitedSampleAvailability),
        nameof(Model.Accredited), nameof(Model.NoVLALabs), nameof(Model.ComerciallyAvailable),
        nameof(Model.CustomsDescription),
        nameof(Model.DataConsentDeclarationActive), nameof(Model.DataConsentDeclarationText),
        nameof(Model.Instructions), nameof(Model.StandardTabulationText)
    };

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .OrderBy(error => Array.IndexOf(fieldOrder, error.Field) is var idx && idx == -1 ? int.MaxValue : idx)
        .ToList();

    bool HasError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0;
    string? FirstError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    string FormGroupClass(string field) => HasError(field) ? "govuk-form-group govuk-form-group--error" : "govuk-form-group";
    string InputClass(string baseClass, string field) => HasError(field) ? $"{baseClass} {baseClass}--error" : baseClass;
    string? DescribedBy(string field) => HasError(field) ? $"{field}-error" : null;
}

@if (errors.Count > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in errors)
                    {
                        <li>
                            @if (string.IsNullOrEmpty(error.Field))
                            {
                                @error.Message
                            }
                            else
                            {
                                <a href="#@error.Field">@error.Message</a>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

