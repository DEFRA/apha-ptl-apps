@model PTL.InternalWeb.Features.Scheme.SchemeListViewModel
@using PTL.InternalWeb.Pagination
@{
    ViewData["Title"] = "Schemes";
    var pagination = new PaginationModel
    {
        CurrentPage = Model.Page,
        PageSize = Model.PageSize,
        TotalRecords = Model.TotalCount,
        RouteValues = new Dictionary<string, object?> { ["searchTerm"] = Model.SearchTerm, ["yearId"] = Model.Search?.YearId }
    };
}

<h1 class="govuk-heading-l">Schemes</h1>

@* Legacy Scheme Admin/Search.aspx: "Use the search box below to identify the required Scheme by
   Scheme Name." - absorbed into the list page as a usability improvement; a plain substring match,
   no other filtering behaviour. *@
<form method="get" asp-action="Index" class="govuk-!-margin-bottom-6">
    @if (Model.Search is { } search)
    {
        <div class="govuk-form-group">
            <label class="govuk-label" for="yearId">Year</label>
            <select class="govuk-select" id="yearId" name="yearId">
                @foreach (var year in search.YearOptions)
                {
                    <option value="@year.Value" selected="@(year.Value == search.YearId.ToString(System.Globalization.CultureInfo.InvariantCulture) ? "selected" : null)">@year.Text</option>
                }
            </select>
        </div>
    }
    <div class="govuk-form-group">
        <label class="govuk-label" for="searchTerm">Scheme Name</label>
        <input class="govuk-input" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" />
    </div>
    <button class="govuk-button" data-module="govuk-button" type="submit">Search</button>
</form>

@if (Model.Schemes.Count == 0)
{
    <p class="govuk-body">There are no schemes to display.</p>
}
else
{
    <govuk-page-size-selector model="pagination" />


    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Identifier</th>
                <th scope="col" class="govuk-table__header">Name</th>
                <th scope="col" class="govuk-table__header">Current Year</th>
                <th scope="col" class="govuk-table__header">Next Year</th>
                <th scope="col" class="govuk-table__header">History</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var scheme in Model.Schemes)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@scheme.Identifier</td>
                    <td class="govuk-table__cell">@scheme.Name</td>
                    <td class="govuk-table__cell">
                        @* Legacy GridViewSchemes_RowDataBound hides this link when the family has no
                           current-year scheme. *@
                        @if (scheme.CurrentSchemeId is { } currentSchemeId && currentSchemeId != Guid.Empty)
                        {
                            <a class="govuk-link" asp-action="Details" asp-route-id="@currentSchemeId">Details</a>
                        }
                    </td>
                    <td class="govuk-table__cell">
                        @* And swaps this one to Renew - against the MOST RECENT scheme, not the
                           current one - when next year's scheme does not exist yet. *@
                        @if (scheme.NextSchemeId is { } nextSchemeId && nextSchemeId != Guid.Empty)
                        {
                            <a class="govuk-link" asp-action="Details" asp-route-id="@nextSchemeId">Details</a>
                        }
                        else if (scheme.RecentSchemeId is { } recentSchemeId && recentSchemeId != Guid.Empty)
                        {
                            <a class="govuk-link" asp-action="Renew" asp-route-schemeId="@recentSchemeId">Renew</a>
                        }
                    </td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-action="History" asp-route-sharedId="@scheme.SharedId">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <govuk-pagination model="pagination" />
}
