@model PTL.InternalWeb.Features.Scheme.SchemeFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    string OptionText(IEnumerable<SelectListItem> options, Guid? value) =>
        value is null ? string.Empty : options.FirstOrDefault(o => o.Value == value.Value.ToString())?.Text ?? string.Empty;
}

@if (Model.IsViewMode)
{
    <dl class="govuk-summary-list">
        <govuk-summary-row label="Primary Test Consultant">@OptionText(Model.PrimaryTestConsultantOptions, Model.TestConsultant1)</govuk-summary-row>
        <govuk-summary-row label="Deputy Test Consultant">@OptionText(Model.TestConsultantOptions, Model.TestConsultant2)</govuk-summary-row>
        <govuk-summary-row label="Secondary Test Consultant">@OptionText(Model.TestConsultantOptions, Model.TestConsultant3)</govuk-summary-row>
    </dl>
}
else if (Model.IsPreviousYear)
{
    <partial name="_SchemeLockedField" model="@((Kind: "select", Field: nameof(Model.TestConsultant1), Label: "Primary Test Consultant", Value: Model.TestConsultant1?.ToString(), Text: OptionText(Model.PrimaryTestConsultantOptions, Model.TestConsultant1), Width: "govuk-!-width-one-half"))" />
    <partial name="_SchemeLockedField" model="@((Kind: "select", Field: nameof(Model.TestConsultant2), Label: "Deputy Test Consultant", Value: Model.TestConsultant2?.ToString(), Text: OptionText(Model.TestConsultantOptions, Model.TestConsultant2), Width: "govuk-!-width-one-half"))" />
    <partial name="_SchemeLockedField" model="@((Kind: "select", Field: nameof(Model.TestConsultant3), Label: "Secondary Test Consultant", Value: Model.TestConsultant3?.ToString(), Text: OptionText(Model.TestConsultantOptions, Model.TestConsultant3), Width: "govuk-!-width-one-half"))" />
}
else
{
    <govuk-select asp-for="TestConsultant1" label="Primary Test Consultant" asp-items="Model.PrimaryTestConsultantOptions" />

    <govuk-select asp-for="TestConsultant2" label="Deputy Test Consultant" asp-items="Model.TestConsultantOptions" />

    <govuk-select asp-for="TestConsultant3" label="Secondary Test Consultant" asp-items="Model.TestConsultantOptions" />
}

<input type="hidden" asp-for="TestConsultantTabulationId" />
