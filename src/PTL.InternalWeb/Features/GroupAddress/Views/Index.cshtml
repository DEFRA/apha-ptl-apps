@model PTL.InternalWeb.Features.GroupAddress.GroupAddressListViewModel
@using PTL.InternalWeb.Pagination
@{
    ViewData["Title"] = "Group Addresses";
    var pagination = new PaginationModel
    {
        CurrentPage = Model.Page,
        PageSize = Model.PageSize,
        TotalRecords = Model.TotalCount,
        RouteValues = new Dictionary<string, object?>()
    };
}

<h1 class="govuk-heading-l">Group Addresses</h1>

@if (Model.Items.Count == 0)
{
    <p class="govuk-body">There are no group addresses to display.</p>
}
else
{
    <govuk-page-size-selector model="pagination" />

    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Identifier</th>
                <th scope="col" class="govuk-table__header">Address line 1</th>
                <th scope="col" class="govuk-table__header">Details</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var item in Model.Items)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@item.Identifier</td>
                    <td class="govuk-table__cell">@item.Address1</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-action="Details" asp-route-id="@item.GroupAddressId">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <govuk-pagination model="pagination" />
}
