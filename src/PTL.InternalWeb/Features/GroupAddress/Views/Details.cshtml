@model PTL.InternalWeb.Features.GroupAddress.GroupAddressDetailsViewModel
@{
    var groupAddress = Model.GroupAddress;
    ViewData["Title"] = "Group Address Details";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Group Address Details</h1>
    </div>
    <div class="govuk-grid-column-one-third govuk-!-text-align-right">
        <a class="govuk-button" data-module="govuk-button" asp-action="Edit" asp-route-id="@groupAddress.GroupAddressId">Edit group address</a>
    </div>
</div>

<h2 class="govuk-heading-m">Group address details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Identifier">@groupAddress.Identifier</govuk-summary-row>
    <govuk-summary-row label="Address line 1">@groupAddress.Address1</govuk-summary-row>
    <govuk-summary-row label="Address line 2">@groupAddress.Address2</govuk-summary-row>
    <govuk-summary-row label="Address line 3">@groupAddress.Address3</govuk-summary-row>
    <govuk-summary-row label="Address line 4">@groupAddress.Address4</govuk-summary-row>
    <govuk-summary-row label="Address line 5">@groupAddress.Address5</govuk-summary-row>
    <govuk-summary-row label="Country">@Model.CountryName</govuk-summary-row>
    <govuk-summary-row label="Telephone">@groupAddress.Telephone</govuk-summary-row>
    <govuk-summary-row label="Packing Instructions">@groupAddress.PackingInstructions</govuk-summary-row>
</dl>

