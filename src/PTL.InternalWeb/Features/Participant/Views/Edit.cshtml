@model PTL.InternalWeb.Features.Participant.ParticipantFormViewModel
@{
    ViewData["Title"] = $"Edit participant - {Model.LabName}";
}

<h1 class="govuk-heading-l">Edit participant</h1>

<form method="post" asp-action="Edit" asp-route-id="@Model.ParticipantId" novalidate>
    @await Html.PartialAsync("_ParticipantForm", Model)

    <button class="govuk-button" data-module="govuk-button" type="submit">Save changes</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
