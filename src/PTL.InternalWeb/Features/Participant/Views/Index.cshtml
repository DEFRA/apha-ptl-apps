@model PTL.InternalWeb.Features.Participant.ParticipantListViewModel
@using PTL.SharedUI.Pagination
@{
    ViewData["Title"] = "Participants";
    var pagination = new PaginationModel
    {
        CurrentPage = Model.Page,
        PageSize = Model.PageSize,
        TotalRecords = Model.TotalCount,
        RouteValues = new Dictionary<string, object?> { ["customerId"] = Model.CustomerId, ["includeInactive"] = Model.IncludeInactive }
    };
}

<h1 class="govuk-heading-l">Participants</h1>

@if (Model.Participants.Count == 0)
{
    <p class="govuk-body">There are no participants to display.</p>
}
else
{
    <govuk-page-size-selector model="pagination" />

    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Lab Code</th>
                <th scope="col" class="govuk-table__header">Lab Name</th>
                <th scope="col" class="govuk-table__header">Contact Name</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header">Details</th>
                <th scope="col" class="govuk-table__header">Viewers</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var participant in Model.Participants)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@participant.LabCode</td>
                    <td class="govuk-table__cell">@participant.LabName</td>
                    <td class="govuk-table__cell">@participant.ContactName</td>
                    <td class="govuk-table__cell">
                        <strong class="govuk-tag @(participant.IsActive ? "govuk-tag--green" : "govuk-tag--grey")">
                            @(participant.IsActive ? "Active" : "Inactive")
                        </strong>
                    </td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-action="Details" asp-route-id="@participant.ParticipantId">Details</a>
                    </td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-action="Viewers" asp-route-participantId="@participant.ParticipantId">Viewers</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <govuk-pagination model="pagination" />
}

@* Legacy ParticipantList.aspx btnContractList / btnCustomerDetails - both scoped to the current customer. *@
<div class="govuk-button-group">
    <a class="govuk-button govuk-button--secondary" data-module="govuk-button" asp-controller="Contract" asp-action="Index" asp-route-customerId="@Model.CustomerId">Go to Contracts Page</a>
    <a class="govuk-button govuk-button--secondary" data-module="govuk-button" asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId">Go to Customer Details</a>
</div>
