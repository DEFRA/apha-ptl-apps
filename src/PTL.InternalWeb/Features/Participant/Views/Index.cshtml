@model PTL.InternalWeb.Features.Participant.ParticipantListViewModel
@using PTL.Contracts.Participant
@using PTL.InternalWeb.Pagination
@{
    ViewData["Title"] = "Participants";
    var pagination = new PaginationModel
    {
        CurrentPage = Model.Page,
        PageSize = Model.PageSize,
        TotalRecords = Model.TotalCount,
        RouteValues = new Dictionary<string, object?> { ["customerId"] = Model.CustomerId, ["searchTerm"] = Model.SearchTerm, ["includeInactive"] = Model.IncludeInactive }
    };
}

<h1 class="govuk-heading-l">Participants</h1>

<form method="get" asp-action="Index" class="govuk-!-margin-bottom-6">
    <input type="hidden" name="customerId" value="@Model.CustomerId" />
    <div class="govuk-form-group">
        <label class="govuk-label" for="searchTerm">Search</label>
        <div class="govuk-hint">Matches lab code, lab name, or contact name.</div>
        <input class="govuk-input" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" />
    </div>
    <div class="govuk-form-group">
        <label class="govuk-label" for="includeInactive">Status</label>
        <select class="govuk-select" id="includeInactive" name="includeInactive">
            <option value="false" selected="@(Model.IncludeInactive ? null : "selected")">Active</option>
            <option value="true" selected="@(Model.IncludeInactive ? "selected" : null)">Inactive</option>
        </select>
    </div>
    <button class="govuk-button" data-module="govuk-button" type="submit">Search</button>
</form>

@if (Model.Participants.Count == 0)
{
    <p class="govuk-body">There are no participants to display.</p>
}
else
{
    <govuk-page-size-selector model="pagination" />

    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Lab code</th>
                <th scope="col" class="govuk-table__header">Lab name</th>
                <th scope="col" class="govuk-table__header">Contact</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header">Details</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var participant in Model.Participants)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@participant.LabCode</td>
                    <td class="govuk-table__cell">@participant.LabName</td>
                    <td class="govuk-table__cell">@participant.ContactName</td>
                    <td class="govuk-table__cell">
                        <strong class="govuk-tag @(participant.IsActive ? "govuk-tag--green" : "govuk-tag--grey")">
                            @(participant.IsActive ? "Active" : "Inactive")
                        </strong>
                    </td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-action="Details" asp-route-id="@participant.ParticipantId">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <govuk-pagination model="pagination" />
}
