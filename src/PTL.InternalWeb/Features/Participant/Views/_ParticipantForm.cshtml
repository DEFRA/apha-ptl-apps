@model PTL.InternalWeb.Features.Participant.ParticipantFormViewModel
@{
    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .ToList();

    bool HasError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0;
    string? FirstError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    string FormGroupClass(string field) => HasError(field) ? "govuk-form-group govuk-form-group--error" : "govuk-form-group";
    string InputClass(string baseClass, string field) => HasError(field) ? $"{baseClass} {baseClass}--error" : baseClass;
    string? DescribedBy(string field) => HasError(field) ? $"{field}-error" : null;
}

@if (errors.Count > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in errors)
                    {
                        <li>
                            @if (string.IsNullOrEmpty(error.Field))
                            {
                                @error.Message
                            }
                            else
                            {
                                <a href="#@error.Field">@error.Message</a>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<input type="hidden" asp-for="CustomerId" />
<input type="hidden" asp-for="ParticipantId" />

<h2 class="govuk-heading-m">Participant details</h2>

<div class="@FormGroupClass("LabCode")">
    <label class="govuk-label" asp-for="LabCode">Lab code</label>
    @if (HasError("LabCode"))
    {
        <p id="LabCode-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("LabCode")</p>
    }
    <input class="@InputClass("govuk-input", "LabCode")" asp-for="LabCode" aria-describedby="@DescribedBy("LabCode")" />
</div>

