@model PTL.InternalWeb.Features.Participant.ParticipantFormViewModel
@{
    // Fixed field order matching the visual layout below, so the error summary links appear in
    // the same top-to-bottom order as the fields themselves rather than ModelState's insertion
    // order (which follows validation execution order, not the page layout).
    string[] fieldOrder =
    [
        "LabCode", "LabName", "LabTypeId", "SsoId",
        "ContactName", "Organisation", "Address1", "Address2", "Address3", "Address4", "Address5",
        "CountryId", "Telephone", "Fax", "Email", "Email2", "Comments", "IsActive"
    ];

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .OrderBy(error => Array.IndexOf(fieldOrder, error.Field) is var idx && idx == -1 ? -1 : idx)
        .ToList();

    bool HasError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0;
    string? FirstError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    string FormGroupClass(string field) => HasError(field) ? "govuk-form-group govuk-form-group--error" : "govuk-form-group";
    string InputClass(string baseClass, string field) => HasError(field) ? $"{baseClass} {baseClass}--error" : baseClass;
    string? DescribedBy(string field) => HasError(field) ? $"{field}-error" : null;
}

@if (errors.Count > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in errors)
                    {
                        <li>
                            @if (string.IsNullOrEmpty(error.Field))
                            {
                                @error.Message
                            }
                            else
                            {
                                <a href="#@error.Field">@error.Message</a>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<input type="hidden" asp-for="CustomerId" />
<input type="hidden" asp-for="ParticipantId" />

<h2 class="govuk-heading-m">Participant details</h2>

<div class="@FormGroupClass("LabCode")">
    <label class="govuk-label" asp-for="LabCode">Lab code</label>
    @if (HasError("LabCode"))
    {
        <p id="LabCode-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("LabCode")</p>
    }
    <input class="@InputClass("govuk-input", "LabCode")" asp-for="LabCode" aria-describedby="@DescribedBy("LabCode")" />
</div>

<div class="@FormGroupClass("LabName")">
    <label class="govuk-label" asp-for="LabName">Lab name</label>
    @if (HasError("LabName"))
    {
        <p id="LabName-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("LabName")</p>
    }
    <input class="@InputClass("govuk-input", "LabName")" asp-for="LabName" aria-describedby="@DescribedBy("LabName")" />
</div>

<div class="@FormGroupClass("LabTypeId")">
    <label class="govuk-label" asp-for="LabTypeId">Lab type</label>
    @if (HasError("LabTypeId"))
    {
        <p id="LabTypeId-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("LabTypeId")</p>
    }
    <select class="@InputClass("govuk-select", "LabTypeId")" asp-for="LabTypeId" asp-items="Model.LabTypeOptions" aria-describedby="@DescribedBy("LabTypeId")"></select>
</div>

<div class="@FormGroupClass("SsoId")">
    <label class="govuk-label" asp-for="SsoId">SSO ID</label>
    <div class="govuk-hint">Set automatically and cannot be changed.</div>
    @if (HasError("SsoId"))
    {
        <p id="SsoId-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("SsoId")</p>
    }
    <input class="@InputClass("govuk-input", "SsoId")" asp-for="SsoId" aria-describedby="@DescribedBy("SsoId")" disabled />
</div>

<div class="govuk-form-group">
    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" asp-for="IsActive" id="IsActive" />
            <label class="govuk-label govuk-checkboxes__label" asp-for="IsActive">Active</label>
        </div>
    </div>
</div>

@if (Model.InactiveDate is not null)
{
    <div class="govuk-form-group">
        <label class="govuk-label" for="InactiveDateDisplay">Inactive from</label>
        <input class="govuk-input govuk-input--width-10" id="InactiveDateDisplay" value="@Model.InactiveDate.Value.ToString("d MMMM yyyy")" disabled />
    </div>
}

<h2 class="govuk-heading-m">
    Contact details
    <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-left-3" data-module="govuk-button" id="CopyFromCustomerContactButton"
        data-contact-name="@Model.CustomerContactName" data-organisation="@Model.CustomerOrganisation"
        data-address1="@Model.CustomerAddress1" data-address2="@Model.CustomerAddress2" data-address3="@Model.CustomerAddress3"
        data-address4="@Model.CustomerAddress4" data-address5="@Model.CustomerAddress5" data-country-id="@Model.CustomerCountryId"
        data-telephone="@Model.CustomerTelephone" data-fax="@Model.CustomerFax" data-email="@Model.CustomerEmail">Copy from customer contact</button>
</h2>

