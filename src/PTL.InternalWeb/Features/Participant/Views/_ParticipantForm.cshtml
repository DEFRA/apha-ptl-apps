@model PTL.InternalWeb.Features.Participant.ParticipantFormViewModel
@{
    // Fixed field order matching the visual layout below, so the error summary links appear in
    // the same top-to-bottom order as the fields themselves rather than ModelState's insertion
    // order (which follows validation execution order, not the page layout).
    string[] fieldOrder =
    [
        "LabCode", "LabName", "LabTypeId", "SsoId",
        "ContactName", "Organisation", "Address1", "Address2", "Address3", "Address4", "Address5",
        "CountryId", "Telephone", "Fax", "Email", "Email2", "Comments", "IsActive"
    ];

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .OrderBy(error => Array.IndexOf(fieldOrder, error.Field) is var idx && idx == -1 ? -1 : idx)
        .ToList();
}

<govuk-error-summary errors="@errors" />

<input type="hidden" asp-for="CustomerId" />
<input type="hidden" asp-for="ParticipantId" />

<h2 class="govuk-heading-m">Participant details</h2>

<govuk-input asp-for="LabCode" label="Lab code" />

<govuk-input asp-for="LabName" label="Lab name" />

<govuk-select asp-for="LabTypeId" label="Lab type" asp-items="Model.LabTypeOptions" />

<div class="govuk-form-group">
    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" asp-for="IsActive" id="IsActive" />
            <label class="govuk-label govuk-checkboxes__label" asp-for="IsActive">Active</label>
        </div>
    </div>
</div>

@if (Model.InactiveDate is not null)
{
    <div class="govuk-form-group">
        <label class="govuk-label" for="InactiveDateDisplay">Inactive from</label>
        <input class="govuk-input govuk-input--width-10" id="InactiveDateDisplay" value="@Model.InactiveDate.Value.ToString("d MMMM yyyy")" disabled />
    </div>
}

<h2 class="govuk-heading-m">
    Contact details
    <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-left-3" data-module="govuk-button" id="CopyFromCustomerContactButton"
        data-contact-name="@Model.CustomerContactName" data-organisation="@Model.CustomerOrganisation"
        data-address1="@Model.CustomerAddress1" data-address2="@Model.CustomerAddress2" data-address3="@Model.CustomerAddress3"
        data-address4="@Model.CustomerAddress4" data-address5="@Model.CustomerAddress5" data-country-id="@Model.CustomerCountryId"
        data-telephone="@Model.CustomerTelephone" data-fax="@Model.CustomerFax" data-email="@Model.CustomerEmail">Copy from customer contact</button>
</h2>

<govuk-input asp-for="ContactName" label="Contact name" />

<govuk-input asp-for="Organisation" label="Organisation name" />

<govuk-input asp-for="Address1" label="Address line 1" />

<govuk-input asp-for="Address2" label="Address line 2" />

<govuk-input asp-for="Address3" label="Address line 3" />

<govuk-input asp-for="Address4" label="Address line 4" />

<govuk-input asp-for="Address5" label="Address line 5" />

<govuk-select asp-for="CountryId" label="Country" asp-items="Model.CountryOptions" />

<govuk-input asp-for="Telephone" label="Telephone" />

<govuk-input asp-for="Fax" label="Fax" />

<govuk-input asp-for="Email" label="Email" />

<govuk-input asp-for="Email2" label="Alternative email" />

<govuk-textarea asp-for="Comments" label="Other Packaging Requirements" rows="5" />



<script>
    // Mirrors legacy Participant.aspx.vb ButtonCopyDetails_Click - copies the parent Customer's
    // contact details into this form's contact fields, entirely client-side (no postback). The
    // source values are rendered onto the button as data attributes by _ParticipantForm.cshtml.
    document.getElementById('CopyFromCustomerContactButton').addEventListener('click', function () {
        var source = this.dataset;
        document.getElementById('ContactName').value = source.contactName;
        document.getElementById('Organisation').value = source.organisation;
        document.getElementById('Address1').value = source.address1;
        document.getElementById('Address2').value = source.address2;
        document.getElementById('Address3').value = source.address3;
        document.getElementById('Address4').value = source.address4;
        document.getElementById('Address5').value = source.address5;
        document.getElementById('CountryId').value = source.countryId;
        document.getElementById('Telephone').value = source.telephone;
        document.getElementById('Fax').value = source.fax;
        document.getElementById('Email').value = source.email;
    });
</script>
