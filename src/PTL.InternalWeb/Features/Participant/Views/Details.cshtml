@model PTL.Contracts.Participant.ParticipantResponse
@{
    ViewData["Title"] = $"Participant - {Model.LabName}";
}

<h1 class="govuk-heading-l">@Model.LabName</h1>

<p class="govuk-body">
    <a class="govuk-button" data-module="govuk-button" asp-action="Edit" asp-route-id="@Model.ParticipantId">Edit participant</a>
    @if (Model.IsActive)
    {
        <a class="govuk-button govuk-button--warning" data-module="govuk-button" asp-action="Deactivate" asp-route-id="@Model.ParticipantId">Deactivate participant</a>
    }
    else
    {
        <form asp-action="Reactivate" asp-route-id="@Model.ParticipantId" method="post" class="govuk-!-display-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="govuk-button" data-module="govuk-button">Reactivate participant</button>
        </form>
    }
</p>

<h2 class="govuk-heading-m">Participant details</h2>
<dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Lab code</dt>
        <dd class="govuk-summary-list__value">@Model.LabCode</dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Lab name</dt>
        <dd class="govuk-summary-list__value">@Model.LabName</dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Status</dt>
        <dd class="govuk-summary-list__value">
            <strong class="govuk-tag @(Model.IsActive ? "govuk-tag--green" : "govuk-tag--grey")">
                @(Model.IsActive ? "Active" : "Inactive")
            </strong>
        </dd>
    </div>
    @if (Model.InactiveDate is not null)
    {
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Inactive date</dt>
            <dd class="govuk-summary-list__value">@Model.InactiveDate.Value.ToString("d MMMM yyyy")</dd>
        </div>
    }
</dl>

<h2 class="govuk-heading-m">Contact details</h2>
<dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Contact name</dt>
        <dd class="govuk-summary-list__value">@Model.ContactName</dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Organisation</dt>
        <dd class="govuk-summary-list__value">@Model.Organisation</dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Address</dt>
        <dd class="govuk-summary-list__value">
            @Model.Address1<br />
            @Model.Address2<br />
            @Model.Address3<br />
            @Model.Address4<br />
            @Model.Address5
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Telephone</dt>
        <dd class="govuk-summary-list__value">@Model.Telephone</dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Fax</dt>
        <dd class="govuk-summary-list__value">@Model.Fax</dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Email</dt>
        <dd class="govuk-summary-list__value">@Model.Email</dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Alternative email</dt>
        <dd class="govuk-summary-list__value">@Model.Email2</dd>
    </div>
</dl>

<h2 class="govuk-heading-m">Other</h2>
<dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Comments</dt>
        <dd class="govuk-summary-list__value">@Model.Comments</dd>
    </div>
</dl>
