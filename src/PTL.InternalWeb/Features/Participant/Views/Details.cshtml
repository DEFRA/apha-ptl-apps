@model PTL.InternalWeb.Features.Participant.ParticipantDetailsViewModel
@{
    var participant = Model.Participant;
    ViewData["Title"] = $"Participant - {participant.LabName}";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@participant.LabName</h1>
    </div>
    <div class="govuk-grid-column-one-third govuk-!-text-align-right">
        <a class="govuk-button" data-module="govuk-button" asp-action="Edit" asp-route-id="@participant.ParticipantId">Edit participant</a>
    </div>
</div>

<h2 class="govuk-heading-m">Participant details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Lab code">@participant.LabCode</govuk-summary-row>
    <govuk-summary-row label="Lab name">@participant.LabName</govuk-summary-row>
    <govuk-summary-row label="Lab type">@Model.LabTypeName</govuk-summary-row>
    <govuk-summary-row label="Status">
        <strong class="govuk-tag @(participant.IsActive ? "govuk-tag--green" : "govuk-tag--grey")">
            @(participant.IsActive ? "Active" : "Inactive")
        </strong>
    </govuk-summary-row>
    @if (participant.InactiveDate is not null)
    {
        <govuk-summary-row label="Inactive date">@participant.InactiveDate.Value.ToString("d MMMM yyyy")</govuk-summary-row>
    }
</dl>

<h2 class="govuk-heading-m">Contact details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Contact name">@participant.ContactName</govuk-summary-row>
    <govuk-summary-row label="Organisation">@participant.Organisation</govuk-summary-row>
    <govuk-summary-row label="Address">
        @participant.Address1<br />
        @participant.Address2<br />
        @participant.Address3<br />
        @participant.Address4<br />
        @participant.Address5
    </govuk-summary-row>
    <govuk-summary-row label="Country">@Model.CountryName</govuk-summary-row>
    <govuk-summary-row label="Telephone">@participant.Telephone</govuk-summary-row>
    <govuk-summary-row label="Fax">@participant.Fax</govuk-summary-row>
    <govuk-summary-row label="Email">@participant.Email</govuk-summary-row>
    <govuk-summary-row label="Alternative email">@participant.Email2</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Other</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Other Packaging Requirements">@participant.Comments</govuk-summary-row>
</dl>
