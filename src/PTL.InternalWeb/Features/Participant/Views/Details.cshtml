@model PTL.Contracts.Participant.ParticipantResponse
@{
    ViewData["Title"] = $"Participant - {Model.LabName}";
}

<h1 class="govuk-heading-l">@Model.LabName</h1>

<p class="govuk-body">
    <a class="govuk-button" data-module="govuk-button" asp-action="Edit" asp-route-id="@Model.ParticipantId">Edit participant</a>
</p>

<h2 class="govuk-heading-m">Participant details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Lab code">@Model.LabCode</govuk-summary-row>
    <govuk-summary-row label="Lab name">@Model.LabName</govuk-summary-row>
    <govuk-summary-row label="Status">
        <strong class="govuk-tag @(Model.IsActive ? "govuk-tag--green" : "govuk-tag--grey")">
            @(Model.IsActive ? "Active" : "Inactive")
        </strong>
    </govuk-summary-row>
    @if (Model.InactiveDate is not null)
    {
        <govuk-summary-row label="Inactive date">@Model.InactiveDate.Value.ToString("d MMMM yyyy")</govuk-summary-row>
    }
</dl>

<h2 class="govuk-heading-m">Contact details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Contact name">@Model.ContactName</govuk-summary-row>
    <govuk-summary-row label="Organisation">@Model.Organisation</govuk-summary-row>
    <govuk-summary-row label="Address">
        @Model.Address1<br />
        @Model.Address2<br />
        @Model.Address3<br />
        @Model.Address4<br />
        @Model.Address5
    </govuk-summary-row>
    <govuk-summary-row label="Telephone">@Model.Telephone</govuk-summary-row>
    <govuk-summary-row label="Fax">@Model.Fax</govuk-summary-row>
    <govuk-summary-row label="Email">@Model.Email</govuk-summary-row>
    <govuk-summary-row label="Alternative email">@Model.Email2</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Other</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Other Packaging Requirements">@Model.Comments</govuk-summary-row>
</dl>
