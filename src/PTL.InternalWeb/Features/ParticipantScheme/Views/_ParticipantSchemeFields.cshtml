            // .govuk-checkboxes__input { opacity: 0 }) and draw the visible box/tick via the
            // adjacent .govuk-checkboxes__label's ::before/::after pseudo-elements, inside a
            // .govuk-checkboxes__item wrapper - a bare <input class="govuk-checkboxes__input">
            // with no wrapper/label is therefore genuinely invisible, not just unstyled. Every
            // month/override checkbox below must use this same div > div.item > input + label
            // structure already used further down this page for the plain checkbox fields.
        }
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">January</td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="DistributionMonthJan" class="govuk-checkboxes__input ptl-month-checkbox" disabled="@(Model.IsReadOnly || !Model.SchemeDistributionMonthJan || !Model.CanEditJan)" /><label class="govuk-checkboxes__label" asp-for="DistributionMonthJan"><span class="govuk-visually-hidden">Distribute in January</span></label></div></div></td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideJan" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideJan"><span class="govuk-visually-hidden">Is Override &mdash; January</span></label></div></div></td>
        </tr>
