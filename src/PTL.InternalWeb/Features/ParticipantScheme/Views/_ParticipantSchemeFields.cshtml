@model PTL.InternalWeb.Features.ParticipantScheme.ParticipantSchemeFormViewModel

<h2 class="govuk-heading-m">Distribution months</h2>
<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Month</th>
            <th scope="col" class="govuk-table__header">Distribute</th>
            <th scope="col" class="govuk-table__header">Is Override</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @{
