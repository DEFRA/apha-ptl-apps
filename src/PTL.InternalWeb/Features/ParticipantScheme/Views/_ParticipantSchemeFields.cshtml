        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">May</td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="DistributionMonthMay" class="govuk-checkboxes__input ptl-month-checkbox" disabled="@(Model.IsReadOnly || !Model.SchemeDistributionMonthMay || !Model.CanEditMay)" /><label class="govuk-checkboxes__label" asp-for="DistributionMonthMay"><span class="govuk-visually-hidden">Distribute in May</span></label></div></div></td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideMay" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideMay"><span class="govuk-visually-hidden">Is Override &mdash; May</span></label></div></div></td>
