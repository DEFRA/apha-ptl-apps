            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideJun" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideJun"><span class="govuk-visually-hidden">Is Override &mdash; June</span></label></div></div></td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">July</td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="DistributionMonthJul" class="govuk-checkboxes__input ptl-month-checkbox" disabled="@(Model.IsReadOnly || !Model.SchemeDistributionMonthJul || !Model.CanEditJul)" /><label class="govuk-checkboxes__label" asp-for="DistributionMonthJul"><span class="govuk-visually-hidden">Distribute in July</span></label></div></div></td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideJul" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideJul"><span class="govuk-visually-hidden">Is Override &mdash; July</span></label></div></div></td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">August</td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="DistributionMonthAug" class="govuk-checkboxes__input ptl-month-checkbox" disabled="@(Model.IsReadOnly || !Model.SchemeDistributionMonthAug || !Model.CanEditAug)" /><label class="govuk-checkboxes__label" asp-for="DistributionMonthAug"><span class="govuk-visually-hidden">Distribute in August</span></label></div></div></td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideAug" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideAug"><span class="govuk-visually-hidden">Is Override &mdash; August</span></label></div></div></td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">September</td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="DistributionMonthSep" class="govuk-checkboxes__input ptl-month-checkbox" disabled="@(Model.IsReadOnly || !Model.SchemeDistributionMonthSep || !Model.CanEditSep)" /><label class="govuk-checkboxes__label" asp-for="DistributionMonthSep"><span class="govuk-visually-hidden">Distribute in September</span></label></div></div></td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideSep" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideSep"><span class="govuk-visually-hidden">Is Override &mdash; September</span></label></div></div></td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">October</td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="DistributionMonthOct" class="govuk-checkboxes__input ptl-month-checkbox" disabled="@(Model.IsReadOnly || !Model.SchemeDistributionMonthOct || !Model.CanEditOct)" /><label class="govuk-checkboxes__label" asp-for="DistributionMonthOct"><span class="govuk-visually-hidden">Distribute in October</span></label></div></div></td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideOct" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideOct"><span class="govuk-visually-hidden">Is Override &mdash; October</span></label></div></div></td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">November</td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="DistributionMonthNov" class="govuk-checkboxes__input ptl-month-checkbox" disabled="@(Model.IsReadOnly || !Model.SchemeDistributionMonthNov || !Model.CanEditNov)" /><label class="govuk-checkboxes__label" asp-for="DistributionMonthNov"><span class="govuk-visually-hidden">Distribute in November</span></label></div></div></td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideNov" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideNov"><span class="govuk-visually-hidden">Is Override &mdash; November</span></label></div></div></td>
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">December</td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="DistributionMonthDec" class="govuk-checkboxes__input ptl-month-checkbox" disabled="@(Model.IsReadOnly || !Model.SchemeDistributionMonthDec || !Model.CanEditDec)" /><label class="govuk-checkboxes__label" asp-for="DistributionMonthDec"><span class="govuk-visually-hidden">Distribute in December</span></label></div></div></td>
            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideDec" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideDec"><span class="govuk-visually-hidden">Is Override &mdash; December</span></label></div></div></td>
