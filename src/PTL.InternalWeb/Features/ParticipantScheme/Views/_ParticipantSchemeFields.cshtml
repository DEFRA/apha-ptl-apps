            <td class="govuk-table__cell"><div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes"><div class="govuk-checkboxes__item"><input asp-for="IsOverrideFeb" class="govuk-checkboxes__input" disabled /><label class="govuk-checkboxes__label" asp-for="IsOverrideFeb"><span class="govuk-visually-hidden">Is Override &mdash; February</span></label></div></div></td>
        </tr>
        <tr class="govuk-table__row">
