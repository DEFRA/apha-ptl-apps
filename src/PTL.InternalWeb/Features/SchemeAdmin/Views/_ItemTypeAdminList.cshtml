@model PTL.InternalWeb.Features.SchemeAdmin.IItemTypeListViewModel
@using PTL.SharedUI.Pagination
@{
    // Shared by CategoryItemType.cshtml/TestType.cshtml/CriterionItemType.cshtml - see
    // IItemTypeListViewModel.cs remarks. Add/Edit inputs are hand-rolled (not asp-for) so this
    // partial has no compile-time dependency on any one entity's concrete view-model type.
    var pagination = new PaginationModel
    {
        CurrentPage = Model.Page,
        PageSize = Model.PageSize,
        TotalRecords = Model.TotalRecords,
        Action = Model.ActionName,
        RouteValues = new Dictionary<string, object?> { ["yearId"] = Model.SelectedYearId }
    };

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .ToList();

    string? FirstError(string field) =>
        ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0
            ? entry.Errors[0].ErrorMessage
            : null;

    var editingRow = Model.Rows.FirstOrDefault(r => r.IsEditing);
}

<h1 class="govuk-heading-l">@Model.PageHeading</h1>

<p class="govuk-body">@Model.PageDescription</p>

@if (Model.Message is not null)
{
    var bannerType = Model.MessageIsError ? "" : "govuk-notification-banner--success";
    <div class="govuk-notification-banner @bannerType" role="@(Model.MessageIsError ? "alert" : "region")" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">@(Model.MessageIsError ? "Important" : "Success")</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.Message</p>
        </div>
    </div>
}

<govuk-error-summary errors="@errors" />

<form method="get" asp-action="@Model.ActionName" class="govuk-!-margin-bottom-6">
    <div class="govuk-form-group govuk-!-margin-bottom-2">
        <label class="govuk-label" for="yearId">Select Year to Edit:</label>
        <select class="govuk-select" id="yearId" name="yearId" asp-items="Model.YearOptions" asp-for="SelectedYearId"></select>
        @* No auto-submit-on-change - View is the only, explicit trigger, so there's no WCAG 2.2
           SC 3.2.2 "automatic change of context" concern to mitigate for this control. *@
        <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-3" data-module="govuk-button" type="submit">View</button>
    </div>
</form>

<table class="govuk-table" style="table-layout: fixed; width: 100%;">
    @* Fixed column widths stop the table reflowing when the Actions column's details disclosure is opened. *@
    <colgroup>
        <col style="width: 35%" />
        <col style="width: 20%" />
        <col style="width: 45%" />
    </colgroup>
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">@Model.ColumnHeaderLabel</th>
            <th scope="col" class="govuk-table__header">No longer in use</th>
            <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @if (Model.Rows.Count == 0)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell" colspan="3">@Model.EmptyMessage</td>
            </tr>
        }
        @foreach (var row in Model.Rows)
        {
            <tr class="govuk-table__row">
                @if (row.IsEditing)
                {
                    <td class="govuk-table__cell">
                        <div class="govuk-form-group govuk-!-margin-bottom-0 @(FirstError("Edit.Name") is null ? "" : "govuk-form-group--error")">
                            <label class="govuk-visually-hidden" for="Edit_Name">@Model.ColumnHeaderLabel</label>
                            @if (FirstError("Edit.Name") is string nameError)
                            {
                                <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @nameError</p>
                            }
                            <input id="Edit_Name" form="@Model.EditFormId" name="Edit.Name" value="@row.Name" maxlength="@Model.EditNameMaxLength"
                                   class="govuk-input @(FirstError("Edit.Name") is null ? "" : "govuk-input--error")" />
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" type="checkbox" id="Edit.NoLongerInUse" form="@Model.EditFormId" name="Edit.NoLongerInUse" value="true" checked="@row.NoLongerInUse" />
                                <label class="govuk-label govuk-checkboxes__label" for="Edit.NoLongerInUse">No longer in use</label>
                            </div>
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        <button form="@Model.EditFormId" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button" type="submit">Save</button>
                        <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-action="@Model.ActionName" asp-route-yearId="@Model.SelectedYearId" asp-route-page="@Model.Page">Cancel</a>
                    </td>
                }
                else
                {
                    <td class="govuk-table__cell">@row.Name</td>
                    <td class="govuk-table__cell">
                        @* Bulk-saved together via #noLongerInUseBulkForm below - matches legacy's
                           page-level Save button, and the standard GOV.UK "select all that apply"
                           checkboxes pattern (one group, one submit), instead of a request per row.
                           The hidden id is unconditional so an unticked row is still set back to
                           false; only ticked boxes are ever submitted by the browser. *@
                        <input type="hidden" name="@Model.PageIdsFieldName" value="@row.ItemId" form="noLongerInUseBulkForm" />
                        <div class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-bottom-0" data-module="govuk-checkboxes">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" type="checkbox" id="NoLongerInUse_@row.ItemId" name="@Model.CheckedIdsFieldName" value="@row.ItemId" checked="@row.NoLongerInUse" form="noLongerInUseBulkForm" />
                                @* govuk-visually-hidden must go on a nested span, not the label itself - the visible
                                   checkbox box is a pseudo-element on the label, so hiding the label hides the box too. *@
                                <label class="govuk-label govuk-checkboxes__label" for="NoLongerInUse_@row.ItemId">
                                    <span class="govuk-visually-hidden">No longer in use - @row.Name</span>
                                </label>
                            </div>
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        @* Edit/Remove are always shown, matching legacy (which always shows the links too) - a
                           blocked attempt is rejected server-side and reported as a notification banner instead
                           of legacy's JavaScript alert(). The dependency reason is collapsed behind the
                           govuk-details disclosure below rather than standing text, so the Actions column stays
                           compact when the scheme list is long. *@
                        @if (row.IsConfirmingRemove)
                        {
                            <div class="govuk-warning-text govuk-!-margin-bottom-2">
                                <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                                <strong class="govuk-warning-text__text">
                                    <span class="govuk-visually-hidden">Warning</span>
                                    Are you sure you want to remove "@row.Name"? This cannot be undone.
                                </strong>
                            </div>
                            <div style="white-space: nowrap;">
                                <form method="post" asp-action="@Model.RemoveActionName" class="govuk-!-display-inline">
                                    <input type="hidden" name="@Model.RemoveIdRouteParamName" value="@row.ItemId" />
                                    <input type="hidden" name="yearId" value="@Model.SelectedYearId" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    <button class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button" type="submit">Yes, remove</button>
                                </form>
                                <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-action="@Model.ActionName" asp-route-yearId="@Model.SelectedYearId" asp-route-page="@Model.Page">Cancel</a>
                            </div>
                        }
                        else
                        {
                            <div style="white-space: nowrap;">
                                <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-action="@Model.ActionName" asp-route-yearId="@Model.SelectedYearId" asp-route-editId="@row.ItemId" asp-route-page="@Model.Page">Edit</a>
                                <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-action="@Model.ActionName" asp-route-yearId="@Model.SelectedYearId" asp-route-removeConfirmId="@row.ItemId" asp-route-page="@Model.Page">Remove</a>
                            </div>
                        }
                        @if (!row.CanEditOrRemove)
                        {
                            <details class="govuk-details govuk-!-margin-bottom-0 govuk-!-margin-top-1" data-module="govuk-details">
                                <summary class="govuk-details__summary">
                                    <span class="govuk-details__summary-text">Why can't this be edited or removed?</span>
                                </summary>
                                <div class="govuk-details__text">
                                    @(row.ForeignInstances == -1
                                        ? $"Used on a distribution and on the following Scheme(s): {row.ForeignInstancesString}."
                                        : $"Used on {row.ForeignInstances} Scheme(s): {row.ForeignInstancesString}.")
                                </div>
                            </details>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<govuk-pagination model="pagination" />

<form id="noLongerInUseBulkForm" method="post" asp-action="@Model.SaveAllNoLongerInUseActionName" class="govuk-!-margin-bottom-6">
    <input type="hidden" name="yearId" value="@Model.SelectedYearId" />
    <input type="hidden" name="page" value="@Model.Page" />
    @if (editingRow is not null)
    {
        <p class="govuk-hint govuk-!-margin-bottom-2">Save or cancel the row you're editing above before saving these changes.</p>
    }
    <button class="govuk-button" data-module="govuk-button" type="submit" disabled="@(editingRow is not null)">Save changes</button>
</form>

@if (editingRow is not null)
{
    @* Inputs/button for the editing row live in table cells above and bind here via the "form"
       attribute, since a <form> can't be split across multiple <td> elements. *@
    <form id="@Model.EditFormId" method="post" asp-action="@Model.SaveActionName" novalidate>
        <input type="hidden" name="@Model.EditIdFieldName" value="@editingRow.ItemId" />
        <input type="hidden" name="yearId" value="@Model.SelectedYearId" />
        <input type="hidden" name="page" value="@Model.Page" />
    </form>
}

<hr />

<h2 class="govuk-heading-m">@Model.AddHeading</h2>

<form method="post" asp-action="@Model.AddActionName">
    <input type="hidden" name="yearId" value="@Model.SelectedYearId" />
    <input type="hidden" name="page" value="@Model.Page" />
    @* Hand-rolled (not <govuk-input asp-for>) so this field renders correctly regardless of which
       entity's concrete Add view-model type is behind the shared IItemTypeListViewModel - mirrors
       the maxlength-less output the govuk-input tag helper already produced for Add.Name (unlike
       the Edit row above, Add.Name never carried an explicit maxlength attribute). *@
    <div class="govuk-form-group govuk-!-margin-bottom-4 @(FirstError("Add.Name") is null ? "" : "govuk-form-group--error")">
        <label class="govuk-label" for="Add_Name">@Model.AddNameLabel</label>
        @if (FirstError("Add.Name") is string addNameError)
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @addNameError</p>
        }
        <input id="Add_Name" name="Add.Name" value="@Model.AddName" class="govuk-input govuk-input--width-20 @(FirstError("Add.Name") is null ? "" : "govuk-input--error")" />
    </div>
    <div class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-bottom-4" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" type="checkbox" id="Add_NoLongerInUse" name="Add.NoLongerInUse" value="true" checked="@Model.AddNoLongerInUse" />
            <label class="govuk-label govuk-checkboxes__label" for="Add_NoLongerInUse">No longer in use</label>
        </div>
    </div>
    @if (editingRow is not null)
    {
        <p class="govuk-hint govuk-!-margin-bottom-2">Save or cancel the row you're editing above before adding a new item.</p>
    }
    <button class="govuk-button" data-module="govuk-button" type="submit" disabled="@(editingRow is not null)">Add</button>
</form>
