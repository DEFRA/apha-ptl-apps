@model PTL.InternalWeb.Features.Customer.PendingCustomerUpdateListViewModel
@{
    ViewData["Title"] = "Review Pending Customer Updates";
}

<h1 class="govuk-heading-l">Review Pending Customer Updates</h1>

@if (Model.Updates.Count == 0)
{
    <p class="govuk-body">There are no pending customer updates to review.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">QAL number</th>
                <th scope="col" class="govuk-table__header">Customer name</th>
                <th scope="col" class="govuk-table__header">Details</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var update in Model.Updates)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@update.QalNumber</td>
                    <td class="govuk-table__cell">@update.Name</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-action="PendingCustomerUpdateDetails" asp-route-customerId="@update.CustomerId">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
