@model PTL.Contracts.Customer.CustomerResponse
@{
    ViewData["Title"] = $"Customer - {Model.Name}";
}

<h1 class="govuk-heading-l">@Model.Name</h1>

<p class="govuk-body">
    <a class="govuk-button" data-module="govuk-button" asp-action="Edit" asp-route-id="@Model.CustomerId">Edit customer</a>
</p>

<h2 class="govuk-heading-m">Customer details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="QAL number">@Model.QalNumber</govuk-summary-row>
    <govuk-summary-row label="Registered file number">@Model.RegisteredFileNumber</govuk-summary-row>
    <govuk-summary-row label="Previous name">@Model.PreviousName</govuk-summary-row>
    <govuk-summary-row label="Status">
        <strong class="govuk-tag @(Model.IsActive ? "govuk-tag--green" : "govuk-tag--grey")">
            @(Model.IsActive ? "Active" : "Inactive")
        </strong>
    </govuk-summary-row>
    @if (Model.InactiveDate is not null)
    {
        <govuk-summary-row label="Inactive date">@Model.InactiveDate.Value.ToString("d MMMM yyyy")</govuk-summary-row>
    }
    <govuk-summary-row label="Initial start date">@Model.InitialStartDate.ToString("d MMMM yyyy")</govuk-summary-row>
    <govuk-summary-row label="Can order online">@(Model.CanOrderOnline ? "Yes" : "No")</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Contact details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Contact name">@Model.ContactName</govuk-summary-row>
    <govuk-summary-row label="Organisation">@Model.Organisation</govuk-summary-row>
    <govuk-summary-row label="Address">
        @Model.Address1<br />
        @Model.Address2<br />
        @Model.Address3<br />
        @Model.Address4<br />
        @Model.Address5
    </govuk-summary-row>
    <govuk-summary-row label="Telephone">@Model.Telephone</govuk-summary-row>
    <govuk-summary-row label="Telephone (alternative)">@Model.Telephone2</govuk-summary-row>
    <govuk-summary-row label="Fax">@Model.Fax</govuk-summary-row>
    <govuk-summary-row label="Email">@Model.Email</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Invoice details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Invoice name">@Model.InvoiceName</govuk-summary-row>
    <govuk-summary-row label="Invoice organisation">@Model.InvoiceOrganisation</govuk-summary-row>
    <govuk-summary-row label="Invoice address">
        @Model.InvoiceAddress1<br />
        @Model.InvoiceAddress2<br />
        @Model.InvoiceAddress3<br />
        @Model.InvoiceAddress4<br />
        @Model.InvoiceAddress5
    </govuk-summary-row>
    <govuk-summary-row label="Invoice telephone">@Model.InvoiceTelephone</govuk-summary-row>
    <govuk-summary-row label="Invoice telephone (alternative)">@Model.InvoiceTelephone2</govuk-summary-row>
    <govuk-summary-row label="Invoice fax">@Model.InvoiceFax</govuk-summary-row>
    <govuk-summary-row label="Invoice email">@Model.InvoiceEmail</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Financial details</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="VAT number">@Model.VatNumber</govuk-summary-row>
    <govuk-summary-row label="Account number">@Model.AccountNumber</govuk-summary-row>
    <govuk-summary-row label="Customer ID">@Model.CustomerFinanceId</govuk-summary-row>
    <govuk-summary-row label="Payment (non-UK)">@(Model.PaymentNonUK ? "Yes" : "No")</govuk-summary-row>
</dl>

<h2 class="govuk-heading-m">Other</h2>
<dl class="govuk-summary-list">
    <govuk-summary-row label="Postage arrangements">@Model.PostageArrangements</govuk-summary-row>
    <govuk-summary-row label="Comments">@Model.Comments</govuk-summary-row>
</dl>
