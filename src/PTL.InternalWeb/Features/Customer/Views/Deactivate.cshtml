@model PTL.InternalWeb.Features.Customer.DeactivateCustomerViewModel
@{
    ViewData["Title"] = "Deactivate customer";

    bool HasError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0;
    string? FirstError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    string FormGroupClass(string field) => HasError(field) ? "govuk-form-group govuk-form-group--error" : "govuk-form-group";
    string InputClass(string field) => HasError(field) ? "govuk-input govuk-input--error" : "govuk-input";
    string? DescribedBy(string field) => HasError(field) ? $"{field}-error" : null;

    var summaryErrors = ViewData.ModelState
        .SelectMany(entry => entry.Value!.Errors.Select(error => new { Field = entry.Key, error.ErrorMessage }))
        .ToList();
}

<a class="govuk-back-link" asp-action="Details" asp-route-id="@Model.CustomerId">Back to customer</a>

@if (!ViewData.ModelState.IsValid)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in summaryErrors)
                    {
                        <li>
                            @if (!string.IsNullOrEmpty(error.Field))
                            {
                                <a href="#@error.Field">@error.ErrorMessage</a>
                            }
                            else
                            {
                                @error.ErrorMessage
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<h1 class="govuk-heading-l">Deactivate @Model.Name</h1>

<div class="govuk-warning-text">
    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
    <strong class="govuk-warning-text__text">
        <span class="govuk-visually-hidden">Warning</span>
        This customer will be marked inactive and will no longer be available for transactional use.
    </strong>
</div>

<form asp-action="Deactivate" asp-route-id="@Model.CustomerId" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CustomerId" />
    <input type="hidden" asp-for="Name" />

    <div class="@FormGroupClass("CustomerStatusId")">
        <label class="govuk-label" asp-for="CustomerStatusId">Customer status (inactive reason)</label>
        <div class="govuk-hint">[NEEDS INVESTIGATION] no CustomerStatus lookup service yet - enter the CustomerStatus GUID directly.</div>
        @if (HasError("CustomerStatusId"))
        {
            <p id="CustomerStatusId-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("CustomerStatusId")</p>
        }
        <input class="@InputClass("CustomerStatusId")" asp-for="CustomerStatusId" aria-describedby="@DescribedBy("CustomerStatusId")" />
    </div>

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">Deactivate customer</button>
        <a class="govuk-link" asp-action="Details" asp-route-id="@Model.CustomerId">Cancel</a>
    </div>
</form>
