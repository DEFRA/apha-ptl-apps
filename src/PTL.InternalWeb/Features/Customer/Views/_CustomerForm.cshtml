@model PTL.InternalWeb.Features.Customer.CustomerFormViewModel
@{
    // Fixed field order matching the visual layout below, so the error summary links appear in
    // the same top-to-bottom order as the fields themselves rather than ModelState's insertion
    // order (which follows validation execution order, not the page layout).
    string[] fieldOrder =
    [
        "Name", "PreviousName", "CurrencyId", "PaymentNonUK", "CustomerTypeId", "VatNumber",
        "AccountNumber", "CustomerFinanceId", "VatRatingId", "RegisteredFileNumber", "CanOrderOnline",
        "IsActive", "CustomerStatusId",
        "ContactName", "Organisation", "Address1", "Address2", "Address3", "Address4", "Address5",
        "CountryId", "Telephone", "Telephone2", "Fax", "Email",
        "InvoiceName", "InvoiceOrganisation", "InvoiceAddress1", "InvoiceAddress2", "InvoiceAddress3",
        "InvoiceAddress4", "InvoiceAddress5", "InvoiceCountryId", "InvoiceTelephone", "InvoiceTelephone2",
        "InvoiceFax", "InvoiceEmail",
        "PostageArrangements", "Comments"
    ];

    // Hand-rolled to match the GOV.UK Design System error summary exactly (title + linked list),
    // since the built-in ValidationSummaryTagHelper doesn't produce that markup. Each link's href
    // matches the target input's id (rendered by asp-for), and govuk-frontend's bundled
    // "error-summary" JS module (initialised via initAll() in _Layout.cshtml) auto-focuses this
    // summary on load and moves focus to the linked field when a link is clicked.
    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .OrderBy(error => Array.IndexOf(fieldOrder, error.Field) is var idx && idx == -1 ? -1 : idx)
        .ToList();

    // Per-field GOV.UK error state (govuk-form-group--error / govuk-input--error / error message
    // paragraph / aria-describedby) - applied via these helpers instead of duplicating the same
    // ModelState lookup and markup for every one of the 40+ fields below.
    bool HasError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0;
    string? FirstError(string field) => ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    string FormGroupClass(string field) => HasError(field) ? "govuk-form-group govuk-form-group--error" : "govuk-form-group";
    string InputClass(string baseClass, string field) => HasError(field) ? $"{baseClass} {baseClass}--error" : baseClass;
    string? DescribedBy(string field) => HasError(field) ? $"{field}-error" : null;
}

<govuk-error-summary errors="@errors" />

@if (Model.CustomerId is not null)
{
    <input type="hidden" asp-for="CustomerId" />
    <div class="govuk-form-group">
        <p class="govuk-label govuk-label--s">QAL number</p>
        <p class="govuk-body">@Model.QalNumber</p>
    </div>
}

<h2 class="govuk-heading-m">Customer details</h2>

<govuk-input asp-for="Name" label="Name" />

<!-- Previous name is not editable on this page - kept as a hidden field so an existing value
     is preserved (not silently blanked) when other Customer details are saved. -->
<input type="hidden" asp-for="PreviousName" />

<div class="govuk-form-group">
    <label class="govuk-label" for="InitialStartDate">Initial start date</label>
    <div class="govuk-hint">Set automatically and cannot be changed.</div>
    <input id="InitialStartDate" class="govuk-input govuk-input--width-10" value="@Model.InitialStartDate?.ToString("d MMMM yyyy")" disabled />
</div>

<govuk-select asp-for="CurrencyId" label="Currency" asp-items="Model.CurrencyOptions" />

<div class="govuk-checkboxes__item">
    <input class="govuk-checkboxes__input" asp-for="PaymentNonUK" />
    <label class="govuk-label govuk-checkboxes__label" asp-for="PaymentNonUK">Payment (non-UK)</label>
</div>

<govuk-select asp-for="CustomerTypeId" label="Customer type" asp-items="Model.CustomerTypeOptions" />

<govuk-input asp-for="VatNumber" label="VAT number" />

<govuk-input asp-for="AccountNumber" label="Account number" />

<govuk-input asp-for="CustomerFinanceId" label="Customer ID" />

@if (Model.CustomerId is not null)
{
    <div class="govuk-form-group">
        <p class="govuk-label govuk-label--s">Customer ID</p>
        <p class="govuk-body">@Model.CustomerId</p>
    </div>
}

<govuk-select asp-for="VatRatingId" label="VAT rating" asp-items="Model.VatRatingOptions" />

<govuk-input asp-for="RegisteredFileNumber" label="Registered file number" hint="Format: QAL/nnnnn" />

<div class="govuk-checkboxes__item">
    <input class="govuk-checkboxes__input" asp-for="CanOrderOnline" />
    <label class="govuk-label govuk-checkboxes__label" asp-for="CanOrderOnline">Can order online</label>
</div>

<div class="govuk-checkboxes__item">
    <input class="govuk-checkboxes__input" asp-for="IsActive" id="IsActive" />
    <label class="govuk-label govuk-checkboxes__label" asp-for="IsActive">Active</label>
</div>

@if (Model.InactiveDate is not null)
{
    <div class="govuk-form-group">
        <label class="govuk-label" for="InactiveDateDisplay">Inactive from</label>
        <input class="govuk-input govuk-input--width-10" id="InactiveDateDisplay" value="@Model.InactiveDate.Value.ToString("d MMMM yyyy")" disabled />
    </div>
}

<!-- Customer status (inactive-error reason) is not editable on this page - kept as a hidden
     field so the existing value is preserved (required by CustomerValidator whenever the
     customer is inactive) when other Customer details are saved. -->
<input type="hidden" asp-for="CustomerStatusId" />

<h2 class="govuk-heading-m">Contact details</h2>

<govuk-input asp-for="ContactName" label="Contact name" />

<govuk-input asp-for="Organisation" label="Organisation" />

<govuk-input asp-for="Address1" label="Address line 1" />

<govuk-input asp-for="Address2" label="Address line 2" />

<govuk-input asp-for="Address3" label="Address line 3" />

<govuk-input asp-for="Address4" label="Address line 4" />

<govuk-input asp-for="Address5" label="Address line 5" />

<govuk-select asp-for="CountryId" label="Country" asp-items="Model.CountryOptions" />

<govuk-input asp-for="Telephone" label="Telephone" />

<govuk-input asp-for="Telephone2" label="Telephone (alternative)" />

<govuk-input asp-for="Fax" label="Fax" />

<govuk-input asp-for="Email" label="Email" />

<h2 class="govuk-heading-m">
    Invoice details
    <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-left-3" data-module="govuk-button" id="CopyFromContactButton">Copy from contact details</button>
</h2>

<govuk-input asp-for="InvoiceName" label="Invoice name" />

<govuk-input asp-for="InvoiceOrganisation" label="Invoice organisation" />

<govuk-input asp-for="InvoiceAddress1" label="Invoice address line 1" />

<govuk-input asp-for="InvoiceAddress2" label="Invoice address line 2" />

<govuk-input asp-for="InvoiceAddress3" label="Invoice address line 3" />

<govuk-input asp-for="InvoiceAddress4" label="Invoice address line 4" />

<govuk-input asp-for="InvoiceAddress5" label="Invoice address line 5" />

<govuk-select asp-for="InvoiceCountryId" label="Invoice country" asp-items="Model.InvoiceCountryOptions" />

<govuk-input asp-for="InvoiceTelephone" label="Invoice telephone" />

<govuk-input asp-for="InvoiceTelephone2" label="Invoice telephone (alternative)" />

<govuk-input asp-for="InvoiceFax" label="Invoice fax" />

<govuk-input asp-for="InvoiceEmail" label="Invoice email" />

<h2 class="govuk-heading-m">Other</h2>

<div class="@FormGroupClass("PostageArrangements")">
    <label class="govuk-label" asp-for="PostageArrangements">Postage arrangements</label>
    @if (HasError("PostageArrangements"))
    {
        <p id="PostageArrangements-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("PostageArrangements")</p>
    }
    <textarea class="@InputClass("govuk-textarea", "PostageArrangements")" asp-for="PostageArrangements" aria-describedby="@DescribedBy("PostageArrangements")"></textarea>
</div>

<div class="@FormGroupClass("Comments")">
    <label class="govuk-label" asp-for="Comments">Comments</label>
    @if (HasError("Comments"))
    {
        <p id="Comments-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @FirstError("Comments")</p>
    }
    <textarea class="@InputClass("govuk-textarea", "Comments")" asp-for="Comments" aria-describedby="@DescribedBy("Comments")"></textarea>
</div>

<script>
    // Mirrors legacy Customer.aspx.vb ButtonCopyDetails_Click - copies the Contact details
    // section straight into the Invoice details section, entirely client-side (no postback).
    document.getElementById('CopyFromContactButton').addEventListener('click', function () {
        document.getElementById('InvoiceName').value = document.getElementById('ContactName').value;
        document.getElementById('InvoiceOrganisation').value = document.getElementById('Organisation').value;
        document.getElementById('InvoiceAddress1').value = document.getElementById('Address1').value;
        document.getElementById('InvoiceAddress2').value = document.getElementById('Address2').value;
        document.getElementById('InvoiceAddress3').value = document.getElementById('Address3').value;
        document.getElementById('InvoiceAddress4').value = document.getElementById('Address4').value;
        document.getElementById('InvoiceAddress5').value = document.getElementById('Address5').value;
        document.getElementById('InvoiceCountryId').value = document.getElementById('CountryId').value;
        document.getElementById('InvoiceTelephone').value = document.getElementById('Telephone').value;
        document.getElementById('InvoiceTelephone2').value = document.getElementById('Telephone2').value;
        document.getElementById('InvoiceFax').value = document.getElementById('Fax').value;
        document.getElementById('InvoiceEmail').value = document.getElementById('Email').value;
    });
</script>

