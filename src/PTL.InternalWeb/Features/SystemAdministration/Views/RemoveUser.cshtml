@model PTL.InternalWeb.Features.SystemAdministration.RemoveUserViewModel
@{
    ViewData["Title"] = "Remove User";
}

<h1 class="govuk-heading-l">Remove User</h1>

@if (Model.IsRemoved)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="region" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.Message</p>
        </div>
    </div>

    <a class="govuk-button" data-module="govuk-button" asp-action="RemoveUser">Remove Another</a>
}
else
{
    @if (Model.Message is not null)
    {
        var bannerType = Model.MessageIsError ? "" : "govuk-notification-banner--success";
        <div class="govuk-notification-banner @bannerType" role="@(Model.MessageIsError ? "alert" : "region")" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">@(Model.MessageIsError ? "Important" : "Success")</h2>
            </div>
            <div class="govuk-notification-banner__content">
                <p class="govuk-notification-banner__heading">@Model.Message</p>
            </div>
        </div>
    }

    <form method="post" asp-action="RemoveUser">
        <govuk-select asp-for="SelectedUserId" label="Select an existing user" asp-items="Model.UserOptions" />

        <button class="govuk-button govuk-button--secondary" data-module="govuk-button" type="submit"
                onclick="return confirm('Are you sure you want to remove this user? This will revoke all of their application access.');">
            Remove User
        </button>
    </form>
}
