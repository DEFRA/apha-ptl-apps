@model PTL.InternalWeb.Features.SystemAdministration.ExternalSiteManagementViewModel
@{
    ViewData["Title"] = "External Site Management";

    string[] fieldOrder = ["Message", "ImportantMessage", "SupportEmailAddress"];

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .OrderBy(error => Array.IndexOf(fieldOrder, error.Field) is var idx && idx == -1 ? -1 : idx)
        .ToList();
}

<h1 class="govuk-heading-l">External Site Management</h1>

<govuk-error-summary errors="@errors" />

<form method="post" asp-action="ExternalSiteManagement" novalidate>
    <govuk-rich-text asp-for="Message" label="Further Information message" hint="Update content of Further Information screen on External site." height="400" />

    <govuk-rich-text asp-for="ImportantMessage" label="Important Message"
                     hint="A section to provide an urgent message on the external site homepage. Clearing this field and saving removes the message from the external site (max 500 characters)."
                     height="400" />

    <govuk-input asp-for="SupportEmailAddress" label="Edit error screen email address" />

    <div class="govuk-button-group">
        <button class="govuk-button" data-module="govuk-button" type="submit">Save</button>
        <button class="govuk-button govuk-button--secondary" data-module="govuk-button" type="submit" form="external-site-cancel-form">Cancel</button>
    </div>
</form>

@* Cancel is a button of this separate GET form (via the form attribute); it can't be nested in the POST form above. *@
<form id="external-site-cancel-form" method="get" asp-action="Index"></form>

@section Scripts {
    <script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>
    <script src="~/js/ptl-rich-text-editor.js" asp-append-version="true"></script>
}
