@using System.Globalization
@using PTL.InternalWeb.Features.SystemAdministration
@model PTL.InternalWeb.Features.SystemAdministration.InternalTestConsultantDepartmentViewModel
@{
    ViewData["Title"] = "Internal Test Consultant Department";

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .ToList();

    string? FirstError(string field) =>
        ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0
            ? entry.Errors[0].ErrorMessage
            : null;

    string ButtonUrl(string command, int? rowIndex = null) =>
        Url.Action("InternalTestConsultantDepartment", new { command, rowIndex })!;
}

<h1 class="govuk-heading-l">Internal Test Consultant Department</h1>

@if (Model.Message is not null && Model.MessageIsError)
{
    <div class="govuk-notification-banner" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Important</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.Message</p>
        </div>
    </div>
}

<govuk-error-summary errors="@errors" />

@* One form for the whole page: every button below posts the full pending list (Rows[i].*), so nothing is
   written until Save. *@
<form method="post" asp-action="InternalTestConsultantDepartment">
    @* First submit button in the form, so Enter in the Department box runs "submit" instead of the first row's Edit button. *@
    <button type="submit" class="govuk-visually-hidden" tabindex="-1" aria-hidden="true" formaction="@ButtonUrl(PendingListCommands.Submit)">Submit</button>

    @if (Model.EditIndex is { } editIndex)
    {
        <input type="hidden" name="EditIndex" value="@editIndex" />
    }

    @for (var i = 0; i < Model.Rows.Count; i++)
    {
        var hiddenRow = Model.Rows[i];
        <input type="hidden" name="Rows[@i].UserId" value="@(hiddenRow.UserId?.ToString() ?? string.Empty)" />
        <input type="hidden" name="Rows[@i].Username" value="@hiddenRow.Username" />
        <input type="hidden" name="Rows[@i].FriendlyName" value="@hiddenRow.FriendlyName" />
        <input type="hidden" name="Rows[@i].Department" value="@hiddenRow.Department" />
        <input type="hidden" name="Rows[@i].IsInactive" value="@(hiddenRow.IsInactive ? "true" : "false")" />
        <input type="hidden" name="Rows[@i].InactiveDate" value="@(hiddenRow.InactiveDate?.ToString("yyyy-MM-dd'T'HH:mm:ss", CultureInfo.InvariantCulture) ?? string.Empty)" />
    }

    <table id="Rows" class="govuk-table" tabindex="-1">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Username</th>
                <th scope="col" class="govuk-table__header">Name</th>
                <th scope="col" class="govuk-table__header">Department</th>
                <th scope="col" class="govuk-table__header">Inactive Date</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header">Actions</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @if (Model.Rows.Count == 0)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell" colspan="6">There are no Internal Test Consultants to display.</td>
                </tr>
            }
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                var row = Model.Rows[i];
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@row.Username</td>
                    <td class="govuk-table__cell">@row.FriendlyName</td>
                    @if (row.IsEditing)
                    {
                        var departmentError = FirstError("Edit.Department");
                        <td class="govuk-table__cell">
                            <div class="govuk-form-group govuk-!-margin-bottom-0 @(departmentError is null ? "" : "govuk-form-group--error")">
                                <label class="govuk-visually-hidden" for="Edit_Department">Department for @row.FriendlyName</label>
                                @if (departmentError is not null)
                                {
                                    <p id="Edit_Department-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @departmentError</p>
                                }
                                <input id="Edit_Department" name="Edit.Department" value="@Model.Edit.Department" maxlength="50"
                                       class="govuk-input @(departmentError is null ? "" : "govuk-input--error")"
                                       aria-describedby="@(departmentError is null ? null : "Edit_Department-error")" />
                            </div>
                        </td>
                    }
                    else
                    {
                        <td class="govuk-table__cell">@row.Department</td>
                    }
                    <td class="govuk-table__cell">@(row.IsInactive && row.InactiveDate is { } inactiveDate ? inactiveDate.ToString("d MMM yyyy", CultureInfo.CurrentCulture) : "")</td>
                    <td class="govuk-table__cell">
                        <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" type="submit" formnovalidate formaction="@ButtonUrl(PendingListCommands.Toggle, i)">@(row.IsInactive ? "Inactive" : "Active")<span class="govuk-visually-hidden"> - select to make @row.FriendlyName @(row.IsInactive ? "active" : "inactive")</span></button>
                    </td>
                    <td class="govuk-table__cell">
                        <div class="govuk-button-group govuk-!-margin-bottom-0">
                            @if (row.IsEditing)
                            {
                                <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" type="submit" formaction="@ButtonUrl(PendingListCommands.Update, i)">Save<span class="govuk-visually-hidden"> department for @row.FriendlyName</span></button>
                                <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" type="submit" formnovalidate formaction="@ButtonUrl(PendingListCommands.CancelEdit, i)">Cancel<span class="govuk-visually-hidden"> editing department for @row.FriendlyName</span></button>
                            }
                            else
                            {
                                <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" type="submit" formnovalidate formaction="@ButtonUrl(PendingListCommands.Edit, i)">Edit<span class="govuk-visually-hidden"> department for @row.FriendlyName</span></button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <div class="govuk-button-group">
        <button class="govuk-button" data-module="govuk-button" type="submit" formaction="@ButtonUrl(PendingListCommands.Save)">Save</button>
        <button class="govuk-button govuk-button--secondary" data-module="govuk-button" type="submit" formnovalidate formaction="@ButtonUrl(PendingListCommands.Cancel)">Cancel</button>
    </div>
</form>
