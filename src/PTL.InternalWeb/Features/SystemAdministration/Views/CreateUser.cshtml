@model PTL.InternalWeb.Features.SystemAdministration.CreateUserViewModel
@{
    ViewData["Title"] = "Create user";

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .ToList();
}

@if (Model.IsCreated)
{
    <h1 class="govuk-heading-l">Create user</h1>

    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.Message</p>
        </div>
    </div>

    <div class="govuk-button-group">
        <a class="govuk-button" role="button" draggable="false" data-module="govuk-button" asp-action="CreateUser">Create another user</a>
        <a class="govuk-button govuk-button--secondary" role="button" draggable="false" data-module="govuk-button" asp-action="ManageUserRoles">Set up roles</a>
    </div>
}
else
{
    <govuk-error-summary errors="@errors" />

    <h1 class="govuk-heading-l">Create user</h1>

    <form method="post" asp-action="CreateUserSearch">
        <govuk-input asp-for="SearchTerm" label="Search for a user"
                      hint="Enter an employee number (for example, m123456), first name or last name." />
        <button class="govuk-button" data-module="govuk-button" type="submit">Search</button>
    </form>

    @if (Model.Message is not null)
    {
        <div class="govuk-inset-text">@Model.Message</div>
    }

    @if (Model.HasSearched && Model.ResultOptions.Count > 0)
    {
        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />

        <form method="post" asp-action="CreateUserConfirm">
            @* Explicit id: the search form above already owns id="SearchTerm". *@
            <input type="hidden" asp-for="SearchTerm" id="SearchTermForCreate" />
            <govuk-select asp-for="SelectedCandidate" label="Select a user" asp-items="Model.ResultOptions" />
            <govuk-input asp-for="Department" label="Department" maxlength="50" />
            <button class="govuk-button" data-module="govuk-button" type="submit">Create user</button>
        </form>
    }
}
