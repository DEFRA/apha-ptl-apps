@model PTL.InternalWeb.Features.SystemAdministration.PostagePricingPlanViewModel
@{
    ViewData["Title"] = "Postage Pricing Plan";

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .ToList();

    string? FirstError(string field) =>
        ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0
            ? entry.Errors[0].ErrorMessage
            : null;

    var editingRow = Model.Rows.FirstOrDefault(r => r.IsEditing);
}

<h1 class="govuk-heading-l">Postage Pricing Plan</h1>

@if (Model.Message is not null)
{
    var bannerType = Model.MessageIsError ? "" : "govuk-notification-banner--success";
    <div class="govuk-notification-banner @bannerType" role="@(Model.MessageIsError ? "alert" : "region")" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">@(Model.MessageIsError ? "Important" : "Success")</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.Message</p>
        </div>
    </div>
}

@if (Model.HasNoYears)
{
    return;
}

<govuk-error-summary errors="@errors" />

<form method="get" asp-action="PostagePricingPlan" class="govuk-!-margin-bottom-6">
    <div class="govuk-form-group">
        <label class="govuk-label" for="yearId">Select a financial year:</label>
        <select class="govuk-select" id="yearId" name="yearId" onchange="this.form.submit()" asp-items="Model.YearOptions" asp-for="SelectedYearId"></select>
    </div>
</form>

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Postage Type</th>
            <th scope="col" class="govuk-table__header">UK</th>
            <th scope="col" class="govuk-table__header">EU</th>
            <th scope="col" class="govuk-table__header">Non-EU</th>
            <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var row in Model.Rows)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@row.DisplayName</td>
                @if (row.IsEditing)
                {
                    <td class="govuk-table__cell">
                        <div class="govuk-form-group govuk-!-margin-bottom-0 @(FirstError("UKPrice") is null ? "" : "govuk-form-group--error")">
                            <label class="govuk-visually-hidden" for="UKPrice">@row.DisplayName UK price</label>
                            @if (FirstError("UKPrice") is string ukError)
                            {
                                <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @ukError</p>
                            }
                            <input id="UKPrice" form="postagePriceEditForm" name="UKPrice" value="@row.UKPrice" class="govuk-input govuk-input--width-5 @(FirstError("UKPrice") is null ? "" : "govuk-input--error")" />
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        <div class="govuk-form-group govuk-!-margin-bottom-0 @(FirstError("EUPrice") is null ? "" : "govuk-form-group--error")">
                            <label class="govuk-visually-hidden" for="EUPrice">@row.DisplayName EU price</label>
                            @if (FirstError("EUPrice") is string euError)
                            {
                                <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @euError</p>
                            }
                            <input id="EUPrice" form="postagePriceEditForm" name="EUPrice" value="@row.EUPrice" class="govuk-input govuk-input--width-5 @(FirstError("EUPrice") is null ? "" : "govuk-input--error")" />
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        <div class="govuk-form-group govuk-!-margin-bottom-0 @(FirstError("NonEUPrice") is null ? "" : "govuk-form-group--error")">
                            <label class="govuk-visually-hidden" for="NonEUPrice">@row.DisplayName Non-EU price</label>
                            @if (FirstError("NonEUPrice") is string nonEuError)
                            {
                                <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @nonEuError</p>
                            }
                            <input id="NonEUPrice" form="postagePriceEditForm" name="NonEUPrice" value="@row.NonEUPrice" class="govuk-input govuk-input--width-5 @(FirstError("NonEUPrice") is null ? "" : "govuk-input--error")" />
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        <button form="postagePriceEditForm" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button" type="submit">Save</button>
                        <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-action="PostagePricingPlan" asp-route-yearId="@Model.SelectedYearId">Cancel</a>
                    </td>
                }
                else
                {
                    <td class="govuk-table__cell">@row.UKPrice.ToString("N2")</td>
                    <td class="govuk-table__cell">@row.EUPrice.ToString("N2")</td>
                    <td class="govuk-table__cell">@row.NonEUPrice.ToString("N2")</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-action="PostagePricingPlan" asp-route-yearId="@Model.SelectedYearId" asp-route-editId="@row.PostageId">Edit</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (editingRow is not null)
{
    @* Inputs/button for the editing row live in table cells above and bind here via the "form" attribute,
       since a <form> can't be split across multiple <td> elements. *@
    <form id="postagePriceEditForm" method="post" asp-action="PostagePricingPlanSave" novalidate>
        <input type="hidden" name="PostageId" value="@editingRow.PostageId" />
        <input type="hidden" name="YearId" value="@editingRow.YearId" />
    </form>
}

@if (Model.CanRenew)
{
    <form method="post" asp-action="PostagePricingPlanRenew" class="govuk-!-margin-top-6">
        <input type="hidden" name="yearId" value="@Model.SelectedYearId" />
        <button class="govuk-button" data-module="govuk-button" type="submit"
                onclick="return confirm('Are you sure that you want to renew the pricing plan?');">
            Renew pricing plan for financial year @Model.NextYearLabel
        </button>
    </form>
}
