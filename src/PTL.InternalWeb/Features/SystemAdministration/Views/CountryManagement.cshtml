@model PTL.InternalWeb.Features.SystemAdministration.CountryManagementViewModel
@{
    ViewData["Title"] = "Manage Countries";

    var errors = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .SelectMany(entry => entry.Value!.Errors.Select(error => (Field: entry.Key, Message: error.ErrorMessage)))
        .ToList();

    string? FirstError(string field) =>
        ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0
            ? entry.Errors[0].ErrorMessage
            : null;

    var editingRow = Model.Rows.FirstOrDefault(r => r.IsEditing);
}

<h1 class="govuk-heading-l">Manage Countries</h1>

@if (Model.Message is not null)
{
    var bannerType = Model.MessageIsError ? "" : "govuk-notification-banner--success";
    <div class="govuk-notification-banner @bannerType" role="@(Model.MessageIsError ? "alert" : "region")" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">@(Model.MessageIsError ? "Important" : "Success")</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.Message</p>
        </div>
    </div>
}

<govuk-error-summary errors="@errors" />

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Name</th>
            <th scope="col" class="govuk-table__header">Country Type</th>
            <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @if (Model.Rows.Count == 0)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell" colspan="3">There are no Countries to display.</td>
            </tr>
        }
        @foreach (var row in Model.Rows)
        {
            <tr class="govuk-table__row">
                @if (row.IsEditing)
                {
                    <td class="govuk-table__cell">
                        <div class="govuk-form-group govuk-!-margin-bottom-0 @(FirstError("Edit.Country") is null ? "" : "govuk-form-group--error")">
                            <label class="govuk-visually-hidden" for="Edit.Country">Country name</label>
                            @if (FirstError("Edit.Country") is string nameError)
                            {
                                <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @nameError</p>
                            }
                            <input id="Edit.Country" form="countryEditForm" name="Edit.Country" value="@row.Country" maxlength="50"
                                   class="govuk-input @(FirstError("Edit.Country") is null ? "" : "govuk-input--error")" />
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        <div class="govuk-form-group govuk-!-margin-bottom-0 @(FirstError("Edit.CountryTypeId") is null ? "" : "govuk-form-group--error")">
                            <label class="govuk-visually-hidden" for="Edit.CountryTypeId">Country type</label>
                            @if (FirstError("Edit.CountryTypeId") is string typeError)
                            {
                                <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @typeError</p>
                            }
                            <select id="Edit.CountryTypeId" form="countryEditForm" name="Edit.CountryTypeId"
                                    class="govuk-select @(FirstError("Edit.CountryTypeId") is null ? "" : "govuk-select--error")">
                                @foreach (var option in Model.CountryTypeOptions)
                                {
                                    <option value="@option.Value" selected="@(option.Value == row.CountryTypeId.ToString())">@option.Text</option>
                                }
                            </select>
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        <button form="countryEditForm" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button" type="submit">Save</button>
                        <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-action="CountryManagement">Cancel</a>
                    </td>
                }
                else
                {
                    <td class="govuk-table__cell">@row.Country</td>
                    <td class="govuk-table__cell">@row.CountryType</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-action="CountryManagement" asp-route-editId="@row.CountryId">Edit</a>
                        <form method="post" asp-action="CountryManagementRemove" class="govuk-!-display-inline">
                            <input type="hidden" name="countryId" value="@row.CountryId" />
                            <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" type="submit"
                                    onclick="return confirm('Are you sure that you want to remove this country?');">
                                Remove
                            </button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (editingRow is not null)
{
    @* Inputs/button for the editing row live in table cells above and bind here via the "form"
       attribute, since a <form> can't be split across multiple <td> elements. *@
    <form id="countryEditForm" method="post" asp-action="CountryManagementSave" novalidate>
        <input type="hidden" name="Edit.CountryId" value="@editingRow.CountryId" />
    </form>
}

<hr />

<h2 class="govuk-heading-m">Add a country</h2>

<form method="post" asp-action="CountryManagementAdd">
    <govuk-input asp-for="Add.Country" label="Name" input-class="govuk-input govuk-input--width-20" />
    <govuk-select asp-for="Add.CountryTypeId" label="Country Type" asp-items="Model.CountryTypeOptions" />
    <button class="govuk-button" data-module="govuk-button" type="submit">Add</button>
</form>
