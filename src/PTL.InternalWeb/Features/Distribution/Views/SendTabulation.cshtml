@model PTL.InternalWeb.Features.Distribution.TabulationSendViewModel
@{
    // Replaces legacy Tabulations.aspx's confirm() dialog before a Send action.
    ViewData["Title"] = Model.Send.ActionText;
    var isDiscardWarning = Model.Send.ConfirmationQuestion.Contains("Discard", StringComparison.Ordinal);
}

@* A GET back would drop earlier staged sends; Cancel keeps them. *@
@if (Model.Staged.Count == 0)
{
    <a class="govuk-back-link" asp-action="Tabulations" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId">Back</a>
}

<span class="govuk-caption-l">@Model.Send.DistributionReferenceFull @Model.Send.SchemeNameFull</span>

@if (isDiscardWarning)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <h1 class="govuk-heading-l govuk-warning-text__text govuk-!-margin-bottom-0">
            <span class="govuk-visually-hidden">Warning</span>
            @Model.Send.ConfirmationQuestion
        </h1>
    </div>
}
else
{
    <h1 class="govuk-heading-l">@Model.Send.ConfirmationQuestion</h1>
}

<form method="post" asp-action="Tabulations" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" novalidate>
    <input type="hidden" name="stage" value="@($"{Model.Send.MonthlyDistributionSchemeId}:{Model.Send.Command}")" />
    <input type="hidden" name="confirmed" value="true" />
    @foreach (var s in Model.Staged)
    {
        <input type="hidden" name="staged" value="@($"{s.MonthlyDistributionSchemeId}:{s.Command}")" />
    }

    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">OK</button>
        @* Belongs to the form below so only the earlier staged sends go back. *@
        <button type="submit" form="send-tabulation-cancel" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</button>
    </div>
</form>

<form id="send-tabulation-cancel" method="post" asp-action="Tabulations" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" novalidate>
    @foreach (var s in Model.Staged)
    {
        <input type="hidden" name="staged" value="@($"{s.MonthlyDistributionSchemeId}:{s.Command}")" />
    }
</form>
