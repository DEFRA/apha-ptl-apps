@using System.Globalization
@using PTL.Contracts.Distribution
@model PTL.InternalWeb.Features.Distribution.TabulationsViewModel
@{
    ViewData["Title"] = $"Monthly Distributions - {Model.MonthDescription}";
    var shortDate = "dd/MM/yyyy";
    var culture = CultureInfo.InvariantCulture;

    // Legacy tooltips that only restate the link or button: its own text plus hidden context replaces them.
    var restatingHints = new HashSet<string>(StringComparer.Ordinal)
    {
        "Click to Amend the Results for this Distribution.",
        "Click to view the Tabulation Comments",
        "Click to view the Test Consultant's Comments",
        "Send these results to the Test Consultant for comments",
        "Send this distribution for assessment",
        "Send this Distribution's Tabulation(s) for Results Sign-Off",
    };

    var sendCommands = new HashSet<string>(StringComparer.Ordinal) { "SendToTestConsultant", "SendForAssessment", "SendToResultsSignOff" };

    // Legacy action state is computed server-side; this only renders it. What an enabled action does
    // comes from Command, not Text. schemeAction names a built page that takes year/monthId/schemeId;
    // Amend Results is identified by its slot (its Command is "None"), so the caller passes it.
    // shownHints stops a scheme repeating the same hint under each of its actions.
    async Task RenderAction(TabulationActionResponse action, string schemeName, Guid schemeId, HashSet<string> shownHints, string? schemeAction = null)
    {
        var isActionable = action.IsEnabled && !action.IsLabel;
        var showHint = !string.IsNullOrEmpty(action.Hint)
            && !(isActionable && restatingHints.Contains(action.Hint))
            && shownHints.Add(action.Hint);
        schemeAction = action.Command == "ViewComments" ? "ViewComments" : schemeAction;
        var linkClass = action.IsOverdue ? "govuk-link ptl-link--overdue" : "govuk-link";

        <li>
            @if (isActionable && schemeAction is not null)
            {
                <a class="@linkClass" asp-action="@schemeAction" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" asp-route-schemeId="@schemeId">@action.Text<span class="govuk-visually-hidden"> for @schemeName</span></a>
            }
            else if (isActionable && sendCommands.Contains(action.Command))
            {
                <button type="submit" name="stage" value="@($"{schemeId}:{action.Command}")" class="@linkClass ptl-link-button">@action.Text<span class="govuk-visually-hidden"> for @schemeName</span></button>
            }
            else if (action.IsOverdue)
            {
                <strong class="govuk-tag govuk-tag--red">@action.Text</strong>
            }
            else
            {
                @action.Text
            }
            @if (showHint)
            {
                <div class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-0">@action.Hint</div>
            }
        </li>
    }
}

<h1 class="govuk-heading-l">Monthly Distributions - @Model.MonthDescription</h1>

@* One form so the staged sends (legacy kept them in Session) round-trip until Save. *@
<form method="post" asp-action="Tabulations" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" novalidate>
@foreach (var s in Model.Staged)
{
    <input type="hidden" name="staged" value="@($"{s.MonthlyDistributionSchemeId}:{s.Command}")" />
}

<p class="govuk-body">The table below lists the Tabulations that are available for each of this month's Distributions.</p>

@if (Model.Schemes.Count == 0)
{
    <p class="govuk-body">There are no schemes set to be distributed this month.</p>
}

@foreach (var scheme in Model.Schemes)
{
    var consultantsHeading = scheme.RequiresAssessment ? "Assessors" : "Test Consultants";
    var hasTestConsultantRow = scheme.Tabulations.Any(t => t.IsTestConsultant);
    var shownHints = new HashSet<string>(StringComparer.Ordinal);

    <div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <h2 class="govuk-heading-m govuk-!-margin-bottom-2">@scheme.SchemeNameFull</h2>
            </div>
            <div class="govuk-grid-column-one-half">
                <p class="govuk-body govuk-!-font-weight-bold govuk-!-text-align-right">@scheme.DistributionReferenceFull</p>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <p class="govuk-body">Deadline Date: @scheme.DeadlineDate.ToString(shortDate, culture)</p>
            </div>
            <div class="govuk-grid-column-one-half">
                <p class="govuk-body govuk-!-text-align-right">Results Date: @scheme.ResultsIssueTargetDate.ToString(shortDate, culture)</p>
            </div>
        </div>

        <div class="govuk-grid-row ptl-tabulations-row">
            <div class="govuk-grid-column-one-third">
                <h3 class="govuk-heading-s">@consultantsHeading</h3>
                <ol class="govuk-list">
                    @for (var i = 0; i < scheme.Consultants.Count; i++)
                    {
                        <li>@(i + 1). @scheme.Consultants[i]</li>
                    }
                </ol>
            </div>

            <div class="govuk-grid-column-one-third ptl-tabulations-column">
                <h3 class="govuk-heading-s">Tabulations</h3>
                @if (scheme.Tabulations.Count == 0)
                {
                    <p class="govuk-body">The Sample Numbers have not yet been defined</p>
                }
                else
                {
                    <table class="govuk-table">
                        <caption class="govuk-table__caption govuk-visually-hidden">Tabulations for @scheme.SchemeNameFull</caption>
                        <thead class="govuk-table__head govuk-visually-hidden">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Test Consultant</th>
                                <th scope="col" class="govuk-table__header">Tabulation</th>
                                <th scope="col" class="govuk-table__header">Issued</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var tabulation in scheme.Tabulations)
                            {
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">
                                        @if (tabulation.IsTestConsultant)
                                        {
                                            <strong class="govuk-tag govuk-tag--grey">TC</strong>
                                        }
                                    </td>
                                    <td class="govuk-table__cell">
                                        <a class="govuk-link" asp-action="Tabulation" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" asp-route-tabulationId="@tabulation.TabulationId">@tabulation.Name<span class="govuk-visually-hidden"> tabulation for @scheme.SchemeNameFull</span></a>
                                    </td>
                                    <td class="govuk-table__cell">
                                        @if (tabulation.PublishCount > 0)
                                        {
                                            <a class="govuk-link" asp-action="PublishedTabulations" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" asp-route-tabulationId="@tabulation.TabulationId">Issued (@tabulation.PublishCount)<span class="govuk-visually-hidden"> for @tabulation.Name, @scheme.SchemeNameFull</span></a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (hasTestConsultantRow)
                    {
                        <div class="govuk-hint govuk-!-font-size-16">This is the Tabulation that will be commented upon by the Test Consultant</div>
                    }
                }
            </div>

            <div class="govuk-grid-column-one-third">
                <h3 class="govuk-heading-s">Actions</h3>
                <ul class="govuk-list">
                    @{ await RenderAction(scheme.Actions.AmendResults, scheme.SchemeNameFull, scheme.MonthlyDistributionSchemeId, shownHints, "AmendResults"); }
                </ul>
                <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
                <ul class="govuk-list">
                    @if (scheme.RequiresAssessment)
                    {
                        await RenderAction(scheme.Actions.SendForAssessment, scheme.SchemeNameFull, scheme.MonthlyDistributionSchemeId, shownHints);
                    }
                    else
                    {
                        await RenderAction(scheme.Actions.SendToTestConsultant, scheme.SchemeNameFull, scheme.MonthlyDistributionSchemeId, shownHints);
                    }
                    @{ await RenderAction(scheme.Actions.SendToResultsSignOff, scheme.SchemeNameFull, scheme.MonthlyDistributionSchemeId, shownHints); }
                </ul>
            </div>
        </div>
    </div>

    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
}

@if (Model.Staged.Count > 0)
{
    <div class="govuk-inset-text">You have changes that have not been saved. Select Save to keep them.</div>
}

<div class="govuk-button-group">
    <button type="submit" name="command" value="save" class="govuk-button" data-module="govuk-button">Save</button>
    <button type="submit" name="command" value="cancel" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</button>
</div>
</form>
