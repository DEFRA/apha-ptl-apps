@model PTL.InternalWeb.Features.Distribution.PreparationViewModel
@{
    ViewData["Title"] = $"Sample Preparation - {Model.MonthDescription}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/printable-scheme.css" />
}

<a class="govuk-back-link noprint" asp-action="Index" asp-route-year="@Model.YearId">Back</a>

<h1 class="govuk-heading-l">Sample Preparation - @Model.MonthDescription</h1>

<form method="post" asp-action="Preparation" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="YearId" />
    <input type="hidden" asp-for="MonthId" />
    <input type="hidden" asp-for="MonthDescription" />

    @if (Model.Schemes.Count == 0)
    {
        <p class="govuk-body">There are no Schemes to prepare this month.</p>
    }
    else
    {
        <table class="govuk-table" id="preparation-table">
            <caption class="govuk-table__caption govuk-visually-hidden">Sample Preparation by Scheme</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header noprint">
                        Print
                        <div class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-top-1" data-module="govuk-checkboxes">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" type="checkbox" id="preparation-print-select-all" />
                                <label class="govuk-label govuk-checkboxes__label" for="preparation-print-select-all">
                                    <span class="govuk-visually-hidden">Select all schemes for printing</span>
                                </label>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="govuk-table__header">Scheme</th>
                    <th scope="col" class="govuk-table__header">No. Of Sets</th>
                    <th scope="col" class="govuk-table__header">Diary Entry</th>
                    <th scope="col" class="govuk-table__header">Prep. Started</th>
                    <th scope="col" class="govuk-table__header">Prep. Completed</th>
                    <th scope="col" class="govuk-table__header noprint">Results</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @for (var i = 0; i < Model.Schemes.Count; i++)
                {
                    var scheme = Model.Schemes[i];
                    <input type="hidden" asp-for="Schemes[i].MonthlyDistributionSchemeId" />

                    <tr class="govuk-table__row ptl-preparation-row" data-scheme-index="@i">
                        <td class="govuk-table__cell noprint">
                            @{
                                var printId = Html.IdFor(m => m.Schemes[i].Selected);
                            }
                            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input ptl-preparation-print-checkbox" type="checkbox" id="@printId" asp-for="Schemes[i].Selected" />
                                    <label class="govuk-label govuk-checkboxes__label" for="@printId">
                                        <span class="govuk-visually-hidden">Select @scheme.SchemeHeading for printing</span>
                                    </label>
                                </div>
                            </div>
                        </td>
                        <th scope="row" class="govuk-table__header">
                            <h2 class="govuk-heading-s govuk-!-margin-bottom-2">@scheme.SchemeHeading</h2>
                            <p class="govuk-body govuk-!-margin-bottom-2">@scheme.SamplePackingInstructions</p>
                            @if (scheme.HasSamples)
                            {
                                <details class="govuk-details govuk-!-margin-bottom-0 noprint">
                                    <summary class="govuk-details__summary">
                                        <span class="govuk-details__summary-text">
                                            Show/hide samples<span class="govuk-visually-hidden"> for @scheme.SchemeHeading</span>
                                        </span>
                                    </summary>
                                    <div class="govuk-details__text">
                                        <ul class="govuk-list">
                                            @foreach (var sample in scheme.Samples)
                                            {
                                                <li>@sample.SampleNumber: @sample.InternalDescription</li>
                                            }
                                        </ul>
                                    </div>
                                </details>
                            }
                        </th>
                        <td class="govuk-table__cell">@scheme.NumberOfSetsRequired</td>
                        @if (!scheme.HasSamples)
                        {
                            <td class="govuk-table__cell" colspan="4">The Sample Numbers for this Scheme have not yet been defined</td>
                        }
                        else
                        {
                            <td class="govuk-table__cell">
                                @if (scheme.DiaryEntry.HasValue)
                                {
                                    @scheme.DiaryEntry.Value.ToShortDateString()
                                }
                                else
                                {
                                    var diaryEntryId = Html.IdFor(m => m.Schemes[i].DiaryEntryChecked);
                                    <div class="govuk-checkboxes govuk-checkboxes--small noprint" data-module="govuk-checkboxes">
                                        <div class="govuk-checkboxes__item">
                                            <input class="govuk-checkboxes__input" type="checkbox" id="@diaryEntryId" asp-for="Schemes[i].DiaryEntryChecked" />
                                            <label class="govuk-label govuk-checkboxes__label" for="@diaryEntryId">
                                                <span class="govuk-visually-hidden">Mark Diary Entry Started for @scheme.SchemeHeading</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </td>
                            <td class="govuk-table__cell">
                                @if (scheme.PrepStartDate.HasValue)
                                {
                                    @scheme.PrepStartDate.Value.ToShortDateString()
                                }
                                else
                                {
                                    var prepStartId = Html.IdFor(m => m.Schemes[i].PrepStartChecked);
                                    <div class="govuk-checkboxes govuk-checkboxes--small noprint" data-module="govuk-checkboxes">
                                        <div class="govuk-checkboxes__item">
                                            <input class="govuk-checkboxes__input" type="checkbox" id="@prepStartId" asp-for="Schemes[i].PrepStartChecked" />
                                            <label class="govuk-label govuk-checkboxes__label" for="@prepStartId">
                                                <span class="govuk-visually-hidden">Mark Prep Started for @scheme.SchemeHeading</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </td>
                            <td class="govuk-table__cell">
                                @if (scheme.PrepCompleteDate.HasValue)
                                {
                                    @scheme.PrepCompleteDate.Value.ToShortDateString()
                                }
                                else
                                {
                                    var prepCompleteId = Html.IdFor(m => m.Schemes[i].PrepCompleteChecked);
                                    <div class="govuk-checkboxes govuk-checkboxes--small noprint" data-module="govuk-checkboxes">
                                        <div class="govuk-checkboxes__item">
                                            <input class="govuk-checkboxes__input" type="checkbox" id="@prepCompleteId" asp-for="Schemes[i].PrepCompleteChecked" />
                                            <label class="govuk-label govuk-checkboxes__label" for="@prepCompleteId">
                                                <span class="govuk-visually-hidden">Mark Prep Completed for @scheme.SchemeHeading</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </td>
                            <td class="govuk-table__cell noprint">
                                <a class="govuk-link" asp-action="PrintableResults" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" asp-route-schemeId="@scheme.MonthlyDistributionSchemeId">View<span class="govuk-visually-hidden"> Results for @scheme.SchemeHeading</span></a>
                            </td>
                        }
                    </tr>
                    @if (scheme.HasSamples)
                    {
                        @foreach (var sample in scheme.Samples)
                        {
                            <tr class="ptl-preparation-print-row" data-scheme-index="@i">
                                <td class="ptl-preparation-print-sample" colspan="5">@sample.SampleNumber: @sample.InternalDescription</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    }

    <div class="govuk-button-group noprint">
        <button type="submit" name="command" value="save" class="govuk-button" data-module="govuk-button">Save</button>
        <button type="submit" name="command" value="cancel" class="govuk-button govuk-button--secondary" data-module="govuk-button" formnovalidate>Cancel</button>
        <button type="button" id="preparation-print-button" class="govuk-button govuk-button--secondary noprint" data-module="govuk-button">Print</button>
    </div>
</form>

@* Legacy AddSelectAllCell/SelectAll(): the header's "select all" checkbox is a one-way toggle -
   ticking or unticking it sets every row's Print checkbox to match, with no indeterminate state
   and no reverse sync back onto the header checkbox. *@
<script>
    document.getElementById('preparation-print-select-all')?.addEventListener('change', function (e) {
        var table = document.getElementById('preparation-table');
        if (!table) {
            return;
        }

        table.querySelectorAll('.ptl-preparation-print-checkbox').forEach(function (checkbox) {
            checkbox.checked = e.target.checked;
        });
    });
</script>

@* Legacy Checkbox_Print quirk, preserved as-is: printing only includes the Scheme rows the user
   has ticked "Print" for, and printing with nothing ticked produces nothing at all. The print-only
   sample detail rows (added for the printed worksheet, not shown on screen) follow their own
   scheme's checkbox via data-scheme-index, independent of the on-screen expand/collapse state. *@
<script>
    document.getElementById('preparation-print-button')?.addEventListener('click', function () {
        var table = document.getElementById('preparation-table');
        if (!table) {
            window.print();
            return;
        }

        var mainRows = table.querySelectorAll('.ptl-preparation-row');
        var anyChecked = Array.prototype.some.call(mainRows, function (row) {
            var checkbox = row.querySelector('.ptl-preparation-print-checkbox');
            return checkbox && checkbox.checked;
        });

        var checkedBySchemeIndex = {};
        mainRows.forEach(function (row) {
            var checkbox = row.querySelector('.ptl-preparation-print-checkbox');
            var included = checkbox && checkbox.checked;
            row.classList.toggle('noprint', !included);
            checkedBySchemeIndex[row.dataset.schemeIndex] = included;
        });

        table.querySelectorAll('.ptl-preparation-print-row').forEach(function (row) {
            row.classList.toggle('noprint', !checkedBySchemeIndex[row.dataset.schemeIndex]);
        });

        table.classList.toggle('noprint', !anyChecked);
        window.print();
    });
</script>
