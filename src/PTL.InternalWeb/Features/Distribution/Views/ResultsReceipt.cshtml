@using System.Globalization
@model PTL.InternalWeb.Features.Distribution.ResultsReceiptViewModel
@{
    ViewData["Title"] = $"Results Receipt - {Model.MonthDescription}";
    var shortDate = "dd/MM/yyyy";
    var culture = CultureInfo.InvariantCulture;
}

<h1 class="govuk-heading-l">Results Receipt - @Model.MonthDescription</h1>

<p class="govuk-body">Each Scheme can be expanded to show the list of Participants. For each Participant clicking 'View' will show the results entered. The tick box is for registering the receipt of any extra documentation received.</p>

<form method="post" asp-action="ResultsReceipt" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" id="results-receipt-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="YearId" />
    <input type="hidden" asp-for="MonthId" />
    <input type="hidden" asp-for="MonthDescription" />

    @if (Model.Schemes.Count == 0)
    {
        <p class="govuk-body">There are no Schemes for this Distribution</p>
    }

    <div class="govuk-accordion" data-module="govuk-accordion" id="results-receipt-accordion">
        @for (var i = 0; i < Model.Schemes.Count; i++)
        {
            var scheme = Model.Schemes[i];
            var submitted = scheme.Participants.Count(p => p.FirstEditDate is not null);

            <div class="govuk-accordion__section">
                <div class="govuk-accordion__section-header">
                    <h2 class="govuk-accordion__section-heading">
                        <span class="govuk-accordion__section-button" id="results-receipt-accordion-heading-@i">@scheme.Description</span>
                    </h2>
                    @if (scheme.Participants.Count > 0)
                    {
                        <div class="govuk-accordion__section-summary govuk-body" id="results-receipt-accordion-summary-@i">
                            <progress class="ptl-progress-bar" max="100" value="@scheme.ProgressPercentage" aria-label="Results received for @scheme.Description">@scheme.ProgressPercentage%</progress>
                            @submitted of @scheme.Participants.Count Participants have submitted results (@scheme.ProgressPercentage%)
                        </div>
                    }
                </div>
                <div id="results-receipt-accordion-content-@i" class="govuk-accordion__section-content">
                    <input type="hidden" asp-for="Schemes[i].MonthlyDistributionSchemeId" />
                    @if (scheme.Participants.Count > 0)
                    {
                        <table class="govuk-table">
                            <caption class="govuk-table__caption govuk-visually-hidden">Participants for @scheme.Description</caption>
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">
                                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Participant</span></th>
                                    <th scope="col" class="govuk-table__header">Deadline Date</th>
                                    <th scope="col" class="govuk-table__header">First Edit</th>
                                    <th scope="col" class="govuk-table__header">Last Edit</th>
                                    <th scope="col" class="govuk-table__header">Extra Documents</th>
                                    <th scope="col" class="govuk-table__header">Results</th>
                                    <th scope="col" class="govuk-table__header">Submission Status</th>
                                    <th scope="col" class="govuk-table__header">Returned to Participant</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                @for (var j = 0; j < scheme.Participants.Count; j++)
                {
                    var participant = scheme.Participants[j];
                    var extraId = Html.IdFor(m => m.Schemes[i].Participants[j].ExtraDocumentsReturned);
                    var returnedId = Html.IdFor(m => m.Schemes[i].Participants[j].ReturnedChecked);

                    <tr class="govuk-table__row ptl-results-receipt-participant-row" id="scheme-@i-participant-@j">
                        <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">
                            <input type="hidden" asp-for="Schemes[i].Participants[j].DistributionParticipantId" />
                            @participant.FullName
                        </th>
                        <td class="govuk-table__cell">@participant.DeadlineDate.ToString(shortDate, culture)</td>
                        @if (participant.FirstEditDate is null)
                        {
                            <td class="govuk-table__cell" colspan="2">No Results</td>
                        }
                        else
                        {
                            <td class="govuk-table__cell">@participant.FirstEditDate.Value.ToString(shortDate, culture)</td>
                            <td class="govuk-table__cell">@(participant.LastEditDate?.ToString(shortDate, culture))</td>
                        }
                        <td class="govuk-table__cell">
                            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                <div class="govuk-checkboxes__item">
                                    <input class="govuk-checkboxes__input" type="checkbox" id="@extraId" asp-for="Schemes[i].Participants[j].ExtraDocumentsReturned" />
                                    <label class="govuk-label govuk-checkboxes__label" for="@extraId">
                                        <span class="govuk-visually-hidden">Extra Documents received for @participant.FullName</span>
                                    </label>
                                </div>
                            </div>
                        </td>
                        <td class="govuk-table__cell">
                            @if (participant.CanViewResults)
                            {
                                <a class="govuk-link" asp-action="ActualResults" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" asp-route-schemeId="@scheme.MonthlyDistributionSchemeId" asp-route-participantId="@participant.DistributionParticipantId">View/Edit<span class="govuk-visually-hidden"> Results for @participant.FullName</span></a>
                            }
                            else
                            {
                                <span class="ptl-link-disabled">View/Edit<span class="govuk-visually-hidden"> Results for @participant.FullName</span></span>
                                <div class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-0">The Results can not be viewed until the Samples for this Participant have been posted</div>
                            }
                        </td>
                        <td class="govuk-table__cell">
                            @if (scheme.RequiresAssessment)
                            {
                                var samplesSuffix = participant.HasUnaccountedSamples ? " (Y)" : " (N)";
                                if (participant.CanViewResults)
                                {
                                    <a class="govuk-link" asp-action="SampleReceipt" asp-route-year="@Model.YearId" asp-route-monthId="@Model.MonthId" asp-route-schemeId="@scheme.MonthlyDistributionSchemeId" asp-route-participantId="@participant.DistributionParticipantId">View/Edit<span class="govuk-visually-hidden"> Submission Status for @participant.FullName</span></a>@samplesSuffix
                                }
                                else
                                {
                                    <span class="ptl-link-disabled">View/Edit<span class="govuk-visually-hidden"> Submission Status for @participant.FullName</span></span>@samplesSuffix
                                    <div class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-0">The Samples can not be submitted until the Samples for this Participant have been posted</div>
                                }
                            }
                        </td>
                        <td class="govuk-table__cell">
                            @if (scheme.RequiresAssessment)
                            {
                                if (participant.ReturnedDate.HasValue)
                                {
                                    @participant.ReturnedDate.Value.ToString(shortDate, culture)
                                }
                                else
                                {
                                    <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                        <div class="govuk-checkboxes__item">
                                            <input class="govuk-checkboxes__input" type="checkbox" id="@returnedId" asp-for="Schemes[i].Participants[j].ReturnedChecked" />
                                            <label class="govuk-label govuk-checkboxes__label" for="@returnedId">
                                                <span class="govuk-visually-hidden">Returned to @participant.FullName</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            }
                        </td>
                    </tr>
                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    </div>

    <div class="govuk-button-group noprint">
        <button type="submit" name="command" value="save" class="govuk-button" data-module="govuk-button">Save</button>
        <button type="submit" name="command" value="cancel" class="govuk-button govuk-button--secondary" data-module="govuk-button" formnovalidate>Cancel</button>
    </div>
</form>
