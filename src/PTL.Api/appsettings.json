{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Attachments": {
    "AllowedFileTypes": [ ".pdf", ".jpeg", ".jpg", ".xls", ".xlsx", ".pptx" ],
    "MaxFileSize": 10485760
  },
  "S3": {
    "Bucket": "devldnptl-dbmigration",
    "Templates": {
      "Prefix": "templates",
      "MaxUploadBytes": 4194304
    },
    "Invoices": {
      "Prefix": "invoices"
    }
  },
  "Internal": {
    "AppUrl": "http://localhost:5214"
  },
  "Notification": {
    "ApiKey": "",
    "BaseUrl": "https://api.notifications.service.gov.uk",
    "InvoiceNotification": {
      "Recipients": ""
    }
  },
  "External": {
    "AppUrl": "http://localhost:5215"
  },
  "TabulationEmails": {
    "Enabled": true,
    "PollInterval": "00:05:00",
    "StartupDelay": "00:00:30",
    "TimeZone": "Europe/London"
  },
  "PublicationNotifications": {
    "Enabled": false
  }
}
