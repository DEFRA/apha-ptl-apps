<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is informational only - Swagger falls back to the member
         name for undocumented actions/DTOs, so this is not treated as a build warning. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>3b9f1198-6849-4b97-aada-c2e3668438a4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Transitive via Microsoft.Data.SqlClient; 9.0.4 is vulnerable (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx), fixed in 9.0.21. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.6" />
    <!-- AWSSDK.SSOOIDC 4.0.100.16 requires AWSSDK.Core >= 4.0.102.8; this also carries the GHSA-9cvc-h2w8-phrp fix. -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.13" />
    <!-- Required for the AWS SDK's SSO token-provider credential flow used by local IAM Identity Center profiles. -->
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.21" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.22" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PTL.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PTL.Core\PTL.Core.csproj" />
    <ProjectReference Include="..\PTL.Data\PTL.Data.csproj" />
    <ProjectReference Include="..\PTL.Contracts\PTL.Contracts.csproj" />
    <ProjectReference Include="..\PTL.Common\PTL.Common.csproj" />
  </ItemGroup>

</Project>
