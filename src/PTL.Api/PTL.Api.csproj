<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is informational only - Swagger falls back to the member
         name for undocumented actions/DTOs, so this is not treated as a build warning. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PTL.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PTL.Core\PTL.Core.csproj" />
    <ProjectReference Include="..\PTL.Data\PTL.Data.csproj" />
    <ProjectReference Include="..\PTL.Contracts\PTL.Contracts.csproj" />
    <ProjectReference Include="..\PTL.Common\PTL.Common.csproj" />
  </ItemGroup>

</Project>
