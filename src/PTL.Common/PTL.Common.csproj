<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is informational only, matching PTL.Api's convention. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives access to HttpContext/IHttpContextAccessor without pulling in the Sdk.Web tooling,
         which is reserved for the deployable services (PTL.Api, PTL.InternalWeb, PTL.ExternalWeb). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serilog.Context (LogContext) lives in the base package; no need for Serilog.AspNetCore here. -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <!-- Needed for the shared OpenID Connect event helpers under Auth/ (TokenValidatedContext,
         RemoteFailureContext) - used by both PTL.Auth.Cidm and PTL.Auth.Entra. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
  </ItemGroup>

</Project>
