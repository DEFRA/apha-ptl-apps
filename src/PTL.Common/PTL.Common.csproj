<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives access to HttpContext/IHttpContextAccessor without pulling in the Sdk.Web tooling,
         which is reserved for the deployable services (PTL.Api, PTL.InternalWeb, PTL.ExternalWeb). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serilog.Context (LogContext) lives in the base package; no need for Serilog.AspNetCore here. -->
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

</Project>
