<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- PTL.ApiClient.Tests owns the HTTP clients and DTO wrappers. Support libraries (PTL.Common,
         PTL.Contracts) are measured by their own projects. PtlWebApplicationExtensions is
         initialization-only infrastructure owned by the web projects (InternalWeb/ExternalWeb), so
         exclude it to keep coverage focused on the client library's actual responsibilities. -->
    <Exclude>[PTL.Common]*,[PTL.Contracts]*,[PTL.ApiClient]PTL.ApiClient.PtlWebApplicationExtensions</Exclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PTL.ApiClient\PTL.ApiClient.csproj" />
  </ItemGroup>

</Project>
