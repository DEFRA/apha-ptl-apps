<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- PTL.ApiClient.Tests owns the HTTP clients and DTO wrappers. PTL.Common and most of
         PTL.Contracts are measured by their own projects - except CustomerSaveResult and
         ParticipantSaveResult, which are exclusively constructed by this library's own
         CustomerApiClient/ParticipantApiClient success/failure-path tests, so they must stay
         included here or Sonar sees them as 0% covered everywhere. PtlWebApplicationExtensions is
         now covered directly by PtlWebApplicationExtensionsTests in this project. -->
    <Include>[PTL.ApiClient]*,[PTL.Contracts]PTL.Contracts.Customer.CustomerSaveResult*,[PTL.Contracts]PTL.Contracts.Participant.ParticipantSaveResult*</Include>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PTL.ApiClient\PTL.ApiClient.csproj" />
  </ItemGroup>

</Project>
