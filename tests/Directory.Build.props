<Project>
  <!-- chain up to the solution-root Directory.Build.props so analyzer settings still apply -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <Threshold>90</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <!-- Program.cs top-level statements end in app.Run()/RunAsync(), which WebApplicationFactory-based
         tests deliberately never execute (it builds its own in-memory TestServer instead of starting
         the real host) - that line is structurally untestable, not a real coverage gap. -->
    <!-- Logging.g.cs (Microsoft.Extensions.Logging's [LoggerMessage] source generator) emits an
         IsEnabled(level) fast-path guard around each log call's formatting code - always false for
         NullLogger (used throughout these tests), so that branch is structurally unreachable under
         test, not a real coverage gap. ExcludeByAttribute doesn't catch it (coverlet's line-level
         exclusion only honours type/method attributes, not the generator's own), so exclude by its
         well-known generated file name instead. -->
    <ExcludeByFile>$(ExcludeByFile);**/Program.cs,**/Logging.g.cs</ExcludeByFile>
  </PropertyGroup>
</Project>
